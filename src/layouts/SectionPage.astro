---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import BrandBanner from '~/components/widgets/BrandBanner.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';
import { headerData } from '~/navigation';

// Shared shell for card-grid landing pages and their detail pages
// (portfolio, products, local services). CTA defaults to the portfolio one.
export interface Props {
  metadata: { title: string; description: string };
  ctaTitle?: string;
  ctaSubtitle?: string;
  ctaActions?: { variant: 'primary' | 'secondary' | 'tertiary' | 'link'; text: string; href: string }[];
}

const {
  metadata,
  ctaTitle = 'Have a project in mind?',
  ctaSubtitle = "Tell me what you need—mixing, sound design, workflow cleanup, or training—and I'll reply within one business day.",
  ctaActions = [{ variant: 'primary', text: 'Start a project', href: getPermalink('/contact#form') }],
} = Astro.props;
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header
      links={headerData.links}
      actions={[{ text: 'Hire me', href: getPermalink('/contact#form') }]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <BrandBanner />

  <slot />

  <CallToAction title={ctaTitle} subtitle={ctaSubtitle} actions={ctaActions} />
</Layout>
