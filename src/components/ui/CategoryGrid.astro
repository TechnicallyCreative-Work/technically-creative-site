---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { ImageMetadata } from 'astro';
import tilePlate from '~/assets/images/tiles/tile-plate.webp';

// Reusable "pad grid" for landing pages (portfolio, products, local services).
//
// Think MIDI controller: every card is a square pad with a neon mark on the Technically Creative head artwork.
// Light theme: soft-UI pads in the page colour, raised by a light and a dark shadow. Dark theme: black rubber pads.
// Pads idle dim and light up like a hit on hover, keyboard focus or press. The mark is a logo image (`logo`,
// an additive neon PNG on black) or, as a fallback, a tabler `icon` glowing in the item's `accent` colour.
// `image` is a photo fallback for items with neither.
//
// The title and description are real text in the page. On hover-capable screens they slide over the pad when it
// lights up; on touch screens and phones they sit under the pad, so nothing depends on hover.
export type Accent = 'cyan' | 'green' | 'pink' | 'purple';

export interface CategoryGridItem {
  title: string;
  description: string;
  href: string;
  logo?: ImageMetadata;
  icon?: string;
  accent?: Accent;
  image?: ImageMetadata;
  meta?: string;
}

export interface Props {
  items: CategoryGridItem[];
}

const { items } = Astro.props;
---

<ul class="cg not-prose grid list-none grid-cols-2 gap-x-3 gap-y-5 p-0 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
  {
    items.map(({ title, description, href, logo, icon, accent = 'cyan', image, meta }) => {
      const tiled = Boolean(logo || icon);
      return (
        <li class={`cg__card cg__pad--${accent} group relative flex flex-col`}>
          <div class="cg__well">
          <div class="cg__art relative aspect-square w-full overflow-hidden rounded-2xl">
            {tiled ? (
              <>
                <Image
                  src={tilePlate}
                  alt=""
                  widths={[360, 520, 760]}
                  sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 280px"
                  class="cg__plate absolute inset-0 h-full w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
                {logo ? (
                  <Image
                    src={logo}
                    alt=""
                    widths={[240, 400]}
                    sizes="(max-width: 640px) 40vw, 220px"
                    class="cg__mark cg__mark--logo"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <Icon name={icon!} class="cg__mark cg__mark--icon" />
                )}
              </>
            ) : (
              image && (
                <Image
                  src={image}
                  alt=""
                  widths={[400, 640, 900]}
                  sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 280px"
                  class="h-full w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              )
            )}
            <span class="cg__led" aria-hidden="true" />
          </div>
          </div>
          <div class="cg__caption flex flex-1 flex-col pt-3">
            {meta && <span class="cg__meta mb-1 text-xs text-muted">{meta}</span>}
            <h3 class="cg__title tc-led">
              <a href={href} class="after:absolute after:inset-0">
                {title}
              </a>
            </h3>
            <p class="cg__desc mt-1.5 line-clamp-3 text-sm text-muted">{description}</p>
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  /* Pad colour, as an rgb triple so it can take an alpha. */
  .cg__pad--cyan {
    --pad: 31 184 214;
  }
  .cg__pad--green {
    --pad: 79 201 58;
  }
  .cg__pad--pink {
    --pad: 240 54 143;
  }
  .cg__pad--purple {
    --pad: 144 71 200;
  }

  /* The well: a soft recessed tray the pad sits in, so the grid reads as part of the page surface. */
  .cg__well {
    padding: 0.4rem;
    border-radius: 1.4rem;
    background: rgb(163 177 198 / 0.1);
    box-shadow: inset 5px 5px 11px rgb(163 177 198 / 0.75), inset -5px -5px 11px rgb(255 255 255 / 0.95);
  }
  :global(.dark) .cg__well {
    background: rgb(255 255 255 / 0.035);
    box-shadow: inset 5px 5px 12px rgb(0 0 0 / 0.7), inset -4px -4px 10px rgb(255 255 255 / 0.06);
  }
  @media (min-width: 640px) {
    .cg__well {
      padding: 0.55rem;
    }
  }

  /* Idle (light): a soft raised pad in the page colour. Light shadow top-left, darker shadow bottom-right. */
  .cg__art {
    background: linear-gradient(145deg, #eff2f8, #dce2ec);
    border: 1px solid rgb(var(--pad) / 0.28);
    box-shadow:
      6px 8px 14px rgb(163 177 198 / 0.8),
      -5px -5px 12px rgb(255 255 255 / 0.95),
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      inset 0 -8px 14px rgb(163 177 198 / 0.22);
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.12s ease;
  }
  /* Idle (dark): a raised rubber pad. Dark dome shading, soft drop shadow, faint top highlight. */
  :global(.dark) .cg__art {
    background: #020617;
    border-color: rgb(var(--pad) / 0.2);
    box-shadow:
      0 10px 16px -6px rgb(0 0 0 / 0.6),
      0 3px 5px rgb(0 0 0 / 0.35),
      inset 0 1px 0 rgb(255 255 255 / 0.14),
      inset 0 -10px 18px rgb(0 0 0 / 0.35);
  }
  /* Glossy sheen across the top-left of the pad. */
  .cg__art::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(155deg, rgb(255 255 255 / 0.55), transparent 40%);
  }
  :global(.dark) .cg__art::after {
    background: linear-gradient(155deg, rgb(255 255 255 / 0.08), transparent 38%);
  }

  /* Head artwork. The PNG/WebP art is light-on-dark, so on the light pad it is inverted and multiplied in. */
  .cg__plate {
    opacity: 0.16;
    filter: invert(1);
    mix-blend-mode: multiply;
    transition: opacity 0.2s ease;
  }
  :global(.dark) .cg__plate {
    opacity: 0.32;
    filter: none;
    mix-blend-mode: normal;
  }
  .cg__card:hover .cg__plate,
  .cg__card:focus-within .cg__plate,
  .cg__card:active .cg__plate {
    opacity: 0.26;
  }
  :global(.dark) .cg__card:hover .cg__plate,
  :global(.dark) .cg__card:focus-within .cg__plate,
  :global(.dark) .cg__card:active .cg__plate {
    opacity: 0.5;
  }

  .cg__mark {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    max-height: 58%;
    max-width: 64%;
    width: auto;
    height: auto;
    opacity: 0.85;
    transition: transform 0.25s ease, opacity 0.2s ease, filter 0.2s ease;
  }
  .cg__mark--logo {
    /* Light: the neon-on-black PNG is inverted (black becomes white, hues are kept) and multiplied so the white vanishes. */
    filter: contrast(1.4) invert(1) hue-rotate(180deg) saturate(2);
    mix-blend-mode: multiply;
  }
  :global(.dark) .cg__mark--logo {
    /* Dark: the black of the PNG disappears against the plate. */
    filter: brightness(0.85);
    mix-blend-mode: screen;
    opacity: 0.68;
  }
  .cg__mark--icon {
    width: 36%;
    height: auto;
    aspect-ratio: 1;
    stroke-width: 1.2;
    color: rgb(var(--pad));
    filter: drop-shadow(0 0 5px rgb(var(--pad) / 0.7));
  }

  /* The little pad LED, top right. */
  .cg__led {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    background: rgb(var(--pad) / 0.4);
    transition: background 0.18s ease, box-shadow 0.18s ease;
  }

  /* Lit: hover or keyboard focus. Still raised, now glowing in the pad colour. */
  .cg__card:hover .cg__art,
  .cg__card:focus-within .cg__art {
    border-color: rgb(var(--pad) / 0.85);
    box-shadow:
      6px 8px 14px rgb(163 177 198 / 0.8),
      -5px -5px 12px rgb(255 255 255 / 0.95),
      0 0 24px -2px rgb(var(--pad) / 0.5),
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      inset 0 0 34px rgb(var(--pad) / 0.14);
  }
  :global(.dark) .cg__card:hover .cg__art,
  :global(.dark) .cg__card:focus-within .cg__art {
    border-color: rgb(var(--pad) / 0.9);
    box-shadow:
      0 10px 16px -6px rgb(0 0 0 / 0.6),
      0 0 24px -2px rgb(var(--pad) / 0.55),
      inset 0 1px 0 rgb(255 255 255 / 0.18),
      inset 0 0 34px rgb(var(--pad) / 0.2);
  }
  /* Pressed: the pad sinks into the well. */
  .cg__card:active .cg__art {
    border-color: rgb(var(--pad) / 0.85);
    box-shadow:
      inset 6px 7px 14px rgb(163 177 198 / 0.95),
      inset -4px -4px 10px rgb(255 255 255 / 0.9),
      inset 0 0 26px rgb(var(--pad) / 0.2),
      0 0 16px -4px rgb(var(--pad) / 0.5);
    transform: translateY(2px) scale(0.985);
  }
  :global(.dark) .cg__card:active .cg__art {
    border-color: rgb(var(--pad) / 0.9);
    box-shadow:
      inset 0 7px 16px rgb(0 0 0 / 0.75),
      inset 0 0 30px rgb(var(--pad) / 0.3),
      0 0 18px -4px rgb(var(--pad) / 0.6),
      0 1px 0 rgb(255 255 255 / 0.12);
  }
  .cg__card:hover .cg__mark,
  .cg__card:focus-within .cg__mark,
  .cg__card:active .cg__mark {
    opacity: 1;
    filter: contrast(1.4) invert(1) hue-rotate(180deg) saturate(2.4);
  }
  :global(.dark) .cg__card:hover .cg__mark,
  :global(.dark) .cg__card:focus-within .cg__mark,
  :global(.dark) .cg__card:active .cg__mark {
    filter: brightness(1.12);
  }
  .cg__card:hover .cg__mark--icon,
  .cg__card:focus-within .cg__mark--icon,
  .cg__card:active .cg__mark--icon {
    filter: drop-shadow(0 0 5px rgb(var(--pad) / 0.7));
  }
  .cg__card:hover .cg__led,
  .cg__card:focus-within .cg__led,
  .cg__card:active .cg__led {
    background: rgb(var(--pad));
    box-shadow: 0 0 8px 1px rgb(var(--pad) / 0.9);
  }
  .cg__card:has(a:focus-visible) .cg__art {
    outline: 2px solid rgb(var(--pad));
    outline-offset: 3px;
  }

  /* Heading is an LED readout, not a link: the whole pad is the link, so the text takes no link styling. */
  .cg__title {
    --led: color-mix(in srgb, rgb(var(--pad)) 78%, white);
    align-self: flex-start;
    font-size: 0.8rem;
  }
  @media (min-width: 640px) {
    .cg__title {
      font-size: 0.9rem;
    }
  }
  .cg__caption h3 > a[href],
  .cg__caption h3 > a[href]:hover,
  .cg__caption h3 > a[href]:focus-visible {
    color: inherit;
    text-decoration: none;
  }

  /* Hover-capable screens: the caption becomes an overlay that appears when the pad lights up. */
  @media (hover: hover) and (pointer: fine) and (min-width: 640px) {
    .cg__caption {
      position: absolute;
      inset: 0.55rem;
      justify-content: flex-end;
      padding: 1rem;
      border-radius: 1rem;
      color: #1e293b;
      background: linear-gradient(to top, rgb(230 234 241 / 0.97) 40%, rgb(230 234 241 / 0.82) 75%, rgb(230 234 241 / 0.5));
      opacity: 0;
      transform: translateY(0.4rem);
      transition: opacity 0.2s ease, transform 0.2s ease;
      pointer-events: none;
    }
    :global(.dark) .cg__caption {
      color: #fff;
      background: linear-gradient(to top, rgba(2, 8, 23, 0.95) 35%, rgba(2, 8, 23, 0.6) 75%, rgba(2, 8, 23, 0.3));
    }
    .cg__card:hover .cg__caption,
    .cg__card:focus-within .cg__caption {
      opacity: 1;
      transform: translateY(0);
    }
    .cg__card:hover .cg__mark,
    .cg__card:focus-within .cg__mark {
      opacity: 0.22;
      transform: translate(-50%, -50%) scale(0.92);
    }
    .cg__desc {
      -webkit-line-clamp: 4;
      line-clamp: 4;
    }
    .cg__meta,
    .cg__desc {
      color: rgb(30 41 59 / 0.88);
    }
    :global(.dark) .cg__meta,
    :global(.dark) .cg__desc {
      color: rgba(226, 232, 240, 0.88);
    }
    .cg__caption h3 > a[href] {
      pointer-events: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cg__art,
    .cg__caption,
    .cg__mark,
    .cg__led {
      transition: none;
    }
    .cg__card:active .cg__art {
      transform: none;
    }
  }
</style>
