---
import { SITE, METADATA } from 'astrowind:config';
import { SOCIAL_URLS } from '~/data/social';

const siteUrl = String(SITE.site).replace(/\/$/, '') + '/';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.name,
  url: siteUrl,
  logo: new URL('/logo.svg', siteUrl).toString(),
  description: METADATA?.description,
  email: 'hello@technicallycreative.work',
  areaServed: {
    '@type': 'City',
    name: 'Indianapolis, IN',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Indianapolis',
    addressRegion: 'IN',
    addressCountry: 'US',
  },
  sameAs: [
    SOCIAL_URLS.linkedin,
    SOCIAL_URLS.instagram,
    SOCIAL_URLS.facebook,
    SOCIAL_URLS.youtube,
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
