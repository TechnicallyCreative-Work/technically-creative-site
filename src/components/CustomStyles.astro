---
import '@fontsource-variable/inter';
import '@fontsource/orbitron/500.css';
import '@fontsource/orbitron/600.css';
import '@fontsource/orbitron/700.css';
import '@fontsource/orbitron/800.css';
import '@fontsource/orbitron/900.css';
---

<style is:global>
  :root {
    /* Brand (light) */
    --tc-primary: rgb(0 200 255);
    --tc-secondary: rgb(155 48 255);
    --tc-accent: rgb(255 51 153);

    --tc-text-heading: rgb(0 0 0);
    --tc-text-default: rgb(16 16 16);
    --tc-text-muted: rgb(16 16 16 / 85%);
    --tc-bg-page: rgb(255 255 255);


    /* Fonts */
    --tc-font-sans: 'Inter Variable';
    --tc-font-serif: 'Inter Variable';
    --tc-font-heading: 'Orbitron';
  }
  /* Dark mode on <html class="dark"> or <body class="dark"> */
  .dark {
    --tc-primary: rgb(0 200 255);
    --tc-secondary: rgb(155 48 255);
    --tc-accent: rgb(255 51 153);

    --tc-text-heading: rgb(247 248 248);
    --tc-text-default: rgb(229 236 246);
    --tc-text-muted: rgb(160 170 190 / 66%);
    --tc-bg-page: rgb(0 0 0);
  }

  /* Ensure the base colors actually apply */
  html,
  body {
    background: var(--tc-bg-page);
    color: var(--tc-text-default);
    font-family:
      var(--tc-font-sans),
      system-ui,
      -apple-system,
      Segoe UI,
      Roboto,
      sans-serif;
  }

  /* Headings, nav, buttons, and labels get the display font, always uppercase */
  h1,
  h2,
  h3,
  h4,
  h5,
  h6,
  label {
    font-family: var(--tc-font-heading), var(--tc-font-sans), sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
</style>

<style is:inline>
  :root {
    /* ===== Brand (light) ===== */
    --tc-primary: rgb(0 200 255);
    --tc-secondary: rgb(155 48 255);
    --tc-accent: rgb(255 51 153);

    --tc-text-heading: rgb(0 0 0);
    --tc-text-default: rgb(16 16 16);
    --tc-text-muted: rgb(16 16 16 / 85%);
    --tc-bg-page: rgb(255 255 255);

    /* Fonts */
    --tc-font-sans: 'Inter Variable';
    --tc-font-serif: 'Inter Variable';
    --tc-font-heading: 'Orbitron';

    /* Selection */
    --tc-selection-bg: lavender;
    --tc-selection-fg: rgb(16 16 16);
  }

  ::selection {
    background-color: var(--tc-selection-bg);
    color: var(--tc-selection-fg);
  }

  .dark {
    /* ===== Brand (dark) ===== */
    --tc-primary: rgb(0 200 255);
    --tc-secondary: rgb(155 48 255);
    --tc-accent: rgb(255 51 153);

    --tc-text-heading: rgb(247 248 248);
    --tc-text-default: rgb(229 236 246);
    --tc-text-muted: rgb(160 170 190 / 66%);
    --tc-bg-page: rgb(0 0 0);

    /* Fonts (same) */
    --tc-font-sans: 'Inter Variable';
    --tc-font-serif: 'Inter Variable';
    --tc-font-heading: 'Orbitron';

    /* Selection (dark) */
    --tc-selection-bg: rgb(10 10 20);
    --tc-selection-fg: snow;
  }
</style>
