---
import '@fontsource-variable/inter';
import '@fontsource/orbitron/500.css';
import '@fontsource/orbitron/600.css';
import '@fontsource/orbitron/700.css';
import '@fontsource/orbitron/800.css';
import '@fontsource/orbitron/900.css';
import '@fontsource/doto/latin-700.css';
import '@fontsource/doto/latin-900.css';
---

<style is:global>
  :root {
    /* Brand (light) */
    --tc-primary: rgb(0 200 255);
    --tc-secondary: rgb(155 48 255);
    --tc-accent: rgb(255 51 153);

    --tc-text-heading: rgb(0 0 0);
    --tc-text-default: rgb(16 16 16);
    --tc-text-muted: rgb(16 16 16 / 85%);
    --tc-bg-page: rgb(230 234 241);


    /* Fonts */
    --tc-font-sans: 'Inter Variable';
    --tc-font-serif: 'Inter Variable';
    --tc-font-heading: 'Orbitron';
  }
  /* Dark mode on <html class="dark"> or <body class="dark"> */
  .dark {
    --tc-primary: rgb(0 200 255);
    --tc-secondary: rgb(155 48 255);
    --tc-accent: rgb(255 51 153);

    --tc-text-heading: rgb(247 248 248);
    --tc-text-default: rgb(229 236 246);
    --tc-text-muted: rgb(160 170 190 / 66%);
    --tc-bg-page: rgb(0 0 0);
  }

  /* Ensure the base colors actually apply */
  html,
  body {
    background: var(--tc-bg-page);
    color: var(--tc-text-default);
    font-family:
      var(--tc-font-sans),
      system-ui,
      -apple-system,
      Segoe UI,
      Roboto,
      sans-serif;
  }

  /* Headings, nav, buttons, and labels get the display font, always uppercase */
  h1,
  h2,
  h3,
  h4,
  h5,
  h6,
  label {
    font-family: var(--tc-font-heading), var(--tc-font-sans), sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* ---------------------------------------------------------------------------------------------
     Pad look, shared by every card on the site.
     .tc-card       raised surface (light and dark), like a pad sitting in a plate
     .tc-card-link  clickable card: lights up on hover, sinks when pressed
     .tc-card--accent  slightly brighter edge for featured cards
     .tc-card-dark  always-dark rubber pad (cards that carry their own dark content)
     .tc-well       recessed slot, used for empty or coming-soon cards
     .tc-led        dot-matrix readout screen for headings, set --led for the colour
     --------------------------------------------------------------------------------------------- */
  .tc-card {
    border: 1px solid rgb(255 255 255 / 0.55);
    background: linear-gradient(145deg, #eef1f7, #dde3ec);
    box-shadow:
      8px 10px 20px rgb(163 177 198 / 0.65),
      -7px -7px 16px rgb(255 255 255 / 0.95),
      inset 0 1px 0 rgb(255 255 255 / 0.9);
    transition: box-shadow 0.18s ease, transform 0.12s ease, border-color 0.18s ease;
  }
  .dark .tc-card {
    border-color: rgb(255 255 255 / 0.07);
    background: linear-gradient(145deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.02));
    box-shadow:
      8px 10px 22px rgb(0 0 0 / 0.75),
      -4px -4px 12px rgb(255 255 255 / 0.035),
      inset 0 1px 0 rgb(255 255 255 / 0.08);
  }
  .tc-card--accent {
    border-color: color-mix(in srgb, var(--tc-primary) 45%, transparent);
  }
  .tc-card-link:hover,
  .tc-card-link:focus-visible {
    border-color: color-mix(in srgb, var(--tc-primary) 80%, transparent);
    box-shadow:
      8px 10px 20px rgb(163 177 198 / 0.65),
      -7px -7px 16px rgb(255 255 255 / 0.95),
      0 0 24px -2px color-mix(in srgb, var(--tc-primary) 55%, transparent),
      inset 0 1px 0 rgb(255 255 255 / 0.9);
  }
  .dark .tc-card-link:hover,
  .dark .tc-card-link:focus-visible {
    box-shadow:
      8px 10px 22px rgb(0 0 0 / 0.75),
      0 0 24px -2px color-mix(in srgb, var(--tc-primary) 55%, transparent),
      inset 0 1px 0 rgb(255 255 255 / 0.08);
  }
  .tc-card-link:active {
    transform: translateY(2px) scale(0.99);
    box-shadow:
      inset 5px 6px 12px rgb(163 177 198 / 0.8),
      inset -4px -4px 10px rgb(255 255 255 / 0.95),
      0 0 18px -4px color-mix(in srgb, var(--tc-primary) 55%, transparent);
  }
  .dark .tc-card-link:active {
    box-shadow:
      inset 5px 7px 16px rgb(0 0 0 / 0.8),
      inset -2px -2px 8px rgb(255 255 255 / 0.04),
      0 0 18px -4px color-mix(in srgb, var(--tc-primary) 55%, transparent);
  }

  .tc-card-dark {
    border: 1px solid rgb(255 255 255 / 0.08);
    background: linear-gradient(155deg, #101a2e, #060b18 70%);
    box-shadow:
      8px 12px 22px rgb(100 116 139 / 0.5),
      0 3px 5px rgb(0 0 0 / 0.35),
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      inset 0 -10px 18px rgb(0 0 0 / 0.3);
  }
  .dark .tc-card-dark {
    box-shadow:
      8px 12px 22px rgb(0 0 0 / 0.75),
      0 3px 5px rgb(0 0 0 / 0.4),
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      inset 0 -10px 18px rgb(0 0 0 / 0.3);
  }

  .tc-well {
    border: 0;
    background: rgb(163 177 198 / 0.1);
    box-shadow: inset 5px 5px 11px rgb(163 177 198 / 0.7), inset -5px -5px 11px rgb(255 255 255 / 0.95);
  }
  .dark .tc-well {
    background: rgb(255 255 255 / 0.035);
    box-shadow: inset 5px 5px 12px rgb(0 0 0 / 0.7), inset -4px -4px 10px rgb(255 255 255 / 0.06);
  }

  /* ---------------------------------------------------------------------------------------------
     Buttons, same pad language as the cards.
     .btn / .btn-secondary / .tc-btn   soft raised pad (light: page colour + light/dark shadow pair)
     .btn-primary / .tc-btn-primary    lit cyan pad, glows, hover shifts to the secondary colour
     .tc-icon-btn                      flat icon button that rises on hover and sinks when pressed
     .btn-tertiary stays flat (text-style button).
     Selectors are a little heavier than the utility classes they replace so they win without !important.
     --------------------------------------------------------------------------------------------- */
  html :is(.btn:not(.btn-tertiary), .tc-btn):not(.btn-primary):not(.tc-btn-primary) {
    color: var(--tc-text-default);
    background: linear-gradient(145deg, #eff2f8, #dce2ec);
    border-color: rgb(255 255 255 / 0.6);
    box-shadow:
      5px 6px 12px rgb(163 177 198 / 0.75),
      -4px -4px 10px rgb(255 255 255 / 0.95),
      inset 0 1px 0 rgb(255 255 255 / 0.9);
    transition: box-shadow 0.18s ease, transform 0.12s ease, border-color 0.18s ease, color 0.18s ease;
  }
  html.dark :is(.btn:not(.btn-tertiary), .tc-btn):not(.btn-primary):not(.tc-btn-primary),
  .dark :is(.btn:not(.btn-tertiary), .tc-btn):not(.btn-primary):not(.tc-btn-primary) {
    color: rgb(229 236 246);
    background: linear-gradient(145deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.02));
    border-color: rgb(255 255 255 / 0.1);
    box-shadow:
      6px 8px 16px rgb(0 0 0 / 0.7),
      -3px -3px 8px rgb(255 255 255 / 0.04),
      inset 0 1px 0 rgb(255 255 255 / 0.08);
  }
  html :is(.btn:not(.btn-tertiary), .tc-btn):not(.btn-primary):not(.tc-btn-primary):is(:hover, :focus-visible) {
    border-color: color-mix(in srgb, var(--tc-primary) 70%, transparent);
    background: linear-gradient(145deg, #eff2f8, #dce2ec);
    box-shadow:
      5px 6px 12px rgb(163 177 198 / 0.75),
      -4px -4px 10px rgb(255 255 255 / 0.95),
      0 0 20px -3px color-mix(in srgb, var(--tc-primary) 60%, transparent),
      inset 0 1px 0 rgb(255 255 255 / 0.9);
  }
  .dark :is(.btn:not(.btn-tertiary), .tc-btn):not(.btn-primary):not(.tc-btn-primary):is(:hover, :focus-visible) {
    background: linear-gradient(145deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.03));
    box-shadow:
      6px 8px 16px rgb(0 0 0 / 0.7),
      0 0 20px -3px color-mix(in srgb, var(--tc-primary) 60%, transparent),
      inset 0 1px 0 rgb(255 255 255 / 0.1);
  }
  html :is(.btn:not(.btn-tertiary), .tc-btn):not(.btn-primary):not(.tc-btn-primary):active {
    transform: translateY(1px) scale(0.99);
    box-shadow:
      inset 4px 5px 10px rgb(163 177 198 / 0.85),
      inset -3px -3px 8px rgb(255 255 255 / 0.9),
      0 0 14px -4px color-mix(in srgb, var(--tc-primary) 55%, transparent);
  }
  .dark :is(.btn:not(.btn-tertiary), .tc-btn):not(.btn-primary):not(.tc-btn-primary):active {
    box-shadow:
      inset 4px 6px 12px rgb(0 0 0 / 0.8),
      inset -2px -2px 6px rgb(255 255 255 / 0.04),
      0 0 14px -4px color-mix(in srgb, var(--tc-primary) 55%, transparent);
  }

  html :is(.btn-primary, .tc-btn-primary) {
    color: #fff;
    background: linear-gradient(145deg, #2bd6ff, #00b0e3);
    border-color: rgb(255 255 255 / 0.5);
    text-shadow: 0 1px 2px rgb(0 70 100 / 0.35);
    box-shadow:
      5px 6px 12px rgb(163 177 198 / 0.8),
      -4px -4px 10px rgb(255 255 255 / 0.95),
      0 0 16px -4px color-mix(in srgb, var(--tc-primary) 70%, transparent),
      inset 0 1px 0 rgb(255 255 255 / 0.5),
      inset 0 -3px 6px rgb(0 100 140 / 0.25);
    transition: box-shadow 0.18s ease, transform 0.12s ease, border-color 0.18s ease, background 0.18s ease;
  }
  .dark :is(.btn-primary, .tc-btn-primary) {
    box-shadow:
      6px 8px 16px rgb(0 0 0 / 0.7),
      0 0 18px -3px color-mix(in srgb, var(--tc-primary) 65%, transparent),
      inset 0 1px 0 rgb(255 255 255 / 0.4),
      inset 0 -3px 6px rgb(0 100 140 / 0.3);
  }
  html :is(.btn-primary, .tc-btn-primary):is(:hover, :focus-visible) {
    color: #fff;
    background: linear-gradient(145deg, #b46aff, #8c27e8);
    border-color: rgb(255 255 255 / 0.5);
    box-shadow:
      5px 6px 12px rgb(163 177 198 / 0.8),
      -4px -4px 10px rgb(255 255 255 / 0.95),
      0 0 22px -2px color-mix(in srgb, var(--tc-secondary) 70%, transparent),
      inset 0 1px 0 rgb(255 255 255 / 0.45),
      inset 0 -3px 6px rgb(60 0 110 / 0.3);
  }
  .dark :is(.btn-primary, .tc-btn-primary):is(:hover, :focus-visible) {
    box-shadow:
      6px 8px 16px rgb(0 0 0 / 0.7),
      0 0 22px -2px color-mix(in srgb, var(--tc-secondary) 70%, transparent),
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      inset 0 -3px 6px rgb(60 0 110 / 0.35);
  }
  html :is(.btn-primary, .tc-btn-primary):active {
    transform: translateY(1px) scale(0.99);
    box-shadow:
      inset 4px 6px 12px rgb(0 60 90 / 0.5),
      inset -2px -2px 6px rgb(255 255 255 / 0.25),
      0 0 14px -4px color-mix(in srgb, var(--tc-primary) 70%, transparent);
  }
  html :is(.btn, .tc-btn, .tc-btn-primary):is(:disabled, [aria-disabled='true']) {
    box-shadow: none;
    transform: none;
    filter: saturate(0.5);
  }

  .tc-icon-btn {
    border: 1px solid transparent;
    transition: box-shadow 0.18s ease, transform 0.12s ease, background 0.18s ease, border-color 0.18s ease;
  }
  html .tc-icon-btn:is(:hover, :focus-visible) {
    background: linear-gradient(145deg, #eff2f8, #dce2ec);
    border-color: rgb(255 255 255 / 0.6);
    box-shadow:
      3px 4px 8px rgb(163 177 198 / 0.75),
      -3px -3px 7px rgb(255 255 255 / 0.95),
      inset 0 1px 0 rgb(255 255 255 / 0.9);
  }
  .dark .tc-icon-btn:is(:hover, :focus-visible) {
    background: linear-gradient(145deg, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0.02));
    border-color: rgb(255 255 255 / 0.08);
    box-shadow:
      3px 5px 10px rgb(0 0 0 / 0.7),
      -2px -2px 6px rgb(255 255 255 / 0.04),
      inset 0 1px 0 rgb(255 255 255 / 0.08);
  }
  html .tc-icon-btn:active {
    transform: translateY(1px) scale(0.97);
    box-shadow:
      inset 3px 4px 8px rgb(163 177 198 / 0.85),
      inset -2px -2px 6px rgb(255 255 255 / 0.9);
  }
  .dark .tc-icon-btn:active {
    box-shadow:
      inset 3px 4px 9px rgb(0 0 0 / 0.8),
      inset -2px -2px 5px rgb(255 255 255 / 0.04);
  }
  /* Round icon buttons that always sit raised (carousel arrows). */
  .tc-icon-btn--raised {
    background: linear-gradient(145deg, #eff2f8, #dce2ec);
    border-color: rgb(255 255 255 / 0.6);
    box-shadow:
      4px 5px 10px rgb(163 177 198 / 0.75),
      -3px -3px 8px rgb(255 255 255 / 0.95),
      inset 0 1px 0 rgb(255 255 255 / 0.9);
  }
  .dark .tc-icon-btn--raised {
    background: linear-gradient(145deg, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0.02));
    border-color: rgb(255 255 255 / 0.08);
    box-shadow:
      4px 6px 12px rgb(0 0 0 / 0.7),
      -2px -2px 6px rgb(255 255 255 / 0.04),
      inset 0 1px 0 rgb(255 255 255 / 0.08);
  }

  /* Form fields: recessed slots, like the wells the pads sit in. */
  html .tc-input {
    background: rgb(163 177 198 / 0.12);
    border-color: transparent;
    box-shadow: inset 3px 4px 8px rgb(163 177 198 / 0.85), inset -3px -3px 7px rgb(255 255 255 / 0.95);
    transition: box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .dark .tc-input {
    background: rgb(255 255 255 / 0.035);
    box-shadow: inset 3px 4px 9px rgb(0 0 0 / 0.75), inset -2px -2px 6px rgb(255 255 255 / 0.05);
  }
  html .tc-input:focus {
    outline: none;
    border-color: color-mix(in srgb, var(--tc-primary) 80%, transparent);
    box-shadow:
      inset 3px 4px 8px rgb(163 177 198 / 0.85),
      inset -3px -3px 7px rgb(255 255 255 / 0.95),
      0 0 16px -3px color-mix(in srgb, var(--tc-primary) 60%, transparent);
  }
  .dark .tc-input:focus {
    box-shadow:
      inset 3px 4px 9px rgb(0 0 0 / 0.75),
      0 0 16px -3px color-mix(in srgb, var(--tc-primary) 60%, transparent);
  }

  /* LED readout: a small dark screen with dot-matrix text, like the display on a controller. */
  .tc-led {
    display: inline-block;
    max-width: 100%;
    padding: 0.4rem 0.65rem;
    border-radius: 0.5rem;
    font-family: 'Doto', ui-monospace, monospace !important;
    font-weight: 900;
    font-size: 1rem;
    line-height: 1.25;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--led, #3ee7ff);
    text-shadow: 0 0 5px color-mix(in srgb, var(--led, #3ee7ff) 75%, transparent);
    background-color: #02060f;
    background-image: repeating-linear-gradient(0deg, rgb(255 255 255 / 0.035) 0 1px, transparent 1px 3px);
    box-shadow:
      inset 0 2px 6px rgb(0 0 0 / 0.85),
      inset 0 0 0 1px rgb(255 255 255 / 0.06),
      0 1px 0 rgb(255 255 255 / 0.9),
      0 -1px 0 rgb(163 177 198 / 0.35);
  }
  .dark .tc-led {
    box-shadow:
      inset 0 2px 6px rgb(0 0 0 / 0.85),
      inset 0 0 0 1px rgb(255 255 255 / 0.08),
      0 1px 0 rgb(255 255 255 / 0.06);
  }
</style>

<style is:inline>
  :root {
    /* ===== Brand (light) ===== */
    --tc-primary: rgb(0 200 255);
    --tc-secondary: rgb(155 48 255);
    --tc-accent: rgb(255 51 153);

    --tc-text-heading: rgb(0 0 0);
    --tc-text-default: rgb(16 16 16);
    --tc-text-muted: rgb(16 16 16 / 85%);
    --tc-bg-page: rgb(230 234 241);

    /* Fonts */
    --tc-font-sans: 'Inter Variable';
    --tc-font-serif: 'Inter Variable';
    --tc-font-heading: 'Orbitron';

    /* Selection */
    --tc-selection-bg: lavender;
    --tc-selection-fg: rgb(16 16 16);
  }

  ::selection {
    background-color: var(--tc-selection-bg);
    color: var(--tc-selection-fg);
  }

  .dark {
    /* ===== Brand (dark) ===== */
    --tc-primary: rgb(0 200 255);
    --tc-secondary: rgb(155 48 255);
    --tc-accent: rgb(255 51 153);

    --tc-text-heading: rgb(247 248 248);
    --tc-text-default: rgb(229 236 246);
    --tc-text-muted: rgb(160 170 190 / 66%);
    --tc-bg-page: rgb(0 0 0);

    /* Fonts (same) */
    --tc-font-sans: 'Inter Variable';
    --tc-font-serif: 'Inter Variable';
    --tc-font-heading: 'Orbitron';

    /* Selection (dark) */
    --tc-selection-bg: rgb(10 10 20);
    --tc-selection-fg: snow;
  }
</style>
