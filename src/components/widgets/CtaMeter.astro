---
// Hero call-to-action row styled like a sideways audio level meter: evenly spaced raised
// blocks, each with a strip of LED segments. Colour runs continuously across the whole
// row (cyan -> purple -> pink) and the segments light up left to right on load.
import { Icon } from 'astro-icon/components';

interface MeterItem {
  text: string;
  href: string;
  hint?: string;
}

interface Props {
  items: MeterItem[];
  segments?: number;
  location?: string;
}

const { items = [], segments = 8, location = 'hero' } = Astro.props;
const total = items.length * segments;
---

<div class="cta-meter" role="group" aria-label="Where to start">
  {
    items.map((item, i) => (
      <a
        href={item.href}
        class="cta-block tc-card tc-card-link"
        data-track="cta_click"
        data-track-label={item.text}
        data-track-location={location}
      >
        <span class="cta-label font-heading text-slate-900 dark:text-white">
          {item.text}
          <Icon name="tabler:arrow-right" class="cta-arrow" />
        </span>
        {item.hint && <span class="cta-hint text-muted dark:text-slate-400">{item.hint}</span>}
        <span class="cta-leds" aria-hidden="true">
          {Array.from({ length: segments }).map((_, s) => {
            const n = i * segments + s;
            return <span class="led" style={`--n:${n};--t:${total > 1 ? n / (total - 1) : 0}`} />;
          })}
        </span>
      </a>
    ))
  }
</div>

<style>
  .cta-meter {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    width: 100%;
    margin-top: 0.5rem;
  }
  @media (min-width: 768px) {
    .cta-meter {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .cta-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem 1.25rem;
    border-radius: 1rem;
    text-decoration: none;
    min-height: 7.5rem;
  }

  .cta-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .cta-arrow {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    transition: transform 0.18s ease;
  }
  .cta-block:hover .cta-arrow,
  .cta-block:focus-visible .cta-arrow {
    transform: translateX(4px);
  }

  .cta-hint {
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .cta-leds {
    display: flex;
    gap: 5px;
    margin-top: auto;
    padding-top: 0.9rem;
  }

  .led {
    --lit: hsl(calc(190 + var(--t) * 140) 100% 55%);
    flex: 1;
    height: 10px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--lit) 16%, transparent);
    box-shadow: inset 0 1px 1px rgb(0 0 0 / 0.35);
    animation: led-on 0.4s ease-out both;
    animation-delay: calc(0.35s + var(--n) * 55ms);
  }
  .cta-block:hover .led,
  .cta-block:focus-visible .led {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.4),
      0 0 10px -1px var(--lit);
  }

  @keyframes led-on {
    to {
      background: var(--lit);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.4),
        0 0 8px -1px var(--lit);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .led {
      animation: none;
      background: var(--lit);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.4),
        0 0 8px -1px var(--lit);
    }
  }
</style>
