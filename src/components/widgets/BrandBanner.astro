---
import brandBannerImage from '~/assets/images/tc-logo-banner.jpg';
import brandBannerVideo from '~/assets/videos/hero-background.mp4';

// Allow swapping the hero video via PUBLIC_BRAND_BANNER_VIDEO_URL; fall back to bundled asset.
const brandBannerVideoSource = import.meta.env.PUBLIC_BRAND_BANNER_VIDEO_URL || brandBannerVideo;
const brandBannerVideoSourceVertical =
  import.meta.env.PUBLIC_BRAND_BANNER_VIDEO_URL_VERTICAL || brandBannerVideoSource;
const videoId = 'brand-banner-video';
const bannerId = 'brand-banner';
---

<div
  id={bannerId}
  class="relative w-full overflow-hidden bg-black cursor-pointer aspect-[6/1]"
  role="button"
  tabindex="0"
  aria-label="Toggle banner sound"
  aria-pressed="false"
>
  <video
    id={videoId}
    class="absolute inset-0 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    poster={brandBannerImage.src}
  >
    <source media="(orientation: portrait)" src={brandBannerVideoSourceVertical} type="video/mp4" />
    <source src={brandBannerVideoSource} type="video/mp4" />
    <img
      src={brandBannerImage.src}
      width={brandBannerImage.width ?? 3840}
      height={brandBannerImage.height ?? 1080}
      alt="Technically Creative circuit heads branding artwork"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
  </video>
</div>

<script is:inline>
  // Browsers only allow sound after a user gesture, so clicking/tapping the banner toggles mute.
  const initBannerSound = () => {
    const banner = document.getElementById('brand-banner');
    const video = document.getElementById('brand-banner-video');

    if (!banner || !video) return;

    const toggleSound = async () => {
      const nextMuted = !video.muted;
      video.muted = nextMuted;
      if (nextMuted) {
        video.setAttribute('muted', '');
      } else {
        video.removeAttribute('muted');
        video.volume = 1;
        try {
          await video.play();
        } catch (err) {
          console.error('Unable to play video after unmuting', err);
        }
      }
      banner.setAttribute('aria-pressed', (!video.muted).toString());
    };

    banner.addEventListener('click', toggleSound);
    banner.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        toggleSound();
      }
    });
  };

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initBannerSound();
  } else {
    document.addEventListener('DOMContentLoaded', initBannerSound, { once: true });
  }
</script>
