---
import FormContainer from '~/components/ui/Form.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Contact as Props, HubspotBridgeConfig } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  inputs,
  textarea,
  disclaimer,
  button,
  description,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
  hubspot,
  successMessage = 'Thanks for reaching out! We will be in touch soon.',
  errorMessage = 'Something went wrong while submitting the form. Please try again.',
} = Astro.props as Props & { hubspot?: HubspotBridgeConfig };

const inferredFieldMapping: Record<string, string> = {};

if (Array.isArray(inputs)) {
  for (const field of inputs) {
    if (field?.name) {
      inferredFieldMapping[field.name] = field.name;
    }
  }
}

if (textarea?.name) {
  inferredFieldMapping[textarea.name] = textarea.name;
} else if (textarea) {
  inferredFieldMapping.message = 'message';
}

if (disclaimer?.name) {
  inferredFieldMapping[disclaimer.name] = disclaimer.name;
}

const portalId = hubspot?.portalId?.trim() ?? '';
const formGuid = hubspot?.formId?.trim() ?? '';
const region = hubspot?.region ?? 'na1';
const loadingText = hubspot?.loadingText ?? 'Sending…';

const fieldMapping = {
  ...inferredFieldMapping,
  ...(hubspot?.fieldMapping ?? {}),
};

const formElementId = `${id ?? 'contact'}-form`;
const hasHubspotBridge = Boolean(portalId && formGuid);
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />

  {
    inputs && (
      <div class={`flex flex-col max-w-xl mx-auto rounded-lg backdrop-blur border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 shadow p-4 sm:p-6 lg:p-8 w-full ${classes?.form ?? ''}`}>
        <FormContainer
          inputs={inputs}
          textarea={textarea}
          disclaimer={disclaimer}
          button={button}
          description={description}
          formAttributes={{
            id: formElementId,
            'data-hs-form': hasHubspotBridge ? 'true' : 'false',
            'data-hs-portal-id': portalId,
            'data-hs-form-guid': formGuid,
            'data-hs-form-region': region,
            'data-hs-loading-text': loadingText,
          }}
        />

        {hasHubspotBridge && (
          <div id={`${formElementId}-hubspot-source`} data-hs-form-source hidden></div>
        )}

        {hasHubspotBridge && (
          <div class="mt-4 space-y-2 hidden" data-hs-form-messages-parent={formElementId}>
            <p
              class="hidden text-sm text-emerald-600"
              data-hs-form-success
              data-for={formElementId}
              role="status"
            >
              {successMessage}
            </p>
            <p class="hidden text-sm text-rose-600" data-hs-form-error data-for={formElementId} role="alert">
              {errorMessage}
            </p>
          </div>
        )}
      </div>
    )
  }
</WidgetWrapper>

{hasHubspotBridge && (
  <script
    is:inline
    define:vars={{
      formElementId,
      portalId,
      formGuid,
      fieldMapping,
      loadingText,
      successMessage,
      errorMessage,
      region,
    }}
  >
    const scriptId = `hs-form-script-${region}-${portalId}`;
    const scriptSrc = `https://js-${region}.hsforms.net/forms/embed/v2.js`;
    const sourceContainerId = `${formElementId}-hubspot-source`;
    let manualMappingEntries = Object.entries(fieldMapping ?? {}).filter(([, remote]) => Boolean(remote));
    let mappingEntries = manualMappingEntries.slice();
    const manualMapping = manualMappingEntries.length > 0;
    const manualMap = new Map(manualMappingEntries.map(([local, remote]) => [remote, local]));

    const endpoint = `https://api.hsforms.com/submissions/v3/integration/submit/${portalId}/${formGuid}`;

    const staticFields = [];
    const staticFieldNames = new Set();
    let hubspotFormPromise = null;

    const findMessageWrapper = () =>
      document.querySelector(`[data-hs-form-messages-parent="${formElementId}"]`);

    const getCookie = (name) => {
      const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]+)`));
      return match ? decodeURIComponent(match[1]) : undefined;
    };

    const updateWrapperVisibility = (wrapper) => {
      if (!wrapper) return;
      const hasVisibleMessage = Array.from(
        wrapper.querySelectorAll('[data-hs-form-success],[data-hs-form-error]')
      ).some((node) => !node.classList.contains('hidden'));
      wrapper.classList.toggle('hidden', !hasVisibleMessage);
    };

    const hideMessage = (element, wrapper) => {
      if (!element) return;
      element.classList.add('hidden');
      const defaultMessage = element.dataset.defaultMessage;
      if (defaultMessage) {
        element.textContent = defaultMessage;
      }
      updateWrapperVisibility(wrapper);
    };

    const showMessage = (element, wrapper, overrideText) => {
      if (!element) return;
      if (!element.dataset.defaultMessage) {
        element.dataset.defaultMessage = element.textContent?.trim() ?? '';
      }
      element.textContent = overrideText ?? element.dataset.defaultMessage ?? '';
      element.classList.remove('hidden');
      if (wrapper) {
        wrapper.classList.remove('hidden');
      }
      updateWrapperVisibility(wrapper);
    };

    const setButtonLoading = (button, isLoading) => {
      if (!button) return;
      if (isLoading) {
        if (!button.dataset.originalContent) {
          button.dataset.originalContent = button.innerHTML;
        }
        button.disabled = true;
        button.innerHTML = loadingText;
      } else {
        button.disabled = false;
        if (button.dataset.originalContent) {
          button.innerHTML = button.dataset.originalContent;
          delete button.dataset.originalContent;
        }
      }
    };

    const ensureHubspotScript = () =>
      new Promise((resolve, reject) => {
        const existing = document.querySelector(`script[data-hs-script-id="${scriptId}"]`);
        if (existing) {
          if (window.hbspt?.forms?.create) {
            resolve();
            return;
          }
          existing.addEventListener('load', () => resolve(), { once: true });
          existing.addEventListener('error', () => reject(new Error('HubSpot script failed to load')), {
            once: true,
          });
          return;
        }

        const script = document.createElement('script');
        script.src = scriptSrc;
        script.defer = true;
        script.async = true;
        script.dataset.hsScriptId = scriptId;
        script.addEventListener('load', () => resolve(), { once: true });
        script.addEventListener('error', () => reject(new Error('HubSpot script failed to load')), { once: true });
        document.head.appendChild(script);
      });

    const loadHubspotForm = () => {
      if (hubspotFormPromise) {
        return hubspotFormPromise;
      }

      hubspotFormPromise = ensureHubspotScript().then(
        () =>
          new Promise((resolve, reject) => {
            const mount = document.getElementById(sourceContainerId);
            if (!mount) {
              reject(new Error('Missing HubSpot source container'));
              return;
            }
            mount.innerHTML = '';

            window.hbspt.forms.create({
              region,
              portalId,
              formId: formGuid,
              target: `#${sourceContainerId}`,
              cssRequired: '',
              cssClass: '',
              onFormReady: ($form) => {
                const formEl = Array.isArray($form) ? $form[0] : $form;
                if (!formEl) {
                  reject(new Error('Failed to load HubSpot form contents'));
                  return;
                }
                resolve(formEl);
              },
            });
          })
      );

      return hubspotFormPromise;
    };

    const parseFieldLabel = (wrapper, input) => {
      const labelEl = wrapper.querySelector('label');
      if (labelEl) {
        const text = labelEl.textContent?.replace('*', '').trim();
        if (text) {
          return text;
        }
      }
      const ariaLabel = input.getAttribute('aria-label');
      if (ariaLabel) {
        return ariaLabel.trim();
      }
      const placeholder = input.getAttribute('placeholder');
      if (placeholder) {
        return placeholder.trim();
      }
      return input.name || 'Field';
    };

    const extractFields = (formEl) => {
      const definitions = [];
      const hiddenFields = [];
      const seen = new Set();

      formEl.querySelectorAll('input[type="hidden"]').forEach((input) => {
        if (input.name) {
          hiddenFields.push({ name: input.name, value: input.value || '' });
        }
      });

      const fieldWrappers = Array.from(formEl.querySelectorAll('.hs-form-field'));
      fieldWrappers.forEach((wrapper) => {
        const inputs = Array.from(wrapper.querySelectorAll('input, textarea, select')).filter((element) => {
          if (element.type === 'hidden') return false;
          return true;
        });

        if (!inputs.length) {
          return;
        }

        const primary = inputs[0];
        const remoteName = primary.name;
        if (!remoteName || seen.has(remoteName)) {
          return;
        }
        seen.add(remoteName);

        const label = parseFieldLabel(wrapper, primary);
        const required =
          wrapper.classList.contains('hs-form-required') || inputs.some((input) => input.hasAttribute('required'));

        const localName = manualMap.get(remoteName) ?? remoteName;

        if (primary.tagName === 'TEXTAREA') {
          definitions.push({
            kind: 'textarea',
            name: remoteName,
            localName,
            label,
            required,
            placeholder: primary.getAttribute('placeholder') || '',
          });
          return;
        }

        if (primary.tagName === 'SELECT') {
          const options = Array.from(primary.querySelectorAll('option')).map((option) => ({
            value: option.value,
            label: option.textContent ?? option.value,
          }));
          definitions.push({
            kind: 'select',
            name: remoteName,
            localName,
            label,
            required,
            options,
          });
          return;
        }

        const inputType = primary.type || 'text';

        if ((inputType === 'checkbox' || inputType === 'radio') && inputs.length > 1) {
          const options = inputs.map((input, index) => {
            const optionLabel =
              input.closest('label')?.textContent?.trim() ||
              input.getAttribute('aria-label') ||
              input.value ||
              `Option ${index + 1}`;
            return {
              value: input.value,
              label: optionLabel,
              type: input.type,
            };
          });

          definitions.push({
            kind: inputType === 'radio' ? 'radio-group' : 'checkbox-group',
            name: remoteName,
            localName,
            label,
            required,
            options,
          });
          return;
        }

        if (inputType === 'checkbox') {
          const optionLabel =
            wrapper.querySelector('.hs-form-booleancheckbox-display span')?.textContent?.trim() || label;
          definitions.push({
            kind: 'checkbox-single',
            name: remoteName,
            localName,
            label: optionLabel,
            required,
            value: primary.value || 'true',
          });
          return;
        }

        definitions.push({
          kind: 'input',
          name: remoteName,
          localName,
          label,
          required,
          inputType,
          placeholder: primary.getAttribute('placeholder') || '',
          autocomplete: primary.getAttribute('autocomplete') || 'on',
        });
      });

      return { fields: definitions, hiddenFields };
    };

    const createFieldElement = (def) => {
      if (def.kind === 'checkbox-single') {
        const container = document.createElement('div');
        container.className = 'mt-3 flex items-start';
        container.dataset.hsDisclaimer = def.localName;

        const checkboxWrap = document.createElement('div');
        checkboxWrap.className = 'flex mt-0.5';

        const input = document.createElement('input');
        input.type = 'checkbox';
        input.id = def.localName;
        input.name = def.localName;
        input.value = def.value ?? 'true';
        input.className =
          'cursor-pointer mt-1 py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900';
        if (def.required) input.required = true;

        const labelWrap = document.createElement('div');
        labelWrap.className = 'ml-3';

        const label = document.createElement('label');
        label.htmlFor = def.localName;
        label.className = 'cursor-pointer select-none text-sm text-gray-600 dark:text-gray-400';
        label.textContent = def.label;

        checkboxWrap.appendChild(input);
        labelWrap.appendChild(label);
        container.appendChild(checkboxWrap);
        container.appendChild(labelWrap);
        return container;
      }

      const wrapper = document.createElement('div');
      wrapper.className = 'mb-6';
      wrapper.dataset.hsField = def.localName;

      if (def.label && def.kind !== 'checkbox-group' && def.kind !== 'radio-group') {
        const label = document.createElement('label');
        label.className = 'block text-sm font-medium';
        label.htmlFor = def.localName;
        label.textContent = def.label;
        wrapper.appendChild(label);
      }

      if (def.kind === 'textarea') {
        const textarea = document.createElement('textarea');
        textarea.id = def.localName;
        textarea.name = def.localName;
        textarea.rows = 4;
        textarea.placeholder = def.placeholder || '';
        if (def.required) textarea.required = true;
        textarea.className =
          'py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900';
        wrapper.appendChild(textarea);
        return wrapper;
      }

      if (def.kind === 'select') {
        const select = document.createElement('select');
        select.id = def.localName;
        select.name = def.localName;
        if (def.required) select.required = true;
        select.className =
          'py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900';
        (def.options || []).forEach((option) => {
          const opt = document.createElement('option');
          opt.value = option.value;
          opt.textContent = option.label;
          select.appendChild(opt);
        });
        wrapper.appendChild(select);
        return wrapper;
      }

      if (def.kind === 'checkbox-group' || def.kind === 'radio-group') {
        wrapper.classList.add('space-y-2');
        if (def.label) {
          const legend = document.createElement('p');
          legend.className = 'text-sm font-medium';
          legend.textContent = def.label;
          wrapper.appendChild(legend);
        }
        (def.options || []).forEach((option, index) => {
          const optionWrapper = document.createElement('label');
          optionWrapper.className = 'flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300';
          const input = document.createElement('input');
          input.type = option.type === 'radio' ? 'radio' : 'checkbox';
          input.name = def.localName;
          input.value = option.value;
          input.id = `${def.localName}-${index}`;
          if (def.required && option.type === 'radio') input.required = index === 0;
          const span = document.createElement('span');
          span.textContent = option.label;
          optionWrapper.appendChild(input);
          optionWrapper.appendChild(span);
          wrapper.appendChild(optionWrapper);
        });
        return wrapper;
      }

      const input = document.createElement('input');
      input.type = def.inputType || 'text';
      input.id = def.localName;
      input.name = def.localName;
      input.placeholder = def.placeholder || '';
      input.autocomplete = def.autocomplete || 'on';
      if (def.required) input.required = true;
      input.className =
        'py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900';
      wrapper.appendChild(input);
      return wrapper;
    };

    const buildCustomForm = (definitions) => {
      const form = document.getElementById(formElementId);
      if (!form) return;

      const fieldsWrapper = form.querySelector('[data-hs-fields]');
      const buttonWrapper = form.querySelector('.mt-10.grid');

      if (fieldsWrapper) {
        fieldsWrapper.innerHTML = '';
      }

      form.querySelectorAll('[data-hs-disclaimer]').forEach((node) => node.remove());

      const newMapping = [];
      const disclaimers = [];

      definitions.fields.forEach((def) => {
        const element = createFieldElement(def);
        if (!element) return;
        if (def.kind === 'checkbox-single') {
          disclaimers.push(element);
        } else {
          fieldsWrapper?.appendChild(element);
        }
        newMapping.push([def.localName, def.name]);
      });

      disclaimers.forEach((node) => {
        if (buttonWrapper) {
          buttonWrapper.parentElement?.insertBefore(node, buttonWrapper);
        } else {
          form.appendChild(node);
        }
      });

      if (!manualMapping) {
        mappingEntries = newMapping;
      } else {
        const combined = new Map();
        newMapping.forEach(([local, remote]) => combined.set(local, remote));
        manualMappingEntries.forEach(([local, remote]) => combined.set(local, remote));
        mappingEntries = Array.from(combined.entries());
      }
    };

    const syncFieldsFromHubspot = () =>
      loadHubspotForm()
        .then((formEl) => {
          const definitions = extractFields(formEl);
          if (!definitions) {
            throw new Error('Unable to parse HubSpot fields');
          }
          staticFields.length = 0;
          staticFieldNames.clear();
          definitions.hiddenFields.forEach((hidden) => {
            staticFields.push(hidden);
            if (hidden.name) {
              staticFieldNames.add(hidden.name);
            }
          });
          buildCustomForm(definitions);
        })
        .catch((error) => {
          console.error('HubSpot field sync failed', error);
        });

    const getActiveMapping = (form) => {
      if (mappingEntries.length) {
        return mappingEntries;
      }

      const names = new Set();
      Array.from(form.elements).forEach((element) => {
        if (!('name' in element) || !element.name) return;
        if (element.type === 'submit' || element.disabled) return;
        if (staticFieldNames.has(element.name)) return;
        names.add(element.name);
      });
      return Array.from(names).map((name) => [name, name]);
    };

    const handleSubmit = (event) => {
      const form = event.currentTarget;
      event.preventDefault();

      const successEl = document.querySelector(
        `[data-hs-form-success][data-for="${formElementId}"]`
      );
      const errorEl = document.querySelector(`[data-hs-form-error][data-for="${formElementId}"]`);
      const wrapper = findMessageWrapper();
      const submitButton = form.querySelector('button[type="submit"]');

      hideMessage(successEl, wrapper);
      hideMessage(errorEl, wrapper);
      setButtonLoading(submitButton, true);

      const formData = new FormData(form);
      const fields = [];

      const activeMapping = getActiveMapping(form);
      for (const [localField, remoteField] of activeMapping) {
        const values = formData.getAll(localField);
        const normalized = values
          .map((value) => (typeof value === 'string' ? value.trim() : `${value}`.trim()))
          .filter((value) => value.length > 0);

        if (!normalized.length) {
          continue;
        }

        const finalValue = normalized.length === 1 ? normalized[0] : normalized.join(';');
        fields.push({ name: remoteField, value: finalValue });
      }

      staticFields.forEach((hidden) => {
        if (hidden?.name && !fields.some((field) => field.name === hidden.name)) {
          fields.push({ name: hidden.name, value: hidden.value ?? '' });
        }
      });

      if (!fields.length) {
        setButtonLoading(submitButton, false);
        showMessage(errorEl, wrapper, 'Please complete the required fields.');
        return;
      }

      const payload = {
        fields,
        context: {
          pageUri: window.location.href,
          pageName: document.title,
        },
      };

      const hubspotUtk = getCookie('hubspotutk');
      if (hubspotUtk) {
        payload.context.hutk = hubspotUtk;
      }

      fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        mode: 'cors',
        credentials: 'omit',
      })
        .then((response) => {
          if (!response.ok) {
            return response
              .json()
              .catch(() => ({}))
              .then((data) => {
                const message =
                  data?.message || data?.errors?.[0]?.message || `HubSpot responded with ${response.status}`;
                throw new Error(message);
              });
          }
          return response.json().catch(() => ({}));
        })
        .then(() => {
          form.reset();
          setButtonLoading(submitButton, false);
          showMessage(successEl, wrapper);
        })
        .catch((error) => {
          console.error('HubSpot form submission failed', error);
          setButtonLoading(submitButton, false);
          showMessage(errorEl, wrapper);
        });
    };

    const attach = () => {
      const form = document.getElementById(formElementId);
      if (!form || form.dataset.hsHubspotBridge === 'true') {
        return;
      }

      form.dataset.hsHubspotBridge = 'true';
      form.addEventListener('submit', handleSubmit);

      const wrapper = findMessageWrapper();
      updateWrapperVisibility(wrapper);
    };

    const initialize = () => {
      attach();
      syncFieldsFromHubspot();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialize, { once: true });
    } else {
      initialize();
    }

    document.addEventListener('astro:page-load', initialize);
    document.addEventListener('astro:after-swap', () => {
      const form = document.getElementById(formElementId);
      if (form) {
        delete form.dataset.hsHubspotBridge;
      }
      mappingEntries = manualMappingEntries.slice();
      hubspotFormPromise = null;
      initialize();
    });
  </script>
)}
