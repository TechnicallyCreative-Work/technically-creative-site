---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import BrandBanner from '~/components/widgets/BrandBanner.astro';
import Hero from '~/components/widgets/Hero.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';
import { headerData } from '~/navigation';

import gDesk1 from '~/assets/images/desk1.jpg';
import gDesk2 from '~/assets/images/desk2.jpg';
import gDesk3 from '~/assets/images/desk3.jpg';
import gAiDesk from '~/assets/images/gallery-studio-ai-desk.png';
import gBedroomStudio from '~/assets/images/gallery-bedroom-studio.jpg';
import gTcMonochrome from '~/assets/images/gallery-tc-monochrome.png';
import gTcYtBanner from '~/assets/images/gallery-tc-yt-banner.png';
import gTcFbCover from '~/assets/images/gallery-tc-fb-cover.png';
import gTcIgStory from '~/assets/images/gallery-tc-ig-story.png';
import gTcWallpaperGd from '~/assets/images/brand-tc-wallpaper-gd.png';
import gRvxxLogo from '~/assets/images/brand-rvxx-logo.png';
import gRvxxArgent from '~/assets/images/brand-rvxx-argent.jpg';
import gRvxxArgent2 from '~/assets/images/brand-rvxx-argent2.jpg';
import gVantablakAlbum from '~/assets/images/brand-vantablak-album.jpg';
import gVbLive01 from '~/assets/images/gallery-vantablak-live-01.jpg';
import gVbLive02 from '~/assets/images/gallery-vantablak-live-02.jpg';
import gVbLive03 from '~/assets/images/gallery-vantablak-live-03.jpg';
import gVbLive04 from '~/assets/images/gallery-vantablak-live-04.jpg';

const galleries: Record<string, { src: string; alt: string }[]> = {
  'graphic-design': [
    { src: gTcMonochrome.src, alt: 'TC monochrome logo' },
    { src: gTcYtBanner.src, alt: 'TC YouTube banner' },
    { src: gTcFbCover.src, alt: 'TC Facebook cover' },
    { src: gTcIgStory.src, alt: 'TC Instagram story template' },
    { src: gTcWallpaperGd.src, alt: 'TC graphic design wallpaper' },
    { src: gRvxxLogo.src, alt: 'RVXX glowing logo' },
    { src: gRvxxArgent.src, alt: 'RVXX Argent Metal lettering' },
    { src: gRvxxArgent2.src, alt: 'RVXX Argent Metal lettering variant' },
    { src: gVantablakAlbum.src, alt: 'Vantablak album artwork' },
    { src: gVbLive01.src, alt: 'Vantablak live at Melody Inn' },
    { src: gVbLive02.src, alt: 'Vantablak live performance' },
  ],
  'services': [
    { src: gDesk1.src, alt: 'Studio setup' },
    { src: gDesk3.src, alt: 'Ableton session' },
  ],
  'local-services': [
    { src: gBedroomStudio.src, alt: 'Bedroom studio' },
    { src: gDesk2.src, alt: 'In-home studio desk' },
    { src: gAiDesk.src, alt: 'Studio workspace' },
    { src: gVbLive03.src, alt: 'Vantablak live sound — Melody Inn' },
    { src: gVbLive04.src, alt: 'Vantablak live performance' },
  ],
};

const metadata = {
  title: 'Local & Custom Services — Technically Creative LLC',
  description: 'Graphic design commissions, online consulting, and Indianapolis local services — recording, live sound, DJ, karaoke, and in-person Ableton training.',
};

const upworkServices = [
  { title: 'Ableton Live Workflow & Controller Setup', subtitle: '90-Minute Session', price: 'From $250', url: 'https://www.upwork.com/freelancers/techcre8' },
  { title: 'Optimized Ableton Workflow for Faster Music Production', subtitle: 'Workflow audit & rebuild', price: 'From $85', url: 'https://www.upwork.com/freelancers/techcre8' },
  { title: 'Ableton Production Workflow & Track Finishing', subtitle: 'Full session support', price: 'From $200', url: 'https://www.upwork.com/freelancers/techcre8' },
  { title: 'Automation Audit & Architecture Review', subtitle: 'For your workflows', price: 'From $250', url: 'https://www.upwork.com/freelancers/techcre8' },
];
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header
      links={headerData.links}
      actions={[{ text: 'Hire me', href: getPermalink('/contact#form') }]}
      isSticky
      showToggleTheme
    />
  </Fragment>
  <BrandBanner />
  <Hero
    tagline="Local & Custom Services"
    title="Book Local & Custom Work"
    actions={[{ variant: 'primary', text: 'Start a project', href: getPermalink('/contact#form') }]}
  >
    <Fragment slot="subtitle">
      Graphic design commissions, online consulting through Upwork, and Indianapolis local services — recording, live
      sound, DJ, karaoke, and Ableton training. Looking for digital downloads instead? Visit
      <a href={getPermalink('/products')} class="font-semibold text-primary hover:underline">Products</a>.
    </Fragment>
  </Hero>

  <!-- Graphic Design & Commissions -->
  <WidgetWrapper id="graphic-design" containerClass="max-w-6xl mx-auto py-12 md:py-16">
    <div class="flex items-center gap-3 text-primary">
      <Icon name="tabler:palette" class="h-7 w-7" />
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">Graphic Design & Commissions</h2>
    </div>
    <p class="mt-2 max-w-2xl text-muted dark:text-slate-300">Standard design requests and original art commissions. All services are quoted per project — reach out with your brief and I'll follow up within one business day.</p>

    {galleries['graphic-design'].length > 0 && (
      <div class="mt-6 flex gap-3 overflow-x-auto pb-2">
        {galleries['graphic-design'].map(({ src, alt }) => (
          <div class="shrink-0 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
            <img src={src} alt={alt} class="h-44 w-auto object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    )}

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {[
        { icon: 'tabler:vector-triangle', title: 'Logo Design', desc: 'Custom logo design from concept to final files — wordmarks, icon marks, and full identity packages. Delivered in vector and raster formats.' },
        { icon: 'tabler:disc', title: 'Album Artwork', desc: 'Album covers, single artwork, EP packaging, and video thumbnails — designed to match your sonic identity. Versioned for streaming, physical, and promo use.' },
        { icon: 'tabler:brush', title: 'Digital Illustration', desc: 'Original digital art and illustrations — character design, scene work, stylized portraits, and concept art for personal or commercial use.' },
        { icon: 'tabler:brand-instagram', title: 'Social Media Graphics', desc: 'Post graphics, story templates, profile covers, and banner sets — sized and optimized for Instagram, YouTube, LinkedIn, and more.' },
        { icon: 'tabler:artboard', title: 'Banners & Headers', desc: 'Web banners, email headers, event flyers, and promotional graphics. Clean layouts built for digital and print.' },
        { icon: 'tabler:printer', title: 'Print-Ready Artwork', desc: 'High-resolution artwork prepared for print — posters, merch graphics, event flyers, and production-ready files.' },
        { icon: 'tabler:package', title: 'Band & Artist Identity Package', desc: 'Full visual identity for musicians and bands — logo, color palette, font pairing, social templates, album art style guide, and merch-ready assets. Includes experience designing for Argent Metal (RVXX) and industrial/dark electronic projects (Vantablak).' },
      ].map(({ icon, title, desc }) => (
        <div class="flex flex-col rounded-2xl border border-dashed border-primary/30 bg-white/70 p-5 dark:bg-slate-900/40">
          <div class="flex items-center gap-2 text-primary mb-3">
            <Icon name={icon} class="h-5 w-5 shrink-0" />
            <span class="font-bold text-slate-900 dark:text-white">{title}</span>
          </div>
          <p class="text-sm text-muted dark:text-slate-400 flex-1">{desc}</p>
          <a href="/contact#form" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline">
            Get a quote <Icon name="tabler:arrow-right" class="h-4 w-4" />
          </a>
        </div>
      ))}
    </div>

    <!-- Commissions -->
    <div class="mt-10">
      <h3 class="flex items-center gap-2 text-lg font-bold text-slate-900 dark:text-white">
        <Icon name="tabler:writing" class="h-5 w-5 text-primary" />
        Watercolor & Ink Commissions
      </h3>
      <p class="mt-2 max-w-2xl text-sm text-muted dark:text-slate-400">
        Original hand-crafted artwork on paper — custom subjects, portraits, characters, scenes, and conceptual pieces. Each commission is priced individually based on size, complexity, and turnaround time.
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-primary/30 bg-primary/5 p-5 dark:bg-primary/10">
          <p class="font-semibold text-slate-900 dark:text-white">What's included</p>
          <ul class="mt-3 space-y-1.5 text-sm text-muted dark:text-slate-400">
            <li class="flex items-start gap-2"><Icon name="tabler:check" class="mt-0.5 h-4 w-4 shrink-0 text-primary" /> Initial concept sketch for approval</li>
            <li class="flex items-start gap-2"><Icon name="tabler:check" class="mt-0.5 h-4 w-4 shrink-0 text-primary" /> Original artwork on quality paper</li>
            <li class="flex items-start gap-2"><Icon name="tabler:check" class="mt-0.5 h-4 w-4 shrink-0 text-primary" /> High-resolution scan of the final piece</li>
            <li class="flex items-start gap-2"><Icon name="tabler:check" class="mt-0.5 h-4 w-4 shrink-0 text-primary" /> One round of revisions included</li>
            <li class="flex items-start gap-2"><Icon name="tabler:check" class="mt-0.5 h-4 w-4 shrink-0 text-primary" /> Shipping available (US only, cost added)</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-dashed border-primary/30 bg-white/70 p-5 dark:bg-slate-900/40">
          <p class="font-semibold text-slate-900 dark:text-white">Pricing factors</p>
          <ul class="mt-3 space-y-1.5 text-sm text-muted dark:text-slate-400">
            <li class="flex items-start gap-2"><Icon name="tabler:ruler" class="mt-0.5 h-4 w-4 shrink-0 text-primary" /> Size — small (5×7) to large (18×24)</li>
            <li class="flex items-start gap-2"><Icon name="tabler:adjustments" class="mt-0.5 h-4 w-4 shrink-0 text-primary" /> Complexity — single subject vs. full scene</li>
            <li class="flex items-start gap-2"><Icon name="tabler:clock" class="mt-0.5 h-4 w-4 shrink-0 text-primary" /> Turnaround — standard (2–4 weeks) or rush</li>
            <li class="flex items-start gap-2"><Icon name="tabler:droplet" class="mt-0.5 h-4 w-4 shrink-0 text-primary" /> Medium — watercolor, ink, or combined</li>
          </ul>
          <a
            href="/contact#form"
            class="mt-5 inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-primary/90"
          >
            Request a commission quote <Icon name="tabler:arrow-right" class="h-4 w-4" />
          </a>
        </div>
      </div>
    </div>
  </WidgetWrapper>

  <!-- Services & Consulting -->
  <WidgetWrapper id="services" containerClass="max-w-6xl mx-auto py-12 md:py-16">
    <div class="flex items-center gap-3 text-primary">
      <Icon name="tabler:briefcase" class="h-7 w-7" />
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">Services & Consulting</h2>
    </div>
    <p class="mt-2 max-w-2xl text-muted dark:text-slate-300">Ongoing and contract services booked through Upwork — hourly or fixed-price, with full contract and payment protection.</p>

    {galleries['services'].length > 0 && (
      <div class="mt-6 flex gap-3 overflow-x-auto pb-2">
        {galleries['services'].map(({ src, alt }) => (
          <div class="shrink-0 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
            <img src={src} alt={alt} class="h-44 w-auto object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    )}

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {upworkServices.map(({ title, subtitle, price, url }) => (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col rounded-2xl border border-dashed border-primary/30 bg-white/70 p-5 transition hover:border-primary/60 hover:shadow-md dark:bg-slate-900/40"
        >
          <div class="flex items-start justify-between gap-2">
            <span class="font-semibold text-slate-900 dark:text-white">{title}</span>
            <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300">{price}</span>
          </div>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{subtitle}</p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-primary group-hover:underline">
            Book on Upwork <Icon name="tabler:external-link" class="h-4 w-4" />
          </span>
        </a>
      ))}
    </div>
  </WidgetWrapper>

  <!-- Indianapolis Local Services -->
  <WidgetWrapper id="local-services" containerClass="max-w-6xl mx-auto py-12 md:py-16">
    <div class="flex items-center gap-3 text-primary">
      <Icon name="tabler:map-pin" class="h-7 w-7" />
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">Indianapolis Local Services</h2>
    </div>
    <p class="mt-2 max-w-3xl text-muted dark:text-slate-300">
      In-person services available in the Indianapolis area. All analog instrument recording is done at
      <a href="https://www.engineroomrecording.com" target="_blank" rel="noopener noreferrer" class="font-semibold text-primary hover:underline">The Engine Room Recording Company</a>
      in Broadripple unless otherwise specified — studio-grade multi-mic tracking for full bands and advanced sessions.
      My in-home bedroom studio handles solo tracking: one vocalist, guitarist, bassist, or similar at a time.
    </p>

    {galleries['local-services'].length > 0 && (
      <div class="mt-6 flex gap-3 overflow-x-auto pb-2">
        {galleries['local-services'].map(({ src, alt }) => (
          <div class="shrink-0 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
            <img src={src} alt={alt} class="h-44 w-auto object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    )}

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {[
        {
          icon: 'tabler:microphone',
          title: 'Recording',
          desc: 'Vocal, instrument, and full-band recording sessions. Multi-mic setups and advanced tracking at The Engine Room (Broadripple). Solo tracking — vocals, guitar, bass — available at the in-home bedroom studio.',
          tag: 'Studio & In-Home',
        },
        {
          icon: 'tabler:speakerphone',
          title: 'Live Sound Engineering',
          desc: 'PA setup, front-of-house mixing, and monitor engineering for live events, venues, showcases, and private performances in the Indianapolis area.',
          tag: 'On-Site',
        },
        {
          icon: 'tabler:package',
          title: 'Equipment Rental',
          desc: 'Audio gear rental for events and sessions — PA systems, microphones, DI boxes, and more. Contact to discuss your setup and availability.',
          tag: 'Local Pickup / Delivery',
        },
        {
          icon: 'tabler:music',
          title: 'Music Producer',
          desc: 'In-person production sessions — beat-making, arrangement, tracking, and mix direction. Collaborative sessions at the bedroom studio or on location.',
          tag: 'Studio & On-Site',
        },
        {
          icon: 'tabler:device-speaker',
          title: 'DJ',
          desc: 'Live DJ sets for private events, parties, corporate gatherings, and special occasions in Indianapolis and surrounding areas.',
          tag: 'On-Site',
        },
        {
          icon: 'tabler:music-star',
          title: 'Karaoke',
          desc: 'Full karaoke setup and hosting for private parties, corporate events, and community gatherings. PA, mics, and song library included.',
          tag: 'On-Site',
        },
        {
          icon: 'tabler:user',
          title: '1-on-1 Ableton Training',
          desc: 'Private in-person Ableton Live sessions tailored to your level — interface orientation, MIDI, production workflow, or live performance setup. At your location or mine.',
          tag: 'In-Person',
        },
        {
          icon: 'tabler:users',
          title: 'Group Ableton Training',
          desc: 'Small-group workshops and classroom-style sessions covering Ableton basics through advanced topics. Great for music programs, studios, and creative teams.',
          tag: 'Workshops',
        },
        {
          icon: 'tabler:tool',
          title: 'Instrument Setup',
          desc: 'Pickup and hardware installation, restringing, and precision guitar setup — action, intonation, nut slots, and truss rod dialed to your playing style. Work outside this scope (structural repairs, refrets, finish work) is referred to Indy String Theory.',
          tag: 'In-Person',
        },
      ].map(({ icon, title, desc, tag }) => (
        <div class="flex flex-col rounded-2xl border border-dashed border-primary/30 bg-white/70 p-5 dark:bg-slate-900/40">
          <div class="flex items-start justify-between gap-2">
            <div class="flex items-center gap-2 text-primary">
              <Icon name={icon} class="h-5 w-5 shrink-0" />
              <span class="font-bold text-slate-900 dark:text-white">{title}</span>
            </div>
            <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-500 dark:bg-slate-800 dark:text-slate-400">{tag}</span>
          </div>
          <p class="mt-3 text-sm text-muted dark:text-slate-400">{desc}</p>
          <a
            href="/contact#form"
            class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline"
          >
            Contact to book <Icon name="tabler:arrow-right" class="h-4 w-4" />
          </a>
        </div>
      ))}
    </div>

    <div class="mt-8 rounded-2xl border border-primary/20 bg-primary/5 px-6 py-5 dark:bg-primary/10">
      <div class="flex items-start gap-3">
        <Icon name="tabler:building" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
        <div>
          <p class="font-semibold text-slate-900 dark:text-white">Recording Venue Info</p>
          <p class="mt-1 text-sm text-muted dark:text-slate-400">
            All analog instrument recording defaults to <span class="font-medium text-slate-700 dark:text-slate-300">The Engine Room Recording Company</span> in Broadripple, Indianapolis — a professional studio built for multi-mic tracking, full bands, and advanced sessions. Solo tracking (one vocalist, guitarist, bassist, etc.) is available at my in-home bedroom studio. Alternate venues can be arranged — mention your preference when you reach out.
          </p>
        </div>
      </div>
    </div>
  </WidgetWrapper>

  <CallToAction
    title="Need something custom?"
    subtitle="Have a project that doesn't fit a listed service? Get in touch and we'll scope it out together."
    actions={[{ variant: 'primary', text: 'Start a project', href: getPermalink('/contact#form') }]}
  />
</Layout>
