---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import BrandBanner from '~/components/widgets/BrandBanner.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { Icon } from 'astro-icon/components';
import { headerData } from '~/navigation';

// Guaranteed non-null here — src/middleware.ts redirects unauthenticated
// requests to /login before this page ever renders (this page lives under
// /account, already covered by PROTECTED_PREFIXES).
const { user, supabase } = Astro.locals;

const { data: profile } = await supabase.from('profiles').select('membership_tier').eq('id', user!.id).single();
const isPaid = profile?.membership_tier === 'paid';

const { data: saves } = isPaid
  ? await supabase
      .from('notemapper_saves')
      .select('id, original_filename, detected_key, detected_bpm, storage_prefix, created_at')
      .eq('user_id', user!.id)
      .order('created_at', { ascending: false })
  : { data: [] };

const savesWithLinks = await Promise.all(
  (saves ?? []).map(async (save) => {
    const files = ['original.mid', 'tab.txt', 'fingering.json', 'report.html'];
    const links = await Promise.all(
      files.map(async (file) => {
        const { data } = await supabase.storage
          .from('notemapper-saves')
          .createSignedUrl(`${save.storage_prefix}/${file}`, 3600);
        return { file, url: data?.signedUrl ?? null };
      })
    );
    return { ...save, links };
  })
);

const metadata = {
  title: 'My NoteMapper Saves — Technically Creative LLC',
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header links={headerData.links} isSticky showToggleTheme />
  </Fragment>
  <BrandBanner />

  <div class="container pt-10 pb-2 md:pt-14">
    <h1 class="text-3xl font-bold tracking-tight md:text-4xl">My NoteMapper Saves</h1>
    <p class="mt-3 max-w-2xl text-muted dark:text-slate-400">
      Original MIDI files and generated exports saved from <a href="/notemapper" class="text-primary hover:underline"
        >NoteMapper</a
      >.
    </p>
  </div>

  <WidgetWrapper containerClass="max-w-2xl mx-auto py-4 md:py-8">
    {
      !isPaid && (
        <div class="rounded-2xl border border-primary/30 bg-white/70 p-6 text-sm dark:bg-slate-900/40">
          Saving NoteMapper work requires a paid membership.{' '}
          <a href="/account" class="font-semibold text-primary hover:underline">
            Upgrade from your account page
          </a>
          .
        </div>
      )
    }

    {
      isPaid && savesWithLinks.length === 0 && (
        <div class="rounded-2xl border border-primary/30 bg-white/70 p-6 text-sm dark:bg-slate-900/40">
          No saves yet — convert a file on the NoteMapper tool and click "Save to My Account".
        </div>
      )
    }

    {
      isPaid && savesWithLinks.length > 0 && (
        <div class="space-y-4">
          {savesWithLinks.map((save) => (
            <div class="rounded-2xl border border-primary/30 bg-white/70 p-6 dark:bg-slate-900/40">
              <div class="flex items-center justify-between gap-2">
                <span class="font-semibold text-slate-900 dark:text-white">{save.original_filename}</span>
                <span class="shrink-0 text-xs text-muted dark:text-slate-400">
                  {new Date(save.created_at).toLocaleDateString()}
                </span>
              </div>
              {(save.detected_key || save.detected_bpm) && (
                <p class="mt-1 text-xs text-muted dark:text-slate-400">
                  {save.detected_key} {save.detected_bpm && `· ${save.detected_bpm} BPM`}
                </p>
              )}
              <div class="mt-4 flex flex-wrap gap-2">
                {save.links
                  .filter((link) => link.url)
                  .map((link) => (
                    <a
                      href={link.url!}
                      target="_blank"
                      class="flex items-center gap-1.5 rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-gray-50 dark:border-gray-700 dark:text-slate-300 dark:hover:bg-slate-800"
                    >
                      <Icon name="tabler:download" class="h-3.5 w-3.5" /> {link.file}
                    </a>
                  ))}
              </div>
            </div>
          ))}
        </div>
      )
    }
  </WidgetWrapper>
</Layout>
