---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import BrandBanner from '~/components/widgets/BrandBanner.astro';
import Hero from '~/components/widgets/Hero.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';
import { headerData } from '~/navigation';

const metadata = {
  title: 'Tools — Technically Creative LLC',
  description: 'Free browser-based tools built by Technically Creative — starting with NoteMapper, a MIDI to guitar tab converter.',
};

// Add new entries here as more tools ship — each renders as a card below.
const tools = [
  {
    slug: 'notemapper',
    name: 'NoteMapper',
    tagline: 'MIDI to Tab',
    description:
      'Drop in a .mid file and get back an ASCII guitar tab, an interactive fretboard map, and a fingering guide — with AI-assisted key and playability notes.',
    icon: 'tabler:piano',
    href: getPermalink('/notemapper'),
    status: 'live',
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header
      links={headerData.links}
      actions={[{ text: 'Hire me', href: getPermalink('/contact#form') }]}
      isSticky
      showToggleTheme
    />
  </Fragment>
  <BrandBanner />
  <Hero tagline="Tools" title="Free Tools">
    <Fragment slot="subtitle">
      Browser-based tools built by Technically Creative — pick one below to get started. More are on the way.
    </Fragment>
  </Hero>

  <WidgetWrapper id="tools-grid" containerClass="max-w-6xl mx-auto py-4 md:py-8">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map(({ name, tagline, description, icon, href, status }) => (
        <a
          href={href}
          class="group flex flex-col overflow-hidden rounded-2xl border border-primary/30 bg-white/70 transition hover:border-primary hover:shadow-lg dark:bg-slate-900/40"
        >
          <div class="flex h-32 items-center justify-center bg-primary/5 dark:bg-primary/10">
            <Icon name={icon} class="h-14 w-14 text-primary" />
          </div>
          <div class="flex flex-1 flex-col p-5">
            <div class="flex items-start justify-between gap-2">
              <span class="text-lg font-bold text-slate-900 dark:text-white">{name}</span>
              {status === 'live' && (
                <span class="shrink-0 rounded-full bg-emerald-500/15 px-2.5 py-0.5 text-xs font-bold text-emerald-600 dark:text-emerald-400">Live</span>
              )}
            </div>
            <p class="text-sm font-medium text-primary">{tagline}</p>
            <p class="mt-2 flex-1 text-sm text-muted dark:text-slate-400">{description}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary group-hover:underline">
              Open tool <Icon name="tabler:arrow-right" class="h-4 w-4" />
            </span>
          </div>
        </a>
      ))}

      <!-- Suggest-a-tool card -->
      <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-primary/30 bg-white/50 p-6 text-center dark:bg-slate-900/20">
        <Icon name="tabler:bulb" class="h-10 w-10 text-primary" />
        <p class="mt-3 font-semibold text-slate-900 dark:text-white">More tools coming soon</p>
        <p class="mt-1 text-sm text-muted dark:text-slate-400">Got a tool you'd find useful? Let me know what you need.</p>
        <a
          href={getPermalink('/contact#form')}
          class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline"
        >
          Suggest a tool <Icon name="tabler:arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </WidgetWrapper>

  <CallToAction
    title="Need something more custom-built?"
    subtitle="Workflow automations, internal tools, and custom builds are part of what I do — let's talk about what you need."
    actions={[{ variant: 'primary', text: 'Start a project', href: getPermalink('/contact#form') }]}
  />
</Layout>
