---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import BrandBanner from '~/components/widgets/BrandBanner.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { headerData } from '~/navigation';

// A valid reset link signs the visitor in (via /api/auth/callback) before landing
// here. No session means the link was never used, expired, or was opened in a
// different browser — send them to request a fresh one rather than showing a
// form that can only fail.
if (!Astro.locals.user) {
  return Astro.redirect('/forgot-password?error=link_expired');
}

const metadata = {
  title: 'Choose a New Password — Technically Creative LLC',
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header links={headerData.links} isSticky showToggleTheme />
  </Fragment>
  <BrandBanner />

  <div class="container pt-10 pb-2 md:pt-14">
    <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Choose a New Password</h1>
    <p class="mt-3 max-w-2xl text-muted dark:text-slate-400">{Astro.locals.user.email}</p>
  </div>

  <WidgetWrapper containerClass="max-w-md mx-auto py-4 md:py-8">
    <form id="reset-form" class="rounded-2xl border border-primary/30 bg-white/70 p-6 dark:bg-slate-900/40">
      <div class="mb-4">
        <label for="password" class="block text-sm font-medium text-slate-900 dark:text-white">New password</label>
        <input
          id="password"
          name="password"
          type="password"
          required
          minlength="8"
          autocomplete="new-password"
          class="mt-1 w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm dark:border-gray-700 dark:bg-slate-900"
        />
      </div>
      <div class="mb-4">
        <label for="confirm" class="block text-sm font-medium text-slate-900 dark:text-white"
          >Confirm new password</label
        >
        <input
          id="confirm"
          name="confirm"
          type="password"
          required
          minlength="8"
          autocomplete="new-password"
          class="mt-1 w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm dark:border-gray-700 dark:bg-slate-900"
        />
      </div>
      <p id="reset-error" class="mb-4 hidden text-sm text-rose-600"></p>
      <button
        type="submit"
        id="reset-submit"
        class="w-full rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60"
      >
        Update password
      </button>
    </form>
  </WidgetWrapper>
</Layout>

<script>
  import { createSupabaseBrowserClient } from '~/lib/supabase-client';
  import { friendlyAuthError } from '~/lib/auth-messages';

  const form = document.getElementById('reset-form') as HTMLFormElement;
  const errorEl = document.getElementById('reset-error') as HTMLParagraphElement;
  const submitBtn = document.getElementById('reset-submit') as HTMLButtonElement;

  // Constructed defensively — see login.astro for why.
  let supabase: ReturnType<typeof createSupabaseBrowserClient> | null = null;
  try {
    supabase = createSupabaseBrowserClient();
  } catch (err) {
    console.error('Failed to initialize Supabase client', err);
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl.classList.add('hidden');

    if (!supabase) {
      errorEl.textContent = 'Password reset is temporarily unavailable. Please try again shortly.';
      errorEl.classList.remove('hidden');
      return;
    }

    const formData = new FormData(form);
    const password = String(formData.get('password') ?? '');

    if (password !== String(formData.get('confirm') ?? '')) {
      errorEl.textContent = "Those passwords don't match.";
      errorEl.classList.remove('hidden');
      return;
    }

    submitBtn.disabled = true;
    const { error } = await supabase.auth.updateUser({ password });

    if (error) {
      submitBtn.disabled = false;
      errorEl.textContent = friendlyAuthError(error);
      errorEl.classList.remove('hidden');
      return;
    }

    window.location.href = '/account?notice=password_updated';
  });
</script>
