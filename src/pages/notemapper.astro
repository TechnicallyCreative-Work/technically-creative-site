</div>
<div class="sec"><div class="sh">Fingering Guide</div>
  <div style="overflow-x:auto;background:#0d1526;border:0.5px solid rgba(0,229,255,0.15);border-radius:9px;padding:16px;">${fingHTML}</div>
</div>
<div class="sec"><div class="sh">AI Analysis</div>
  <div class="ai"><strong>Claude Analysis</strong>${aiText||'No AI analysis available.'}</div>
</div>
<div class="foot">
  <span>TechCre8 NoteMapper v4 · <a href="https://technicallycreative.work">technicallycreative.work</a></span>
  <span>Fusing creative artistry with disciplined project execution.</span>
</div>
</body></html>`;
}

// ── DOWNLOAD ───────────────────────────────────────────────────
function downloadReport(){
  if(!allEvents.length){showStatus('Run analysis first.','err');return;}
  const html=buildReportHTML();
  const blob=new Blob([html],{type:'text/html;charset=utf-8'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');
  a.href=url;
  a.download=`TechCre8_Tab_${currentFileName}_${new Date().toISOString().slice(0,10)}.html`;
  document.body.appendChild(a);a.click();document.body.removeChild(a);
  setTimeout(()=>URL.revokeObjectURL(url),5000);
  showStatus('✓ Report downloaded! Open in Chrome → Ctrl+P → Save as PDF for a PDF version.','ok');
}

// ── GOOGLE DRIVE ───────────────────────────────────────────────
async function saveToDrive(){
  if(!allEvents.length){showStatus('Run analysis first.','err');return;}
  const apiKey=localStorage.getItem('tc_api_key');
  if(!apiKey){showStatus('Add your Anthropic API key first.','err');return;}
  const btn=document.getElementById('driveBtn');
  btn.disabled=true;btn.textContent='Saving to Drive...';
  const html=buildReportHTML();
  const fileName=`TechCre8_Tab_${currentFileName}_${new Date().toISOString().slice(0,10)}.html`;
  try{
    const resp=await fetch('https://api.anthropic.com/v1/messages',{
      method:'POST',
      headers:{'Content-Type':'application/json','x-api-key':apiKey,'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},
      body:JSON.stringify({
        model:'claude-sonnet-4-6',max_tokens:1000,
        mcp_servers:[{type:'url',url:'https://drivemcp.googleapis.com/mcp/v1',name:'google-drive'}],
        messages:[{role:'user',content:`Create a new file in Google Drive named "${fileName}" with mimeType "text/html". Content:\n${html.slice(0,6000)}`}]
      })
    });
    const data=await resp.json();
    const text=data.content?.map(c=>c.text||'').join(' ')||'';
    if(text.toLowerCase().includes('creat')||text.toLowerCase().includes('upload')||text.toLowerCase().includes('id')){
      showStatus('✓ Saved to Google Drive! Check your Drive root folder.','ok');
    } else {
      showStatus('Drive save uncertain — download instead and upload manually.','err');
    }
  }catch(e){showStatus('Drive connection failed. Download the report and upload to Drive manually.','err');}
  btn.disabled=false;btn.textContent='▲ Save to Google Drive';
}

function showStatus(msg,type){
  const el=document.getElementById('statusMsg');
  el.textContent=msg;
  el.className='status-msg '+(type==='ok'?'st-ok':'st-err');
  el.style.display='block';
  setTimeout(()=>{el.style.display='none';},7000);
}

// ── LISTENERS ──────────────────────────────────────────────────
document.getElementById('tuning').addEventListener('change',()=>{
  if(allEvents.length){const t=document.getElementById('tuning').value,m=parseInt(document.getElementById('maxFret').value);buildFingeringData(t,m);renderView(t,m);}
});
document.getElementById('maxFret').addEventListener('change',()=>{
  if(allEvents.length){const t=document.getElementById('tuning').value,m=parseInt(document.getElementById('maxFret').value);buildFingeringData(t,m);renderView(t,m);}
});
document.getElementById('npl').addEventListener('change',()=>{
  if(allEvents.length)renderTab(getFiltered(),document.getElementById('tuning').value,parseInt(document.getElementById('maxFret').value));
});
</script>


</body></html>
