---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import BrandBanner from '~/components/widgets/BrandBanner.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { Icon } from 'astro-icon/components';
import { headerData, DISCORD_INVITE_URL } from '~/navigation';
import { setNewsletterSubscription } from '~/lib/newsletter';

// Guaranteed non-null here — src/middleware.ts redirects unauthenticated
// requests to /login before this page ever renders.
const { user, supabase } = Astro.locals;

const { data: profile } = await supabase
  .from('profiles')
  .select('membership_tier, newsletter_opt_in, newsletter_synced_at')
  .eq('id', user!.id)
  .single();

const newsletterOptIn = profile?.newsletter_opt_in === true;

// One-time hand-off of the signup form's newsletter checkbox to MailerLite. It
// happens here (the first page a confirmed user reaches) rather than at signup
// so nobody can subscribe an address they haven't proven they own. A failure
// leaves newsletter_synced_at empty, so the next visit simply tries again.
if (newsletterOptIn && !profile?.newsletter_synced_at && user!.email) {
  try {
    await setNewsletterSubscription(user!.id, user!.email, true, { explicit: false });
  } catch (err) {
    console.error('Newsletter signup sync failed', err);
  }
}

const isPaid = profile?.membership_tier === 'paid';
const checkoutState = Astro.url.searchParams.get('checkout');
const passwordUpdated = Astro.url.searchParams.get('notice') === 'password_updated';

const metadata = {
  title: 'My Account — Technically Creative LLC',
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header links={headerData.links} isSticky showToggleTheme />
  </Fragment>
  <BrandBanner />

  <div class="container pt-10 pb-2 md:pt-14">
    <h1 class="text-3xl font-bold tracking-tight md:text-4xl">My Account</h1>
    <p class="mt-3 max-w-2xl text-muted dark:text-slate-400">{user!.email}</p>
  </div>

  <WidgetWrapper containerClass="max-w-md mx-auto py-4 md:py-8">
    {
      passwordUpdated && (
        <div class="mb-4 rounded-lg bg-emerald-500/10 px-4 py-3 text-sm text-emerald-600">
          Your password has been updated.
        </div>
      )
    }
    {
      checkoutState === 'success' && (
        <div class="mb-4 rounded-lg bg-emerald-500/10 px-4 py-3 text-sm text-emerald-600">
          You're upgraded! It may take a moment for your status below to update.
        </div>
      )
    }
    {
      checkoutState === 'cancelled' && (
        <div class="mb-4 rounded-lg bg-slate-500/10 px-4 py-3 text-sm text-slate-600 dark:text-slate-400">
          Checkout was cancelled — no charge was made.
        </div>
      )
    }

    <div class="rounded-2xl border border-primary/30 bg-white/70 p-6 dark:bg-slate-900/40">
      <div class="flex items-center justify-between gap-2">
        <span class="font-semibold text-slate-900 dark:text-white">Membership</span>
        <span
          class:list={[
            'shrink-0 rounded-full px-3 py-1 text-xs font-bold',
            isPaid
              ? 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400'
              : 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300',
          ]}
        >
          {isPaid ? 'Paid' : 'Free'}
        </span>
      </div>

      {
        isPaid ? (
          <button
            id="manage-billing-btn"
            class="mt-5 flex w-full items-center justify-center gap-1.5 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-primary/90"
          >
            <Icon name="tabler:credit-card" class="h-4 w-4" /> Manage billing
          </button>
        ) : (
          <button
            id="upgrade-btn"
            class="mt-5 flex w-full items-center justify-center gap-1.5 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-primary/90"
          >
            <Icon name="tabler:star" class="h-4 w-4" /> Upgrade to paid membership
          </button>
        )
      }
      <p id="stripe-action-error" class="mt-3 hidden text-sm text-rose-600"></p>

      {
        isPaid && (
          <a
            href="/account/midi-to-tab-saves"
            class="mt-3 flex w-full items-center justify-center gap-1.5 rounded-lg border border-gray-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-gray-50 dark:border-gray-700 dark:text-slate-300 dark:hover:bg-slate-800"
          >
            <Icon name="tabler:music" class="h-4 w-4" /> View Midi to Tab saves
          </a>
        )
      }

      {
        isPaid && (
          <a
            href={DISCORD_INVITE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 flex w-full items-center justify-center gap-1.5 rounded-lg border border-gray-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-gray-50 dark:border-gray-700 dark:text-slate-300 dark:hover:bg-slate-800"
          >
            <Icon name="tabler:brand-discord" class="h-4 w-4" /> Join the Discord
          </a>
        )
      }

      <div class="mt-5 border-t border-gray-200 pt-4 dark:border-gray-700">
        <label class="flex cursor-pointer items-start gap-2.5 text-sm text-slate-700 dark:text-slate-300">
          <input
            id="newsletter-toggle"
            type="checkbox"
            checked={newsletterOptIn}
            class="mt-0.5 h-4 w-4 shrink-0 rounded border-gray-300 text-primary focus:ring-primary disabled:opacity-60"
          />
          <span>
            <span class="font-semibold text-slate-900 dark:text-white">Newsletter</span><br />
            Tips, tools and updates from Technically Creative. Untick to unsubscribe.
          </span>
        </label>
        <p id="newsletter-status" class="mt-2 hidden text-sm"></p>
      </div>

      <form method="POST" action="/api/auth/logout" class="mt-4">
        <button
          type="submit"
          class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-gray-50 dark:border-gray-700 dark:text-slate-300 dark:hover:bg-slate-800"
        >
          Log out
        </button>
      </form>
    </div>
  </WidgetWrapper>
</Layout>

<script>
  async function goToStripe(endpoint: string, button: HTMLButtonElement) {
    const errorEl = document.getElementById('stripe-action-error') as HTMLParagraphElement;
    errorEl.classList.add('hidden');
    button.disabled = true;

    try {
      const res = await fetch(endpoint, { method: 'POST' });
      const data = await res.json();

      if (!res.ok || !data.url) {
        throw new Error(data.error ?? 'Something went wrong');
      }

      window.location.href = data.url;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : 'Something went wrong';
      errorEl.classList.remove('hidden');
      button.disabled = false;
    }
  }

  const newsletterToggle = document.getElementById('newsletter-toggle') as HTMLInputElement;
  const newsletterStatus = document.getElementById('newsletter-status') as HTMLParagraphElement;

  newsletterToggle.addEventListener('change', async () => {
    const subscribed = newsletterToggle.checked;
    newsletterToggle.disabled = true;
    newsletterStatus.classList.add('hidden');

    try {
      const res = await fetch('/api/newsletter/preference', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ subscribed }),
      });
      const data = await res.json().catch(() => ({}));

      if (!res.ok) {
        throw new Error(data.error ?? 'Something went wrong');
      }

      newsletterStatus.textContent = subscribed ? "You're subscribed." : "You've been unsubscribed.";
      newsletterStatus.className = 'mt-2 text-sm text-emerald-600';
    } catch (err) {
      // Put the box back so it always reflects what's actually saved.
      newsletterToggle.checked = !subscribed;
      newsletterStatus.textContent = err instanceof Error ? err.message : 'Something went wrong';
      newsletterStatus.className = 'mt-2 text-sm text-rose-600';
    } finally {
      newsletterToggle.disabled = false;
    }
  });

  document.getElementById('upgrade-btn')?.addEventListener('click', (e) => {
    goToStripe('/api/stripe/create-checkout-session', e.currentTarget as HTMLButtonElement);
  });

  document.getElementById('manage-billing-btn')?.addEventListener('click', (e) => {
    goToStripe('/api/stripe/create-portal-session', e.currentTarget as HTMLButtonElement);
  });
</script>
