---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Services - Technically Creative',
  ignoreTitleTemplate: true,
};

const links = [
  { text: 'Home', href: '/' },
  { text: 'Services', href: '/services' },
  { text: 'About', href: '/about' },
  { text: 'Credentials', href: '/credentials' },
  { text: 'Contact', href: '/contact' },
];
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header links={links} isSticky showToggleTheme />
  </Fragment>

  <!-- Hero -->
  <Hero
    id="hero"
    title="Services"
    tagline="From sound to systems"
    actions={[{ variant: 'primary', text: 'Contact', href: '/contact' }]}
  >
    <Fragment slot="subtitle">
      I combine creative audio work with structured consulting so you get clarity, quality, and reliable delivery.
    </Fragment>
  </Hero>

  <!-- Service Offerings -->
  <Features
    id="services"
    tagline="What I offer"
    items={[
      {
        title: 'Mixing & Mastering',
        description:
          'Your tracks, polished and powerful. Singles start at $249 per song with EP and album bundles plus unlimited mix notes for 10 days.',
        icon: 'tabler:adjustments',
        callToAction: { text: 'Mixing workflow', href: '/services/mixing-mastering' },
      },
      {
        title: 'Sound Design & Foley',
        description:
          'Custom audio textures for games, film, and trailers. Project bundles start at $350 with delivery-ready stems and alternate mixes.',
        icon: 'tabler:speakerphone',
        callToAction: { text: 'Sound design process', href: '/services/sound-design-foley' },
      },
      {
        title: 'Music Technology Consulting',
        description:
          'Studio audits, systems guidance, and creative coaching subscriptions (two or four sessions monthly) starting at $350 per month.',
        icon: 'tabler:music',
        callToAction: { text: 'Consulting details', href: '/services/music-technology-consulting' },
      },
      {
        title: 'Project Management Consulting',
        description:
          'Campaign planning, risk mapping, and stakeholder reporting. Retainers start at $95 per hour with sprint or launch packages.',
        icon: 'tabler:briefcase',
        callToAction: { text: 'Delivery playbook', href: '/services/project-management-consulting' },
      },
      {
        title: 'Workflow Automation for Creatives',
        description:
          'ClickUp, Airtable, and n8n automation builds that reduce admin churn. Discovery-to-build roadmaps from $600.',
        icon: 'tabler:settings-automation',
        callToAction: { text: 'Automation roadmap', href: '/services/workflow-automation' },
      },
      {
        title: 'Public Speaking Workshops',
        description:
          'Keynotes and interactive workshops on creative discipline, delivery, and emerging audio tech. Sessions begin at $750.',
        icon: 'tabler:microphone',
        callToAction: { text: 'Workshop formats', href: '/services/public-speaking-workshops' },
      },
    ]}
  />

  <!-- Process -->
  <Content
    id="process"
    title="How I work"
    subtitle="Clear, pragmatic steps from idea to delivery"
    items={[
      {
        title: 'Discover',
        description: 'We align on your goals, audience, and success metrics so every feature has a purpose.',
      },
      { title: 'Build', description: 'Incremental delivery with previews before anything ships to production.' },
      {
        title: 'Care',
        description: 'After launch, I monitor performance, train your team, and provide regular updates.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581091215367-59ab6c43a8b0?q=80&w=1600&auto=format&fit=crop',
      alt: 'Workflow',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-sky-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- CTA -->
  <CallToAction
    title="Ready to start?"
    subtitle="Let's match the right service to your goals."
    actions={[{ variant: 'primary', text: 'Get in touch', href: '/contact' }]}
  />
</Layout>
