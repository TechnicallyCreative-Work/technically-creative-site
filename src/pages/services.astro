---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';

import BrandBanner from '~/components/widgets/BrandBanner.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import CategoryGrid from '~/components/ui/CategoryGrid.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { headerData } from '~/navigation';
import { serviceOfferings } from '~/data/serviceOfferings';
import workflowImage from '~/assets/images/verticalcool.jpg';

const metadata = {
  title: 'Services - Technically Creative',
  description:
    'Creative audio, project leadership, automation, and workshops built for artists, agencies, and in-house teams that need reliable delivery.',
  openGraph: {
    title: 'Creative services for teams that ship on time',
    description:
      'Explore mixing, sound design, project management, automation, and workshop offerings tailored to your deadlines.',
  },
  ignoreTitleTemplate: true,
};

const links = headerData.links;

const offerings = serviceOfferings.map(({ slug, title, description, meta, logo, accent }) => ({
  title,
  description,
  href: `/services/${slug}`,
  logo,
  accent,
  meta,
}));
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header links={links} isSticky showToggleTheme />
  </Fragment>

  <BrandBanner />

  <div class="container pt-10 pb-2 md:pt-14">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl md:text-4xl">Services — Indianapolis Music Production, Project Management &amp; Automation</h1>
    <p class="mt-3 max-w-2xl text-muted dark:text-slate-400">Creative delivery without the chaos.</p>
  </div>

  <!-- Service Offerings -->
  <WidgetWrapper id="services" containerClass="max-w-6xl mx-auto">
    <Headline tagline="What I offer" title="Service Offerings" />
    <CategoryGrid items={offerings} />
  </WidgetWrapper>

  <!-- Process -->
  <Content
    id="process"
    title="How I work"
    subtitle="Clear, pragmatic steps from idea to delivery"
    items={[
      {
        title: 'Discover',
        description: 'Align on audience, success metrics, and constraints so every deliverable has a measurable goal.',
      },
      { title: 'Build', description: 'Iterate in organized sprints with previews and check-ins before anything ships.' },
      {
        title: 'Care',
        description: 'Post-launch monitoring, training, and documentation keep the work maintainable for your team.',
      },
    ]}
    image={{
      src: workflowImage,
      width: workflowImage.width,
      height: workflowImage.height,
      alt: 'Workflow',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-sky-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- CTA -->
  <CallToAction
    title="Ready to start?"
    subtitle="Share your goals, timeline, and audience so I can outline the right engagement."
    actions={[{ variant: 'primary', text: 'Get in touch', href: '/contact#form' }]}
  />
</Layout>
