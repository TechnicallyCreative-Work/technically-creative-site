---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';

import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { headerData } from '~/navigation';
import workflowImage from '~/assets/images/verticalcool.jpg';

const metadata = {
  title: 'Services - Technically Creative',
  description:
    'Creative audio, project leadership, automation, and workshops built for artists, agencies, and in-house teams that need reliable delivery.',
  openGraph: {
    title: 'Creative services for teams that ship on time',
    description:
      'Explore mixing, sound design, project management, automation, and workshop offerings tailored to your deadlines.',
  },
  ignoreTitleTemplate: true,
};

const links = headerData.links;
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header links={links} isSticky showToggleTheme />
  </Fragment>

  <!-- Service Offerings -->
  <Features
    id="services"
    tagline="What I offer"
    items={[
      {
        title: 'Mixing & Mastering',
        description:
          'Singles start at $249 with EP and album bundles. Expect organized sessions, a detailed mix report, and unlimited notes for 10 days.',
        icon: 'tabler:adjustments',
        callToAction: { text: 'Mixing workflow', href: '/services/mixing-mastering' },
      },
      {
        title: 'Sound Design & Foley',
        description:
          'Custom audio textures for games, film, and trailers. Project bundles start at $350 with delivery-ready stems and alternate mixes.',
        icon: 'tabler:speakerphone',
        callToAction: { text: 'Sound design process', href: '/services/sound-design-foley' },
      },
      {
        title: 'Music Technology Consulting',
        description:
          'Studio audits, systems roadmaps, and coaching subscriptions start at $350 per month with async support between sessions.',
        icon: 'tabler:music',
        callToAction: { text: 'Consulting details', href: '/services/music-technology-consulting' },
      },
      {
        title: 'Project Management Consulting',
        description:
          'Sprint planning intensives from $680, launch management packages, and fractional retainers for ongoing oversight.',
        icon: 'tabler:briefcase',
        callToAction: { text: 'Delivery playbook', href: '/services/project-management-consulting' },
      },
      {
        title: 'Workflow Automation for Creatives',
        description:
          'ClickUp, Airtable, and n8n builds that automate intake, approvals, and reporting. Discovery-to-build roadmaps start at $600.',
        icon: 'tabler:settings-automation',
        callToAction: { text: 'Automation roadmap', href: '/services/workflow-automation' },
      },
      {
        title: 'Public Speaking Workshops',
        description:
          'Keynotes and interactive workshops on creative discipline, delivery, and emerging audio tech. Sessions begin at $750.',
        icon: 'tabler:microphone',
        callToAction: { text: 'Workshop formats', href: '/services/public-speaking-workshops' },
      },
    ]}
  />

  <!-- Process -->
  <Content
    id="process"
    title="How I work"
    subtitle="Clear, pragmatic steps from idea to delivery"
    items={[
      {
        title: 'Discover',
        description: 'Align on audience, success metrics, and constraints so every deliverable has a measurable goal.',
      },
      { title: 'Build', description: 'Iterate in organized sprints with previews and check-ins before anything ships.' },
      {
        title: 'Care',
        description: 'Post-launch monitoring, training, and documentation keep the work maintainable for your team.',
      },
    ]}
    image={{
      src: workflowImage,
      width: workflowImage.width,
      height: workflowImage.height,
      alt: 'Workflow',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-sky-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- CTA -->
  <CallToAction
    title="Ready to start?"
    subtitle="Share your goals, timeline, and audience so I can outline the right engagement."
    actions={[{ variant: 'primary', text: 'Get in touch', href: '/contact#form' }]}
  />
</Layout>
