---
import SectionPage from '~/layouts/SectionPage.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';
import { getImage } from 'astro:assets';

import storeXenomorph from '~/assets/images/store-xenomorph.png';
import storeHorrorOwl from '~/assets/images/store-horrorowl.png';
import storeDredd from '~/assets/images/store-dredd.png';
import gXenoMaster from '~/assets/images/gallery-xeno-master.png';
import gXenoMaster2 from '~/assets/images/gallery-xeno-master2.png';

const [xenoPreview, owlPreview, dreddPreview] = await Promise.all([
  getImage({ src: storeXenomorph, width: 700, format: 'webp', quality: 72 }),
  getImage({ src: storeHorrorOwl, width: 700, format: 'webp', quality: 72 }),
  getImage({ src: storeDredd, width: 700, format: 'webp', quality: 72 }),
]);

const galleries: Record<string, { src: string; alt: string }[]> = {
  'dark-art': [
    { src: storeXenomorph.src, alt: 'XENOMORPH dark sci-fi print' },
    { src: gXenoMaster.src, alt: 'XENOMORPH master print' },
    { src: gXenoMaster2.src, alt: 'XENOMORPH master print variant' },
    { src: storeDredd.src, alt: 'Dredd fan art print' },
    { src: storeHorrorOwl.src, alt: "Hoo's Watching biomechanical owl" },
  ],
};

const darkArt = [
  { slug: 'xeno',       name: 'XENOMORPH',      price: '$7+',  desc: 'Dark Sci-Fi Study — digital print',                  imgSrc: xenoPreview.src },
  { slug: 'bloodskull', name: 'BloodSkull',      price: '$10+', desc: 'Digital print',                                      imgSrc: null },
  { slug: 'DREDD-Dark', name: 'Dredd',           price: '$5+',  desc: 'Dark Sci-Fi Fan Art — digital print',                imgSrc: dreddPreview.src },
  { slug: 'CyberOwl',   name: "Hoo's Watching",  price: '$7+',  desc: 'Biomechanical Owl — Ink & Watercolor Digital Print', imgSrc: owlPreview.src },
];
const metadata = {
  title: 'Digital Art — Dark & Fan Art — Technically Creative LLC',
  description: 'Original and fan art digital prints — dark sci-fi, biomechanical, and ink & watercolor works on Gumroad.',
};
---

<SectionPage
  metadata={metadata}
  ctaTitle="Need something custom instead?"
  ctaSubtitle="Custom commissions, graphic design, and local/on-site work are booked through Local Services."
  ctaActions={[{ variant: 'primary', text: 'View Local Services', href: getPermalink('/local-services') }]}
>
  <WidgetWrapper id="dark-art" containerClass="max-w-6xl mx-auto py-12 md:py-16">
    <a href="/products" class="mb-5 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline">
      <Icon name="tabler:arrow-left" class="h-4 w-4" /> All products
    </a>
    <div class="flex items-center gap-3 text-primary">
      <Icon name="tabler:skull" class="h-7 w-7" />
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">Digital Art — Dark & Fan Art</h1>
    </div>
    <p class="mt-2 max-w-2xl text-muted dark:text-slate-300">Original and fan art digital prints — dark sci-fi, biomechanical, and ink & watercolor works.</p>

    {galleries['dark-art'].length > 0 && (
      <div class="mt-6 flex gap-3 overflow-x-auto pb-2">
        {galleries['dark-art'].map(({ src, alt }) => (
          <div class="shrink-0 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
            <img src={src} alt={alt} class="h-44 w-auto object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    )}

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {darkArt.map(({ slug, name, price, desc, imgSrc }) => (
        <a
          href={`https://techcre8.gumroad.com/l/${slug}`}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col overflow-hidden rounded-2xl border border-dashed border-primary/30 bg-white/70 transition hover:border-primary/60 hover:shadow-md dark:bg-slate-900/40"
        >
          {imgSrc ? (
            <img src={imgSrc} alt={name} class="h-44 w-full object-cover pointer-events-none select-none" draggable="false" />
          ) : (
            <div class="flex h-44 w-full items-center justify-center bg-slate-100 text-xs text-slate-400 dark:bg-slate-800">
              Image coming soon
            </div>
          )}
          <div class="flex flex-col p-4">
            <div class="flex items-start justify-between gap-2">
              <span class="font-semibold text-slate-900 dark:text-white">{name}</span>
              <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300">{price}</span>
            </div>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{desc}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-primary group-hover:underline">
              Get on Gumroad <Icon name="tabler:external-link" class="h-3.5 w-3.5" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </WidgetWrapper>
</SectionPage>
