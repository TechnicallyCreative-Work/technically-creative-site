---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';

import Hero from '~/components/widgets/Hero.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Button from '~/components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import heroBackground from '~/assets/images/wbckgroundtemp.jpg';
import { getPermalink } from '~/utils/permalinks';
import { headerData } from '~/navigation';

const metadata = {
  title: 'Portfolio - Technically Creative LLC',
  description: 'Selected audio, sound design, and project management work from Technically Creative LLC.',
};

const links = [...headerData.links, { text: 'Portfolio', href: '/portfolio' }];

const categories = [
  {
    id: 'music-technology',
    title: 'Music Technology',
    icon: 'tabler:cpu',
    description:
      'Max patches, hybrid DAW templates, and automation systems that blend art with reliable delivery.',
    serviceHref: '/services/music-technology-consulting',
    projects: [
      {
        title: 'Creature – Max Patch Demo',
        summary:
          'Placeholder walk-through of a generative Max for Live patch used in Creature. Final capture with annotations coming soon.',
        media: {
          type: 'youtube',
          src: 'https://www.youtube-nocookie.com/embed/ScMzIvxBSi4',
        },
      },
      {
        title: 'Automation Toolkit Sneak Peek',
        summary:
          'Preview of a hybrid Ableton/ClickUp workflow where MIDI scenes trigger documentation, assets, and briefs automatically.',
        media: {
          type: 'image',
          src: 'https://images.unsplash.com/photo-1580894906472-4d1dcafc1041?auto=format&fit=crop&w=980&q=80',
          alt: 'Automation dashboard placeholder',
        },
      },
    ],
  },
  {
    id: 'sound-design-foley',
    title: 'Sound Design & Foley',
    icon: 'tabler:speakerphone',
    description: 'Trailer, film, and interactive soundscapes with practical and synthetic Foley layers.',
    serviceHref: '/services/sound-design-foley',
    projects: [
      {
        title: 'Trailer Sound Design – Placeholder Cut',
        summary:
          'Upcoming cinematic trailer edit featuring original impacts, risers, and atmosphere design. Replacing with the final embed soon.',
        media: {
          type: 'youtube',
          src: 'https://www.youtube-nocookie.com/embed/g_iGfejNiSA',
        },
      },
      {
        title: 'Creature Atmospheres',
        summary:
          'Audio-only demo of layered ambiences and creature vocals. This player will be swapped with the final rendered stems.',
        media: {
          type: 'soundcloud',
          src: 'https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/347928555&color=%23ff5500&auto_play=false&hide_related=false&show_comments=false&show_user=false&show_reposts=false&show_teaser=false&visual=true',
        },
      },
    ],
  },
  {
    id: 'project-management-automation-ai',
    title: 'Project Management, Automation & AI',
    icon: 'tabler:robot',
    description:
      'Roadmaps, reporting, and AI-assisted automations that keep creative work shipping without chaos.',
    serviceHref: '/services/workflow-automation',
    projects: [
      {
        title: 'Launch Command Center',
        summary:
          'Placeholder overview of a ClickUp + AI status assistant generating daily stakeholder briefs.',
        media: {
          type: 'image',
          src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?auto=format&fit=crop&w=980&q=80',
          alt: 'Automation dashboard placeholder',
        },
      },
      {
        title: 'Risk Signals Prototype',
        summary:
          'Placeholder demo where AI surfaces risk from meeting transcripts and routes follow-ups automatically.',
        media: {
          type: 'youtube',
          src: 'https://www.youtube-nocookie.com/embed/7z41UJqyl8s',
        },
      },
    ],
  },
  {
    id: 'music-production',
    title: 'Music Production',
    icon: 'tabler:music',
    description: 'Full-cycle production—songwriting, arrangement, vocal tracking, edit, and mix/playback delivery.',
    serviceHref: '/services/mixing-mastering',
    projects: [
      {
        title: 'RVXX – Music Video Production',
        summary:
          'Complete production pipeline: concept, songwriting, session players, video direction, and post. Final cut replaces this placeholder clip.',
        media: {
          type: 'youtube',
          src: 'https://www.youtube-nocookie.com/embed/OmkPsz1SsZI',
        },
      },
      {
        title: 'Production Reel – In Progress',
        summary:
          'SoundCloud placeholder that will become a stitched reel of recent mixes, masters, and custom instrumentals.',
        media: {
          type: 'soundcloud',
          src: 'https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/135373503&color=%23ff5500&auto_play=false&hide_related=false&show_comments=false&show_user=false&show_reposts=false&show_teaser=false&visual=true',
        },
      },
    ],
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header
      links={links}
      actions={[{ text: 'Hire me', href: getPermalink('/contact#form') }]}
      isSticky
      showToggleTheme
    />
  </Fragment>
  <Hero
    tagline="Portfolio"
    title="Service-Aligned Work"
    backgroundImage={heroBackground.src}
    backgroundOverlayClass="bg-slate-900/70"
    actions={[{ variant: 'primary', text: 'Start a project', href: getPermalink('/contact#form') }]}
  >
    <Fragment slot="subtitle">
      Each section below mirrors a core service. As new projects launch, I’ll slot in case studies, stems, and behind-the-scenes workflows for that service family.
    </Fragment>
  </Hero>

  {categories.map(({ id, title, description, icon, serviceHref, projects }) => (
    <WidgetWrapper id={id} containerClass="max-w-6xl mx-auto py-12 md:py-16">
      <div class="flex items-center gap-3 text-primary">
        <Icon name={icon} class="h-8 w-8" />
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
          {title}
        </h2>
      </div>
      <p class="mt-3 max-w-3xl text-lg text-muted dark:text-slate-300">{description}</p>

      <div class="mt-8 flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4 md:grid md:grid-cols-2 md:gap-6 md:overflow-visible md:pb-0">
        {projects.map(({ title: projectTitle, summary, media }, index) => (
          <article class="min-w-[280px] snap-center rounded-2xl border border-dashed border-primary/30 bg-white/70 px-6 py-8 shadow-sm transition hover:border-primary/60 dark:bg-slate-900/40 md:min-w-0">
            <div class="text-sm font-semibold uppercase tracking-wider text-primary">
              Placeholder #{index + 1}
            </div>
            <h3 class="mt-3 text-xl font-semibold text-slate-900 dark:text-white">{projectTitle}</h3>
            <p class="mt-2 text-muted dark:text-slate-400">{summary}</p>

            {
              media?.type === 'youtube' && (
                <div class="mt-4 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
                  <iframe
                    class="h-48 w-full"
                    src={media.src}
                    title={`${projectTitle} video placeholder`}
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                  ></iframe>
                </div>
              )
            }
            {
              media?.type === 'soundcloud' && (
                <div class="mt-4 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
                  <iframe
                    class="h-44 w-full"
                    scrolling="no"
                    frameborder="no"
                    allow="autoplay"
                    src={media.src}
                    title={`${projectTitle} audio placeholder`}
                  ></iframe>
                </div>
              )
            }
            {
              media?.type === 'image' && (
                <div class="mt-4 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
                  <img class="h-48 w-full object-cover" src={media.src} alt={media.alt ?? projectTitle} />
                </div>
              )
            }

            <span class="mt-4 inline-flex items-center text-xs font-semibold uppercase tracking-wider text-primary">
              Case study coming soon
            </span>
          </article>
        ))}
      </div>

      <div class="mt-6">
        <Button variant="link" href={getPermalink(serviceHref)} icon="tabler:arrow-right" text="View matching service" />
      </div>
    </WidgetWrapper>
  ))}

  <CallToAction
    title="Have a project in mind?"
    subtitle="Tell me what you need—mixing, sound design, workflow cleanup—and I'll reply within one business day."
    actions={[{ variant: 'primary', text: 'Start a project', href: getPermalink('/contact#form') }]}
  />
</Layout>
