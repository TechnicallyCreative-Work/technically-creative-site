---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';

import Hero from '~/components/widgets/Hero.astro';
import BrandBanner from '~/components/widgets/BrandBanner.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Button from '~/components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';
import { headerData } from '~/navigation';

const metadata = {
  title: 'Portfolio - Technically Creative LLC',
  description: 'Selected audio, sound design, and project management work from Technically Creative LLC.',
};

const links = [...headerData.links, { text: 'Portfolio', href: '/portfolio' }];

const categories = [
  {
    id: 'music-technology',
    title: 'Music Technology',
    icon: 'tabler:cpu',
    description:
      'Max patches, hybrid DAW templates, and automation systems that blend art with reliable delivery.',
    serviceHref: '/services/music-technology-consulting',
    projects: [
      {
        label: 'Max for Live Instrument',
        title: 'Chiptune Instrument Demo',
        summary:
          'Walkthrough of a retro-inspired Max instrument with wavetable morphing, onboard FX, and automation-ready macros.',
        media: {
          type: 'youtube',
          src: 'https://www.youtube-nocookie.com/embed/ScMzIvxBSi4',
        },
      },
      {
        label: 'Workflow Automation System',
        title: 'Voice-to-Log Mix Notes',
        summary:
          'Live demo: voice memos from Telegram funnel into n8n, transcribe via AI, and land in a Google Sheet that a bot can search for mix notes and lessons learned.',
        media: {
          type: 'image',
          src: 'https://images.unsplash.com/photo-1591696205602-2f950c417cb9?auto=format&fit=crop&w=980&q=80',
          alt: 'Automation workflow diagram',
        },
      },
    ],
  },
  {
    id: 'sound-design-foley',
    title: 'Sound Design & Foley',
    icon: 'tabler:speakerphone',
    description: 'Trailer, film, and interactive soundscapes with practical and synthetic Foley layers.',
    serviceHref: '/services/sound-design-foley',
    projects: [
      {
        label: 'Trailer Sound Design',
        title: 'Trailer Sound Design',
        summary:
          'Cinematic trailer mix with custom-designed impacts, risers, and atmospheres layered from my foley library.',
        media: {
          type: 'youtube',
          src: 'https://www.youtube-nocookie.com/embed/7z41UJqyl8s',
        },
      },
      {
        label: 'Animation Sound Design',
        title: 'Animated Short Audio Pass',
        summary:
          'Episode samples from a short animation series where I built SFX layers, ambiences, and final mix.',
        media: {
          type: 'youtube',
          src: 'https://www.youtube-nocookie.com/embed/videoseries?list=PLFNDDJOPd_iqjxRyrHJKl8duLPOXCq8cN',
        },
      },
    ],
  },
  {
    id: 'project-management-automation-ai',
    title: 'Project Management, Automation & AI',
    icon: 'tabler:robot',
    description:
      'Roadmaps, reporting, and AI-assisted automations that keep creative work shipping without chaos.',
    serviceHref: '/services/workflow-automation',
    projects: [
      {
        label: 'Project Automation',
        title: 'ClickUp + n8n Activity Logger',
        summary:
          'Shows how every ClickUp task update flows through n8n into a structured database so retrospectives and lessons learned stay searchable.',
        media: {
          type: 'image',
          src: 'https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=980&q=80',
          alt: 'Team reviewing automation dashboard on laptops',
        },
      },
      {
        label: 'Content Automation',
        title: 'LinkedIn Posting Pipeline',
        summary:
          'Gemini and ChatGPT run engineered prompts to draft and stage LinkedIn content; I keep a human in the loop for final polish and manual posting so quality stays tight.',
        media: {
          type: 'image',
          src: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=980&q=80',
          alt: 'Automation interface preparing social media posts',
        },
      },
    ],
  },
  {
    id: 'music-production',
    title: 'Music Production',
    icon: 'tabler:music',
    description: 'Full-cycle production—songwriting, arrangement, vocal tracking, edit, and mix/playback delivery.',
    serviceHref: '/services/mixing-mastering',
    projects: [
      {
        label: 'Video',
        title: 'Music Videos',
        summary:
          'Selected live-action videos where I handled pre-production, on-set audio direction, and post-production mix.',
        media: {
          type: 'youtube',
          src: 'https://www.youtube-nocookie.com/embed/p-D9LjF1XJY',
        },
      },
      {
        label: 'Audio',
        title: 'Audio Production',
        summary:
          'Stream the Argent Eruption project directly—produced, mixed, and mastered for RVXX.',
        media: {
          type: 'raw',
          html: `<iframe width="100%" height="450" scrolling="no" frameborder="no" allow="autoplay" src="https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/playlists/soundcloud%253Aplaylists%253A2062960161&color=%2314140c&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true"></iframe><div style="font-size: 10px; color: #cccccc; line-break: anywhere; word-break: normal; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-family: Interstate, Lucida Grande, Lucida Sans Unicode, Lucida Sans, Garuda, Verdana, Tahoma, sans-serif; font-weight: 100;"><a href="https://soundcloud.com/rvxx-252541516" title="RVXX" target="_blank" style="color: #cccccc; text-decoration: none;">RVXX</a> - <a href="https://soundcloud.com/rvxx-252541516/sets/argent-eruption" title="Argent Eruption" target="_blank" style="color: #cccccc; text-decoration: none;">Argent Eruption</a></div>`,
        },
      },
    ],
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header
      links={links}
      actions={[{ text: 'Hire me', href: getPermalink('/contact#form') }]}
      isSticky
      showToggleTheme
    />
  </Fragment>
  <BrandBanner />
  <Hero
    tagline="Portfolio"
    title="Service-Aligned Work"
    actions={[{ variant: 'primary', text: 'Start a project', href: getPermalink('/contact#form') }]}
  >
    <Fragment slot="subtitle">
      Each section below mirrors a core service. As new projects launch, I’ll slot in case studies, stems, and behind-the-scenes workflows for that service family.
    </Fragment>
  </Hero>

  {categories.map(({ id, title, description, icon, serviceHref, projects }) => (
    <WidgetWrapper id={id} containerClass="max-w-6xl mx-auto py-12 md:py-16">
      <div class="flex items-center gap-3 text-primary">
        <Icon name={icon} class="h-8 w-8" />
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
          {title}
        </h2>
      </div>
      <p class="mt-3 max-w-3xl text-lg text-muted dark:text-slate-300">{description}</p>

      <div class="mt-8 flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4 md:grid md:grid-cols-2 md:gap-6 md:overflow-visible md:pb-0">
        {projects.map(({ title: projectTitle, summary, media, label }) => (
          <article class="min-w-[280px] snap-center rounded-2xl border border-dashed border-primary/30 bg-white/70 px-6 py-8 shadow-sm transition hover:border-primary/60 dark:bg-slate-900/40 md:min-w-0">
            <div class="text-sm font-semibold uppercase tracking-wider text-primary">
              {label ?? 'Case Study'}
            </div>
            <h3 class="mt-3 text-xl font-semibold text-slate-900 dark:text-white">{projectTitle}</h3>
            <p class="mt-2 text-muted dark:text-slate-400">{summary}</p>

            {
              media?.type === 'youtube' && (
                <div class="mt-4 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
                  <iframe
                    class="h-48 w-full"
                    src={media.src}
                    title={`${projectTitle} video`}
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                  ></iframe>
                </div>
              )
            }
            {
              media?.type === 'soundcloud' && (
                <div class="mt-4 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
                  <iframe
                    class="h-44 w-full"
                    scrolling="no"
                    frameborder="no"
                    allow="autoplay"
                    src={media.src}
                    title={`${projectTitle} audio`}
                  ></iframe>
                </div>
              )
            }
            {
              media?.type === 'image' && (
                <div class="mt-4 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
                  <img class="h-48 w-full object-cover" src={media.src} alt={media.alt ?? projectTitle} />
                </div>
              )
            }
            {
              media?.type === 'raw' && (
                <div class="mt-4 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
                  <Fragment set:html={media.html} />
                </div>
              )
            }
          </article>
        ))}
      </div>

      <div class="mt-6">
        <Button variant="link" href={getPermalink(serviceHref)} icon="tabler:arrow-right" text="View matching service" />
      </div>
    </WidgetWrapper>
  ))}

  <CallToAction
    title="Have a project in mind?"
    subtitle="Tell me what you need—mixing, sound design, workflow cleanup—and I'll reply within one business day."
    actions={[{ variant: 'primary', text: 'Start a project', href: getPermalink('/contact#form') }]}
  />
</Layout>
