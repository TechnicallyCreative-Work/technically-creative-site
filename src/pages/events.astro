---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import BrandBanner from '~/components/widgets/BrandBanner.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';
import { headerData } from '~/navigation';

const metadata = {
  title: 'Shows & Events — Technically Creative LLC',
  description:
    'Upcoming Indianapolis-area live shows and music tech events, reviewed and posted by Technically Creative. Hosting something? Submit it.',
};

// Public JSON feed (n8n "Show Calendar API"): published shows and events from the
// Noise Floor list in ClickUp. See src/pages/events.astro <script> for the shape.
const FEED_URL = 'https://technicallycreative.app.n8n.cloud/webhook/show-calendar';

// Public ClickUp intake form. Flip FORM_ACTIVE to true once the form is switched
// on in ClickUp; until then the page sends people to the contact form instead of
// embedding a dead form.
const SUBMIT_FORM_URL = 'https://forms.clickup.com/90131588401/f/2ky45t9h-17733/HHCCE2U6ZDK7DQSUZR';
const FORM_ACTIVE = false;
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header
      links={headerData.links}
      actions={[{ text: 'Hire me', href: getPermalink('/contact#form') }]}
      isSticky
      showToggleTheme
    />
  </Fragment>
  <BrandBanner />

  <div class="container pt-10 pb-2 md:pt-14">
    <p class="font-bold uppercase tracking-wide text-secondary">Noise Floor</p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl md:text-4xl">Shows &amp; Events</h1>
    <p class="mt-3 max-w-2xl text-muted dark:text-slate-400">
      Live music and music tech events around Indianapolis, reviewed before they land here. Hosting or playing
      something? Send it in at least 72 hours ahead.
    </p>
  </div>

  <WidgetWrapper id="events" containerClass="max-w-4xl mx-auto py-4 md:py-8">
    <div id="events-filters" class="mb-6 flex flex-wrap gap-2" role="group" aria-label="Filter by type" hidden>
      <button type="button" data-filter="all" class="event-chip is-active">All</button>
      <button type="button" data-filter="Live Show" class="event-chip">Live shows</button>
      <button type="button" data-filter="Music Tech Event" class="event-chip">Music tech events</button>
    </div>

    <div id="events-status" class="rounded-2xl p-6 text-center tc-well text-muted dark:text-slate-400" role="status">
      Loading events…
    </div>
    <div id="events-list" class="space-y-8" hidden></div>

    <template id="event-tpl">
      <article class="tc-card flex flex-col gap-4 rounded-2xl p-5 sm:flex-row">
        <div class="w-16 shrink-0 text-center">
          <div class="ev-mon text-xs font-bold uppercase tracking-wide text-secondary"></div>
          <div class="ev-day text-3xl font-bold leading-none"></div>
          <div class="ev-dow text-xs text-muted dark:text-slate-400"></div>
        </div>
        <div class="min-w-0 flex-1">
          <p class="ev-type text-xs font-bold uppercase tracking-wide text-primary"></p>
          <h3 class="ev-title mt-0.5 text-lg font-bold"></h3>
          <p class="ev-when mt-1 text-sm font-medium"></p>
          <ul class="ev-chips mt-2 flex flex-wrap gap-2 text-xs"></ul>
          <p class="ev-where mt-2 text-sm text-muted dark:text-slate-400">
            <a class="ev-map hover:underline" target="_blank" rel="noopener noreferrer"></a>
          </p>
          <p class="ev-note mt-2 text-sm text-muted dark:text-slate-400"></p>
          <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-semibold">
            <a
              class="ev-link inline-flex items-center gap-1.5 text-primary hover:underline"
              target="_blank"
              rel="noopener noreferrer"
              hidden
            >
              Details <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
            </a>
            <a class="ev-contact inline-flex items-center gap-1.5 text-primary hover:underline" hidden>
              <Icon name="tabler:mail" class="h-4 w-4" />
              <span>Ask about this event</span>
            </a>
          </div>
        </div>
        <a class="ev-flier block shrink-0 sm:w-28" target="_blank" rel="noopener noreferrer" hidden>
          <img
            class="ev-flier-img w-full rounded-lg border border-slate-200/80 object-cover dark:border-slate-700/60"
            alt=""
            loading="lazy"
          />
          <span class="ev-flier-label mt-1 block text-center text-xs font-semibold text-primary">View flier</span>
        </a>
      </article>
    </template>
  </WidgetWrapper>

  {
    FORM_ACTIVE ? (
      <WidgetWrapper id="submit" containerClass="max-w-4xl mx-auto py-4 md:py-8">
        <h2 class="text-xl font-bold md:text-2xl">Submit a show or event</h2>
        <p class="mt-2 text-sm text-muted dark:text-slate-400">
          Fill in the form below. Everything except your flier file is shown publicly, including the contact email.
        </p>
        <iframe
          class="mt-4 w-full rounded-2xl border border-slate-200/80 dark:border-slate-700/60"
          src={SUBMIT_FORM_URL}
          title="Submit a show or event"
          style="min-height: 1100px;"
          loading="lazy"
        />
        <p class="mt-3 text-sm">
          <a
            class="font-semibold text-primary hover:underline"
            href={SUBMIT_FORM_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open the form in its own tab
          </a>
        </p>
      </WidgetWrapper>
    ) : (
      <CallToAction
        title="Hosting a show or event in Indy?"
        subtitle="Send the details and I will review it for the calendar. Fishers and Carmel are out of scope for now."
        actions={[{ variant: 'primary', text: 'Submit an event', href: getPermalink('/contact#form') }]}
      />
    )
  }

  <style is:global>
    .event-chip {
      border: 1px solid rgb(148 163 184 / 0.6);
      border-radius: 9999px;
      padding: 0.4rem 1rem;
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      transition:
        background-color 0.15s,
        color 0.15s,
        border-color 0.15s;
    }
    .event-chip:hover {
      border-color: rgb(0 200 255);
    }
    .event-chip.is-active {
      background: rgb(0 200 255);
      border-color: rgb(0 200 255);
      color: #fff;
    }
    .ev-chip {
      border: 1px solid rgb(148 163 184 / 0.5);
      border-radius: 9999px;
      padding: 0.15rem 0.6rem;
    }
  </style>

  <script define:vars={{ FEED_URL }}>
    (async () => {
      const status = document.getElementById('events-status');
      const list = document.getElementById('events-list');
      const filters = document.getElementById('events-filters');
      const tpl = document.getElementById('event-tpl');
      const TZ = 'America/Indiana/Indianapolis';
      const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
      const utcNoon = (iso) => new Date(iso + 'T12:00:00Z');
      const fmt = (iso, opts) => utcNoon(iso).toLocaleDateString('en-US', { ...opts, timeZone: 'UTC' });
      const httpsOnly = (u) => (typeof u === 'string' && /^https:\/\//i.test(u) ? u : null);

      const message = (text) => {
        status.textContent = text;
        status.hidden = false;
        list.hidden = true;
        filters.hidden = true;
      };

      const whenText = (ev) => {
        const sameDay = ev.startDate === ev.endDate;
        const startDay = fmt(ev.startDate, { weekday: 'short', month: 'short', day: 'numeric' });
        const endDay = fmt(ev.endDate, { weekday: 'short', month: 'short', day: 'numeric' });
        if (sameDay) {
          if (ev.startTime && ev.endTime && ev.startTime !== ev.endTime)
            return startDay + ', ' + ev.startTime + ' to ' + ev.endTime;
          if (ev.startTime) return startDay + ', ' + ev.startTime;
          return startDay;
        }
        return (
          startDay + (ev.startTime ? ', ' + ev.startTime : '') + ' to ' + endDay + (ev.endTime ? ', ' + ev.endTime : '')
        );
      };

      const card = (ev) => {
        const node = tpl.content.cloneNode(true);
        const q = (s) => node.querySelector(s);
        q('.ev-mon').textContent = fmt(ev.startDate, { month: 'short' });
        q('.ev-day').textContent = String(utcNoon(ev.startDate).getUTCDate());
        q('.ev-dow').textContent = fmt(ev.startDate, { weekday: 'short' });
        q('.ev-type').textContent = ev.type === 'Music Tech Event' ? 'Music tech event' : 'Live show';
        q('.ev-title').textContent = ev.title;
        q('.ev-when').textContent = whenText(ev);

        const chips = q('.ev-chips');
        const addChip = (text) => {
          const li = document.createElement('li');
          li.className = 'ev-chip';
          li.textContent = text;
          chips.appendChild(li);
        };
        if (ev.doors) addChip('Doors ' + ev.doors);
        if (ev.setting) addChip(ev.setting);
        if (ev.parking) addChip(ev.parking === 'Free' ? 'Free parking' : 'Paid parking');
        if (!chips.children.length) chips.remove();

        const where = [ev.address, ev.city].filter(Boolean).join(', ');
        if (where) {
          const a = q('.ev-map');
          a.textContent = where;
          a.href = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(where);
        } else {
          q('.ev-where').remove();
        }

        const note = q('.ev-note');
        if (ev.note) note.textContent = ev.note;
        else note.remove();

        const link = httpsOnly(ev.link);
        if (link) {
          const a = q('.ev-link');
          a.href = link;
          a.hidden = false;
        }
        if (ev.contact && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(ev.contact)) {
          const a = q('.ev-contact');
          a.href = 'mailto:' + ev.contact + '?subject=' + encodeURIComponent('Question about ' + ev.title);
          a.hidden = false;
        }
        const flier = httpsOnly(ev.flier);
        if (flier) {
          const a = q('.ev-flier');
          a.href = flier;
          a.hidden = false;
          const img = q('.ev-flier-img');
          if (/\.pdf(\?|$)/i.test(flier)) {
            img.remove();
          } else {
            img.src = flier;
            img.alt = 'Flier for ' + ev.title;
          }
        } else {
          q('.ev-flier').remove();
        }
        return node;
      };

      let events = [];
      const render = (filter) => {
        list.replaceChildren();
        const shown = events.filter((e) => filter === 'all' || e.type === filter);
        if (shown.length === 0) {
          status.textContent = 'Nothing in this category yet. Check back soon, or submit yours below.';
          status.hidden = false;
          list.hidden = true;
          return;
        }
        const byMonth = new Map();
        for (const ev of shown) {
          const key = ev.startDate.slice(0, 7);
          if (!byMonth.has(key)) byMonth.set(key, []);
          byMonth.get(key).push(ev);
        }
        for (const [key, items] of byMonth) {
          const section = document.createElement('section');
          const h2 = document.createElement('h2');
          h2.className = 'mb-3 text-sm font-bold uppercase tracking-wide text-muted dark:text-slate-400';
          h2.textContent = fmt(key + '-15', { month: 'long', year: 'numeric' });
          const grid = document.createElement('div');
          grid.className = 'space-y-4';
          for (const ev of items) grid.appendChild(card(ev));
          section.append(h2, grid);
          list.appendChild(section);
        }
        status.hidden = true;
        list.hidden = false;
      };

      try {
        const res = await fetch(FEED_URL);
        if (!res.ok) throw new Error('feed ' + res.status);
        const data = await res.json();
        if (!data || data.ok !== true || !Array.isArray(data.events)) throw new Error('bad feed');

        const today = new Intl.DateTimeFormat('en-CA', { timeZone: TZ }).format(new Date());
        events = data.events.filter(
          (e) => e && e.title && DATE_RE.test(e.startDate) && DATE_RE.test(e.endDate) && e.endDate >= today
        );
        if (events.length === 0) {
          message('No events posted yet. Check back soon, or submit yours below.');
          return;
        }
        filters.hidden = false;
        filters.addEventListener('click', (e) => {
          const btn = e.target.closest('button[data-filter]');
          if (!btn) return;
          filters.querySelectorAll('.event-chip').forEach((b) => b.classList.toggle('is-active', b === btn));
          render(btn.dataset.filter);
        });
        render('all');
      } catch {
        message('The calendar could not load right now. Please try again in a few minutes.');
      }
    })();
  </script>
</Layout>
