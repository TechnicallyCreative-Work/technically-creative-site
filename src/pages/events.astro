---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import BrandBanner from '~/components/widgets/BrandBanner.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';
import { headerData } from '~/navigation';

const metadata = {
  title: 'Shows & Events — Technically Creative LLC',
  description:
    'Upcoming Indianapolis-area live shows and music tech events, reviewed and posted by Technically Creative. Hosting something? Submit it.',
};

// Public JSON feed (n8n "Show Calendar API"): published shows and events from the
// Noise Floor list in ClickUp. See src/pages/events.astro <script> for the shape.
const FEED_URL = 'https://technicallycreative.app.n8n.cloud/webhook/show-calendar';

// Submission endpoint (n8n "Event Submission API"): validates the form and flier,
// then creates the ClickUp task for review. Flier specs below mirror that workflow.
const SUBMIT_URL = 'https://technicallycreative.app.n8n.cloud/webhook/event-submit';
// Canva default flyer: 8.5 x 11 in portrait = 816 x 1056 px at 1x export. A4 and 4:5 portrait also pass.
const FLIER_SPEC = { maxMB: 10, minShortSide: 816, minAspect: 0.68, maxAspect: 0.82 };
const LEAD_DAYS = 3;
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header
      links={headerData.links}
      actions={[{ text: 'Hire me', href: getPermalink('/contact#form') }]}
      isSticky
      showToggleTheme
    />
  </Fragment>
  <BrandBanner />

  <div class="container pt-10 pb-2 md:pt-14">
    <p class="font-bold uppercase tracking-wide text-secondary">Noise Floor</p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl md:text-4xl">Shows &amp; Events</h1>
    <p class="mt-3 max-w-2xl text-muted dark:text-slate-400">
      Live music and music tech events around Indianapolis, reviewed before they land here. Hosting or playing
      something? <a href="#submit" class="font-semibold text-primary hover:underline">Submit it below</a>.
    </p>
  </div>

  <WidgetWrapper id="events" containerClass="max-w-4xl mx-auto py-4 md:py-8">
    <div id="events-filters" class="mb-6 flex flex-wrap gap-2" role="group" aria-label="Filter by type" hidden>
      <button type="button" data-filter="all" class="event-chip is-active">All</button>
      <button type="button" data-filter="Live Show" class="event-chip">Live shows</button>
      <button type="button" data-filter="Music Tech Event" class="event-chip">Music tech events</button>
    </div>

    <div id="events-status" class="rounded-2xl p-6 text-center tc-well text-muted dark:text-slate-400" role="status">
      Loading events…
    </div>
    <div id="events-list" class="space-y-8" hidden></div>

    <template id="event-tpl">
      <article class="tc-card flex flex-col gap-4 rounded-2xl p-5 sm:flex-row">
        <div class="w-16 shrink-0 text-center">
          <div class="ev-mon text-xs font-bold uppercase tracking-wide text-secondary"></div>
          <div class="ev-day text-3xl font-bold leading-none"></div>
          <div class="ev-dow text-xs text-muted dark:text-slate-400"></div>
        </div>
        <div class="min-w-0 flex-1">
          <p class="ev-type text-xs font-bold uppercase tracking-wide text-primary"></p>
          <h3 class="ev-title mt-0.5 text-lg font-bold"></h3>
          <p class="ev-when mt-1 text-sm font-medium"></p>
          <ul class="ev-chips mt-2 flex flex-wrap gap-2 text-xs"></ul>
          <p class="ev-where mt-2 text-sm text-muted dark:text-slate-400">
            <a class="ev-map hover:underline" target="_blank" rel="noopener noreferrer"></a>
          </p>
          <p class="ev-note mt-2 text-sm text-muted dark:text-slate-400"></p>
          <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-semibold">
            <a
              class="ev-link inline-flex items-center gap-1.5 text-primary hover:underline"
              target="_blank"
              rel="noopener noreferrer"
              hidden
            >
              Details <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
            </a>
            <a class="ev-contact inline-flex items-center gap-1.5 text-primary hover:underline" hidden>
              <Icon name="tabler:mail" class="h-4 w-4" />
              <span>Ask about this event</span>
            </a>
          </div>
        </div>
        <a class="ev-flier block shrink-0 sm:w-28" target="_blank" rel="noopener noreferrer" hidden>
          <img
            class="ev-flier-img w-full rounded-lg border border-slate-200/80 object-cover dark:border-slate-700/60"
            alt=""
            loading="lazy"
          />
          <span class="ev-flier-label mt-1 block text-center text-xs font-semibold text-primary">View flier</span>
        </a>
      </article>
    </template>
  </WidgetWrapper>

  <WidgetWrapper id="submit" containerClass="max-w-4xl mx-auto py-4 md:py-8">
    <h2 class="text-xl font-bold md:text-2xl">Submit a show or event</h2>
    <p class="mt-2 text-sm text-muted dark:text-slate-400">
      Live shows and music tech events in the Indianapolis area. Every submission is reviewed before it is posted, so
      send it at least {LEAD_DAYS} days ahead.
    </p>

    <div id="submit-done" class="mt-6 rounded-2xl p-6 tc-well" role="status" hidden>
      <p class="text-lg font-bold">Got it, thank you.</p>
      <p class="mt-2 text-sm text-muted dark:text-slate-400">
        Your event is in the review queue. If it fits the calendar it will show up above, and the contact email you gave
        will be shown with it.
      </p>
      <button type="button" id="submit-another" class="mt-4 text-sm font-semibold text-primary hover:underline">
        Submit another event
      </button>
    </div>

    <form id="submit-form" class="tc-card mt-6 space-y-6 rounded-2xl p-5 md:p-6" novalidate>
      <div class="sr-only" aria-hidden="true">
        <label for="website_url">Leave this field empty</label>
        <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off" />
      </div>

      <fieldset>
        <legend class="block text-sm font-medium">What kind of listing is this?</legend>
        <div class="mt-2 flex flex-wrap gap-4">
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="type" value="Live Show" checked class="h-4 w-4" /> Live show
          </label>
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="type" value="Music Tech Event" class="h-4 w-4" /> Music tech event
          </label>
        </div>
      </fieldset>

      <div>
        <label for="f-title" class="block text-sm font-medium">Name of the event or show</label>
        <input
          id="f-title"
          name="title"
          type="text"
          required
          maxlength="120"
          class="tc-input mt-1 block w-full rounded-lg border px-4 py-3"
        />
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="f-startDate" class="block text-sm font-medium">Start date</label>
          <input
            id="f-startDate"
            name="startDate"
            type="date"
            required
            class="tc-input mt-1 block w-full rounded-lg border px-4 py-3"
          />
        </div>
        <div>
          <label for="f-startTime" class="block text-sm font-medium">Start time</label>
          <input
            id="f-startTime"
            name="startTime"
            type="time"
            required
            class="tc-input mt-1 block w-full rounded-lg border px-4 py-3"
          />
        </div>
        <div>
          <label for="f-endDate" class="block text-sm font-medium">End date</label>
          <input
            id="f-endDate"
            name="endDate"
            type="date"
            required
            class="tc-input mt-1 block w-full rounded-lg border px-4 py-3"
          />
        </div>
        <div>
          <label for="f-endTime" class="block text-sm font-medium">End time</label>
          <input
            id="f-endTime"
            name="endTime"
            type="time"
            required
            class="tc-input mt-1 block w-full rounded-lg border px-4 py-3"
          />
        </div>
        <div>
          <label for="f-doors" class="block text-sm font-medium">Doors open</label>
          <input
            id="f-doors"
            name="doors"
            type="time"
            required
            class="tc-input mt-1 block w-full rounded-lg border px-4 py-3"
          />
        </div>
        <div>
          <label for="f-parking" class="block text-sm font-medium">Parking</label>
          <select id="f-parking" name="parking" required class="tc-input mt-1 block w-full rounded-lg border px-4 py-3">
            <option value="">Choose one</option>
            <option value="Free">Free</option>
            <option value="Paid">Paid</option>
          </select>
        </div>
        <div>
          <label for="f-setting" class="block text-sm font-medium">Indoors or outdoors</label>
          <select id="f-setting" name="setting" required class="tc-input mt-1 block w-full rounded-lg border px-4 py-3">
            <option value="">Choose one</option>
            <option value="Indoors">Indoors</option>
            <option value="Outdoors">Outdoors</option>
            <option value="Both">Both</option>
          </select>
        </div>
        <div>
          <label for="f-city" class="block text-sm font-medium">City</label>
          <input
            id="f-city"
            name="city"
            type="text"
            required
            maxlength="80"
            value="Indianapolis"
            class="tc-input mt-1 block w-full rounded-lg border px-4 py-3"
          />
        </div>
      </div>

      <div>
        <label for="f-address" class="block text-sm font-medium">Street address</label>
        <input
          id="f-address"
          name="address"
          type="text"
          required
          maxlength="200"
          autocomplete="street-address"
          class="tc-input mt-1 block w-full rounded-lg border px-4 py-3"
        />
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="f-email" class="block text-sm font-medium">Contact email for questions about the event</label>
          <input
            id="f-email"
            name="email"
            type="email"
            required
            maxlength="120"
            autocomplete="email"
            class="tc-input mt-1 block w-full rounded-lg border px-4 py-3"
          />
          <p class="mt-1 text-xs text-muted dark:text-slate-400">Shown publicly with the listing.</p>
        </div>
        <div>
          <label for="f-link" class="block text-sm font-medium">Tickets or event page (optional)</label>
          <input
            id="f-link"
            name="link"
            type="url"
            maxlength="300"
            placeholder="https://"
            class="tc-input mt-1 block w-full rounded-lg border px-4 py-3"
          />
        </div>
      </div>

      <div>
        <label for="f-note" class="block text-sm font-medium">Anything else people should know (optional)</label>
        <textarea
          id="f-note"
          name="note"
          rows="3"
          maxlength="600"
          class="tc-input mt-1 block w-full rounded-lg border px-4 py-3"></textarea>
      </div>

      <div>
        <label for="f-flier" class="block text-sm font-medium">Flier</label>
        <input
          id="f-flier"
          name="flier"
          type="file"
          required
          accept="image/jpeg,image/png,application/pdf"
          class="mt-1 block w-full text-sm file:mr-4 file:rounded-lg file:border-0 file:bg-primary file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white"
        />
        <p class="mt-1 text-xs text-muted dark:text-slate-400">
          Use the Canva default flyer (8.5 x 11 in, portrait). JPG, PNG or PDF, up to {FLIER_SPEC.maxMB} MB. Export images
          at
          {FLIER_SPEC.minShortSide} x 1056 px or larger. A4 and 4:5 portrait also work.
        </p>
        <div id="flier-preview" class="mt-3" hidden>
          <img
            id="flier-preview-img"
            alt="Flier preview"
            class="max-h-48 rounded-lg border border-slate-200/80 dark:border-slate-700/60"
          />
        </div>
      </div>

      <label class="flex items-start gap-3 text-sm">
        <input id="f-consent" type="checkbox" required class="mt-1 h-4 w-4" />
        <span
          >I understand these details, including the contact email, will be shown publicly if the listing is approved.</span
        >
      </label>

      <div id="submit-errors" class="rounded-lg border border-red-500/60 p-4 text-sm" role="alert" hidden></div>

      <button
        type="submit"
        id="submit-btn"
        class="inline-flex items-center rounded-lg bg-primary px-6 py-3 font-semibold text-white disabled:opacity-60"
      >
        Submit for review
      </button>
    </form>
  </WidgetWrapper>

  <style is:global>
    .event-chip {
      border: 1px solid rgb(148 163 184 / 0.6);
      border-radius: 9999px;
      padding: 0.4rem 1rem;
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      transition:
        background-color 0.15s,
        color 0.15s,
        border-color 0.15s;
    }
    .event-chip:hover {
      border-color: rgb(0 200 255);
    }
    .event-chip.is-active {
      background: rgb(0 200 255);
      border-color: rgb(0 200 255);
      color: #fff;
    }
    .ev-chip {
      border: 1px solid rgb(148 163 184 / 0.5);
      border-radius: 9999px;
      padding: 0.15rem 0.6rem;
    }
  </style>

  <script define:vars={{ FEED_URL }}>
    (async () => {
      const status = document.getElementById('events-status');
      const list = document.getElementById('events-list');
      const filters = document.getElementById('events-filters');
      const tpl = document.getElementById('event-tpl');
      const TZ = 'America/Indiana/Indianapolis';
      const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
      const utcNoon = (iso) => new Date(iso + 'T12:00:00Z');
      const fmt = (iso, opts) => utcNoon(iso).toLocaleDateString('en-US', { ...opts, timeZone: 'UTC' });
      const httpsOnly = (u) => (typeof u === 'string' && /^https:\/\//i.test(u) ? u : null);

      const message = (text) => {
        status.textContent = text;
        status.hidden = false;
        list.hidden = true;
        filters.hidden = true;
      };

      const whenText = (ev) => {
        const sameDay = ev.startDate === ev.endDate;
        const startDay = fmt(ev.startDate, { weekday: 'short', month: 'short', day: 'numeric' });
        const endDay = fmt(ev.endDate, { weekday: 'short', month: 'short', day: 'numeric' });
        if (sameDay) {
          if (ev.startTime && ev.endTime && ev.startTime !== ev.endTime)
            return startDay + ', ' + ev.startTime + ' to ' + ev.endTime;
          if (ev.startTime) return startDay + ', ' + ev.startTime;
          return startDay;
        }
        return (
          startDay + (ev.startTime ? ', ' + ev.startTime : '') + ' to ' + endDay + (ev.endTime ? ', ' + ev.endTime : '')
        );
      };

      const card = (ev) => {
        const node = tpl.content.cloneNode(true);
        const q = (s) => node.querySelector(s);
        q('.ev-mon').textContent = fmt(ev.startDate, { month: 'short' });
        q('.ev-day').textContent = String(utcNoon(ev.startDate).getUTCDate());
        q('.ev-dow').textContent = fmt(ev.startDate, { weekday: 'short' });
        q('.ev-type').textContent = ev.type === 'Music Tech Event' ? 'Music tech event' : 'Live show';
        q('.ev-title').textContent = ev.title;
        q('.ev-when').textContent = whenText(ev);

        const chips = q('.ev-chips');
        const addChip = (text) => {
          const li = document.createElement('li');
          li.className = 'ev-chip';
          li.textContent = text;
          chips.appendChild(li);
        };
        if (ev.doors) addChip('Doors ' + ev.doors);
        if (ev.setting) addChip(ev.setting);
        if (ev.parking) addChip(ev.parking === 'Free' ? 'Free parking' : 'Paid parking');
        if (!chips.children.length) chips.remove();

        const where = [ev.address, ev.city].filter(Boolean).join(', ');
        if (where) {
          const a = q('.ev-map');
          a.textContent = where;
          a.href = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(where);
        } else {
          q('.ev-where').remove();
        }

        const note = q('.ev-note');
        if (ev.note) note.textContent = ev.note;
        else note.remove();

        const link = httpsOnly(ev.link);
        if (link) {
          const a = q('.ev-link');
          a.href = link;
          a.hidden = false;
        }
        if (ev.contact && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(ev.contact)) {
          const a = q('.ev-contact');
          a.href = 'mailto:' + ev.contact + '?subject=' + encodeURIComponent('Question about ' + ev.title);
          a.hidden = false;
        }
        const flier = httpsOnly(ev.flier);
        if (flier) {
          const a = q('.ev-flier');
          a.href = flier;
          a.hidden = false;
          const img = q('.ev-flier-img');
          if (/\.pdf(\?|$)/i.test(flier)) {
            img.remove();
          } else {
            img.src = flier;
            img.alt = 'Flier for ' + ev.title;
          }
        } else {
          q('.ev-flier').remove();
        }
        return node;
      };

      let events = [];
      const render = (filter) => {
        list.replaceChildren();
        const shown = events.filter((e) => filter === 'all' || e.type === filter);
        if (shown.length === 0) {
          status.textContent = 'Nothing in this category yet. Check back soon, or submit yours below.';
          status.hidden = false;
          list.hidden = true;
          return;
        }
        const byMonth = new Map();
        for (const ev of shown) {
          const key = ev.startDate.slice(0, 7);
          if (!byMonth.has(key)) byMonth.set(key, []);
          byMonth.get(key).push(ev);
        }
        for (const [key, items] of byMonth) {
          const section = document.createElement('section');
          const h2 = document.createElement('h2');
          h2.className = 'mb-3 text-sm font-bold uppercase tracking-wide text-muted dark:text-slate-400';
          h2.textContent = fmt(key + '-15', { month: 'long', year: 'numeric' });
          const grid = document.createElement('div');
          grid.className = 'space-y-4';
          for (const ev of items) grid.appendChild(card(ev));
          section.append(h2, grid);
          list.appendChild(section);
        }
        status.hidden = true;
        list.hidden = false;
      };

      try {
        const res = await fetch(FEED_URL);
        if (!res.ok) throw new Error('feed ' + res.status);
        const data = await res.json();
        if (!data || data.ok !== true || !Array.isArray(data.events)) throw new Error('bad feed');

        const today = new Intl.DateTimeFormat('en-CA', { timeZone: TZ }).format(new Date());
        events = data.events.filter(
          (e) => e && e.title && DATE_RE.test(e.startDate) && DATE_RE.test(e.endDate) && e.endDate >= today
        );
        if (events.length === 0) {
          message('No events posted yet. Check back soon, or submit yours below.');
          return;
        }
        filters.hidden = false;
        filters.addEventListener('click', (e) => {
          const btn = e.target.closest('button[data-filter]');
          if (!btn) return;
          filters.querySelectorAll('.event-chip').forEach((b) => b.classList.toggle('is-active', b === btn));
          render(btn.dataset.filter);
        });
        render('all');
      } catch {
        message('The calendar could not load right now. Please try again in a few minutes.');
      }
    })();
  </script>

  <script define:vars={{ SUBMIT_URL, FLIER_SPEC, LEAD_DAYS }}>
    (() => {
      const form = document.getElementById('submit-form');
      if (!form) return;
      const TZ = 'America/Indiana/Indianapolis';
      const $ = (id) => document.getElementById(id);
      const errBox = $('submit-errors');
      const btn = $('submit-btn');
      const done = $('submit-done');
      const startDate = $('f-startDate');
      const endDate = $('f-endDate');
      const flierInput = $('f-flier');
      const previewWrap = $('flier-preview');
      const previewImg = $('flier-preview-img');

      const todayIso = () => new Intl.DateTimeFormat('en-CA', { timeZone: TZ }).format(new Date());
      const addDays = (iso, n) => {
        const d = new Date(iso + 'T12:00:00Z');
        d.setUTCDate(d.getUTCDate() + n);
        return d.toISOString().slice(0, 10);
      };
      const minStart = addDays(todayIso(), LEAD_DAYS);
      startDate.min = minStart;
      endDate.min = minStart;
      startDate.addEventListener('change', () => {
        endDate.min = startDate.value || minStart;
        if (!endDate.value || endDate.value < startDate.value) endDate.value = startDate.value;
      });

      const showErrors = (list) => {
        errBox.replaceChildren();
        const ul = document.createElement('ul');
        ul.className = 'list-disc space-y-1 pl-5';
        for (const msg of list) {
          const li = document.createElement('li');
          li.textContent = msg;
          ul.appendChild(li);
        }
        errBox.appendChild(ul);
        errBox.hidden = false;
        errBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      };
      const clearErrors = () => {
        errBox.hidden = true;
        errBox.replaceChildren();
      };

      const imageSize = (file) =>
        new Promise((resolve) => {
          const url = URL.createObjectURL(file);
          const img = new Image();
          img.onload = () => {
            URL.revokeObjectURL(url);
            resolve({ w: img.naturalWidth, h: img.naturalHeight });
          };
          img.onerror = () => {
            URL.revokeObjectURL(url);
            resolve(null);
          };
          img.src = url;
        });

      // Returns an error message, or '' when the flier meets the specs.
      const checkFlier = async (file) => {
        if (!file) return 'Attach a flier (JPG, PNG or PDF).';
        if (file.size > FLIER_SPEC.maxMB * 1024 * 1024) return 'The flier is over ' + FLIER_SPEC.maxMB + ' MB.';
        if (!/^(image\/jpeg|image\/png|application\/pdf)$/.test(file.type))
          return 'The flier must be a JPG, PNG or PDF.';
        if (file.type === 'application/pdf') return '';
        const dim = await imageSize(file);
        if (!dim) return 'That image could not be read. Try exporting it again.';
        const shortSide = Math.min(dim.w, dim.h);
        const aspect = dim.w / dim.h;
        if (shortSide < FLIER_SPEC.minShortSide)
          return (
            'The flier image is too small (' +
            dim.w +
            'x' +
            dim.h +
            '). Use the Canva default flyer size (8.5 x 11 in), exported at ' +
            FLIER_SPEC.minShortSide +
            ' x 1056 px or larger.'
          );
        if (aspect < FLIER_SPEC.minAspect || aspect > FLIER_SPEC.maxAspect)
          return (
            'The flier shape does not fit (' +
            dim.w +
            'x' +
            dim.h +
            '). The flier needs to be portrait like the Canva default flyer (8.5 x 11 in). A4 and 4:5 portrait also work.'
          );
        return '';
      };

      flierInput.addEventListener('change', async () => {
        clearErrors();
        previewWrap.hidden = true;
        const file = flierInput.files && flierInput.files[0];
        if (!file) return;
        const problem = await checkFlier(file);
        if (problem) {
          showErrors([problem]);
          flierInput.value = '';
          return;
        }
        if (file.type !== 'application/pdf') {
          previewImg.src = URL.createObjectURL(file);
          previewWrap.hidden = false;
        }
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        clearErrors();
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        const problems = [];
        if (startDate.value < minStart)
          problems.push('Events need at least ' + LEAD_DAYS + ' days of lead time before they start.');
        if (endDate.value + 'T' + $('f-endTime').value < startDate.value + 'T' + $('f-startTime').value)
          problems.push('The end must be after the start.');
        const flierProblem = await checkFlier(flierInput.files && flierInput.files[0]);
        if (flierProblem) problems.push(flierProblem);
        if (problems.length) {
          showErrors(problems);
          return;
        }

        btn.disabled = true;
        btn.textContent = 'Sending...';
        try {
          const res = await fetch(SUBMIT_URL, { method: 'POST', body: new FormData(form) });
          let data = null;
          try {
            data = await res.json();
          } catch {
            data = null;
          }
          if (res.ok && data && data.ok) {
            form.hidden = true;
            done.hidden = false;
            done.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else if (data && Array.isArray(data.errors) && data.errors.length) {
            showErrors(data.errors);
          } else {
            showErrors([
              'That did not send. Please try again, or email contact@technicallycreative.work with the details and flier.',
            ]);
          }
        } catch {
          showErrors([
            'That did not send. Please try again, or email contact@technicallycreative.work with the details and flier.',
          ]);
        } finally {
          btn.disabled = false;
          btn.textContent = 'Submit for review';
        }
      });

      $('submit-another').addEventListener('click', () => {
        form.reset();
        previewWrap.hidden = true;
        clearErrors();
        done.hidden = true;
        form.hidden = false;
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    })();
  </script>
</Layout>
