---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import BrandBanner from '~/components/widgets/BrandBanner.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { getPermalink } from '~/utils/permalinks';
import { headerData } from '~/navigation';
import { RESET_FLAG_MESSAGES } from '~/lib/auth-messages';

const metadata = {
  title: 'Reset Password — Technically Creative LLC',
  robots: { index: false, follow: false },
};

// Looked up by key — never echo the query value straight into the page.
const flagMessage = RESET_FLAG_MESSAGES[Astro.url.searchParams.get('error') ?? ''];
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header links={headerData.links} isSticky showToggleTheme />
  </Fragment>
  <BrandBanner />

  <div class="container pt-10 pb-2 md:pt-14">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl md:text-4xl">Reset Your Password</h1>
    <p class="mt-3 max-w-2xl text-muted dark:text-slate-400">
      Enter your account email and we'll send you a link to choose a new password.
    </p>
  </div>

  <WidgetWrapper containerClass="max-w-md mx-auto py-4 md:py-8">
    <form id="forgot-form" class="rounded-2xl border border-primary/30 bg-white/70 p-6 dark:bg-slate-900/40">
      {
        flagMessage && (
          <p class="mb-4 rounded-lg bg-amber-500/10 px-3 py-2 text-sm text-amber-700 dark:text-amber-400">
            {flagMessage}
          </p>
        )
      }
      <div class="mb-4">
        <label for="email" class="block text-sm font-medium text-slate-900 dark:text-white">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="mt-1 w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm dark:border-gray-700 dark:bg-slate-900"
        />
      </div>
      <p id="forgot-error" class="mb-4 hidden text-sm text-rose-600"></p>
      <p id="forgot-success" class="mb-4 hidden text-sm text-emerald-600">
        If an account exists for that email, a reset link is on its way. It can take a minute — check your spam folder
        too. For security, open the link in the same browser you're using now.
      </p>
      <button
        type="submit"
        id="forgot-submit"
        class="w-full rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60"
      >
        Send reset link
      </button>
      <p class="mt-4 text-center text-sm text-muted dark:text-slate-400">
        Remembered it? <a href={getPermalink('/login')} class="font-semibold text-primary hover:underline">Log in</a>
      </p>
    </form>
  </WidgetWrapper>
</Layout>

<script>
  import { createSupabaseBrowserClient } from '~/lib/supabase-client';
  import { friendlyAuthError } from '~/lib/auth-messages';

  const form = document.getElementById('forgot-form') as HTMLFormElement;
  const errorEl = document.getElementById('forgot-error') as HTMLParagraphElement;
  const successEl = document.getElementById('forgot-success') as HTMLParagraphElement;
  const submitBtn = document.getElementById('forgot-submit') as HTMLButtonElement;

  // Constructed defensively — see login.astro for why.
  let supabase: ReturnType<typeof createSupabaseBrowserClient> | null = null;
  try {
    supabase = createSupabaseBrowserClient();
  } catch (err) {
    console.error('Failed to initialize Supabase client', err);
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl.classList.add('hidden');
    successEl.classList.add('hidden');

    if (!supabase) {
      errorEl.textContent = 'Password reset is temporarily unavailable. Please try again shortly.';
      errorEl.classList.remove('hidden');
      return;
    }

    const email = String(new FormData(form).get('email') ?? '').trim();
    submitBtn.disabled = true;

    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      // The callback exchanges the link's code for a session, then forwards to
      // /reset-password where the new password is set.
      redirectTo: `${window.location.origin}/api/auth/callback?next=/reset-password`,
    });

    if (error) {
      submitBtn.disabled = false;
      errorEl.textContent = friendlyAuthError(error);
      errorEl.classList.remove('hidden');
      return;
    }

    // Same message whether or not the email has an account, so this form can't
    // be used to discover who is registered.
    successEl.classList.remove('hidden');
    // Cooldown so repeated clicks don't burn through Supabase's email rate limit.
    setTimeout(() => (submitBtn.disabled = false), 60_000);
  });
</script>
