---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import BrandBanner from '~/components/widgets/BrandBanner.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';
import { headerData } from '~/navigation';

const metadata = {
  title: 'Indy Show Calendar — Technically Creative LLC',
  description:
    'Upcoming Indianapolis-area live music shows from the Noise Floor calendar, hand-picked by Technically Creative. Playing a show? Submit it.',
};

// Public JSON feed (n8n "Show Calendar API"). Returns published Noise Floor
// shows only: { ok, updated, shows: [{ title, date: 'YYYY-MM-DD', link, note }] }.
const FEED_URL = 'https://technicallycreative.app.n8n.cloud/webhook/show-calendar';
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header
      links={headerData.links}
      actions={[{ text: 'Hire me', href: getPermalink('/contact#form') }]}
      isSticky
      showToggleTheme
    />
  </Fragment>
  <BrandBanner />

  <div class="container pt-10 pb-2 md:pt-14">
    <p class="font-bold uppercase tracking-wide text-secondary">Noise Floor</p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl md:text-4xl">Indy Show Calendar</h1>
    <p class="mt-3 max-w-2xl text-muted dark:text-slate-400">
      Upcoming live music around Indianapolis, hand-picked and reviewed before they land here. Playing a show? Send it
      in at least 72 hours ahead.
    </p>
  </div>

  <WidgetWrapper id="shows" containerClass="max-w-4xl mx-auto py-4 md:py-8">
    <div id="shows-status" class="rounded-2xl p-6 text-center tc-well text-muted dark:text-slate-400" role="status">
      Loading shows…
    </div>
    <div id="shows-list" class="space-y-8" hidden></div>
    <template id="show-tpl">
      <article class="tc-card flex gap-4 rounded-2xl p-5">
        <div class="w-16 shrink-0 text-center">
          <div class="show-mon text-xs font-bold uppercase tracking-wide text-secondary"></div>
          <div class="show-day text-3xl font-bold leading-none"></div>
          <div class="show-dow text-xs text-muted dark:text-slate-400"></div>
        </div>
        <div class="min-w-0 flex-1">
          <h3 class="show-title text-lg font-bold"></h3>
          <p class="show-note mt-1 text-sm text-muted dark:text-slate-400"></p>
          <a
            class="show-link mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline"
            target="_blank"
            rel="noopener noreferrer"
            hidden
          >
            Details <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
          </a>
        </div>
      </article>
    </template>
  </WidgetWrapper>

  <CallToAction
    title="Playing a show in Indy?"
    subtitle="Send the date, venue and a ticket or event link. I review submissions and add the ones that fit. Fishers and Carmel are out of scope for now."
    actions={[{ variant: 'primary', text: 'Submit a show', href: getPermalink('/contact#form') }]}
  />

  <script define:vars={{ FEED_URL }}>
    (async () => {
      const status = document.getElementById('shows-status');
      const list = document.getElementById('shows-list');
      const tpl = document.getElementById('show-tpl');
      const TZ = 'America/Indiana/Indianapolis';
      const message = (text) => {
        status.textContent = text;
        status.hidden = false;
        list.hidden = true;
      };
      try {
        const res = await fetch(FEED_URL);
        if (!res.ok) throw new Error('feed ' + res.status);
        const data = await res.json();
        if (!data || data.ok !== true || !Array.isArray(data.shows)) throw new Error('bad feed');

        const today = new Intl.DateTimeFormat('en-CA', { timeZone: TZ }).format(new Date());
        const shows = data.shows.filter((s) => /^\d{4}-\d{2}-\d{2}$/.test(s.date) && s.date >= today);
        if (shows.length === 0) {
          message('No shows posted yet. Check back soon, or submit yours below.');
          return;
        }

        const byMonth = new Map();
        for (const s of shows) {
          const key = s.date.slice(0, 7);
          if (!byMonth.has(key)) byMonth.set(key, []);
          byMonth.get(key).push(s);
        }

        for (const [key, items] of byMonth) {
          const section = document.createElement('section');
          const h2 = document.createElement('h2');
          h2.className = 'mb-3 text-sm font-bold uppercase tracking-wide text-muted dark:text-slate-400';
          h2.textContent = new Date(key + '-15T12:00:00Z').toLocaleDateString('en-US', {
            month: 'long',
            year: 'numeric',
            timeZone: 'UTC',
          });
          const grid = document.createElement('div');
          grid.className = 'space-y-4';
          for (const s of items) {
            const node = tpl.content.cloneNode(true);
            const d = new Date(s.date + 'T12:00:00Z');
            node.querySelector('.show-mon').textContent = d.toLocaleDateString('en-US', {
              month: 'short',
              timeZone: 'UTC',
            });
            node.querySelector('.show-day').textContent = String(d.getUTCDate());
            node.querySelector('.show-dow').textContent = d.toLocaleDateString('en-US', {
              weekday: 'short',
              timeZone: 'UTC',
            });
            node.querySelector('.show-title').textContent = s.title;
            const note = node.querySelector('.show-note');
            if (s.note) note.textContent = s.note;
            else note.remove();
            const a = node.querySelector('.show-link');
            if (s.link && /^https?:\/\//i.test(s.link)) {
              a.href = s.link;
              a.hidden = false;
            }
            grid.appendChild(node);
          }
          section.append(h2, grid);
          list.appendChild(section);
        }
        status.hidden = true;
        list.hidden = false;
      } catch {
        message('The calendar could not load right now. Please try again in a few minutes.');
      }
    })();
  </script>
</Layout>
