---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { headerData } from '~/navigation';
import heroBackground from '~/assets/images/wbckgroundtemp.jpg';

const metadata = {
  title: 'Technically Creative - Audio / PM / Delivery',
  ignoreTitleTemplate: true,
};

const links = [...headerData.links, { text: 'Portfolio', href: '/portfolio' }];
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header links={links} isSticky showToggleTheme />
  </Fragment>

  <!-- Hero Widget ******************* -->
  <Hero
    backgroundImage={heroBackground.src}
    backgroundOverlayClass="bg-slate-900/70"
    actions={[
      {
        variant: 'primary',
        text: 'Explore services ->',
        href: '/services',
      },
    ]}
  > 
    <Fragment slot="title"> Creative sound. <p>Engineered with discipline</p> </Fragment>


  <br />
  <br />
    <Fragment slot="subtitle">
      At Technically Creative LLC, I bring together a Master’s in Music Technology and PMP project management expertise.
      That means your music or media project gets the artistry it deserves—and the professional process it needs to
      finish on time, on budget, and with impact.
    </Fragment>
  </Hero>

  <!-- Steps Widget — Customer POV (PMI Lifecycle) ****************** -->
  <Steps
    title="Work with Technically Creative — a clear, disciplined path from idea to launch."
    items={[
      {
        title: 'Discovery: <span class="font-medium">Goals, Constraints, and Fit</span>',
        description:
          'We start with a focused kickoff to understand your vision, target audience, success criteria, budget, and timeline. You’ll share any existing assets (brand kit, references, audio/video, copy). I map risks and assumptions, then return a concise Project Brief so we’re aligned before any build begins.',
        icon: 'tabler:compass',
      },
      {
        title: 'Planning: <span class="font-medium">Blueprint & Commitments</span>',
        description:
          'Together we develop a clear scope, work breakdown, and schedule. Deliverables are mapped in ClickUp, milestones are defined, and communication plans are locked in. You’ll approve a transparent plan that covers budget, risks, and change management so expectations stay realistic and under control.',
        icon: 'tabler:map',
      },
      {
        title: 'Execution: <span class="font-medium">Create & Deliver</span>',
        description:
          'This is where the build happens — whether it’s a mix, sound design, automation workflow, or content asset. I keep progress visible in ClickUp and Drive so you see updates in real time. Drafts and prototypes are shared for your feedback to ensure alignment every step of the way.',
        icon: 'tabler:tools',
      },
      {
        title: 'Monitoring & Control: <span class="font-medium">Stay on Track</span>',
        description:
          'Performance, risks, and quality are tracked against the plan. Change requests are documented, timelines are adjusted as needed, and KPIs like turnaround and clarity are measured. You’ll always know where the project stands and what’s coming next.',
        icon: 'tabler:chart-dots',
      },
      {
        title: 'Closure: <span class="font-medium">Handover & Review</span>',
        description:
          'Final deliverables are approved, packaged, and delivered. We close with a brief review session to capture lessons learned, gather a testimonial, and discuss future opportunities. You leave with a polished result and a clear record of the project journey.',
        icon: 'tabler:flag-check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'Steps image',
    }}
  />

  <!-- Features2 Widget ************** -->
  <Features2
    title="Technically Creative — Audio • PM • Delivery"
    subtitle="A collection of offerings and services that will help you get your creative project done"
    tagline="Highlights"
    items={[
      {
        title: 'Mixing & Mastering',
        description: "Release-ready mixes and masters that translate across all playback systems.",
        icon: 'tabler:music',
      },
      {
        title: 'Sound Design & Foley',
        description:
          "Custom soundscapes and immersive audio for film, games, and interactive experiences.",
        icon: 'flat-color-icons:music',
      },
      {
        title: 'Music Technology Consulting',
        description:
          'Expert guidance on DAWs, studio setup, signal flow, and audio software optimization.',
        icon: 'flat-color-icons:idea',
      },
      {
        title: 'Project Management',
        description:
          "Structured workflows and Agile methodologies to keep your creative projects on track and on budget.",
        icon: 'flat-color-icons:planner',
      },
      {
        title: 'Workflow Automation',
        description:
          'Automate repetitive tasks, streamline client intake, and optimize your creative pipeline for efficiency.',
        icon: 'flat-color-icons:workflow',
      },
      {
        title: 'Public Speaking & Workshops',
        description: 'Engaging presentations and hands-on training on music technology, audio production, and project management for creatives.',
        icon: 'flat-color-icons:voice-presentation',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- HighlightedPosts Widget ******* -->
  {
    /*
  <BlogLatestPosts
    title="Find out more content in our Blog"
    information={`The blog is used to display AstroWind documentation.
                        Each new article will be an important step that you will need to know to be an expert in creating a website using Astro + Tailwind CSS.
                        Astro is a very interesting technology. Thanks.
                `}
  />
  */
  }

  <!-- FAQs Widget ******************* -->
  <FAQs
    title="Frequently Asked Questions"
    subtitle="Answers to the most common questions about Technically Creative LLC and how we can help elevate your projects."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'What does Technically Creative LLC do?',
        description:
          'We blend music technology with professional project management. That means offering mixing, mastering, and sound design while also bringing structured workflows, Agile/Six Sigma efficiency, and automation to creative projects. Think of it as the best of art and systems working together.',
      },
      {
        title: 'Who do you work with?',
        description:
          'Our clients are creatives and teams—musicians, studios, indie developers, filmmakers, and freelancers—who want professional-quality output without chaos. We also help creative entrepreneurs who need structure in their business workflows.',
      },
      {
        title: 'How do I start working with you?',
        description:
          'It begins with a discovery call. We’ll review your goals, discuss your creative or operational challenges, and then propose a tailored plan. From there, we move into onboarding with clear expectations, timelines, and deliverables.',
      },
      {
        title: 'Do you only offer music production?',
        description:
          'Not at all. While music technology is at our core, we also provide consulting for workflow improvement, automation (using tools like ClickUp, n8n, and Google Drive), and training for creatives who want to level up their project management game.',
      },
      {
        title: 'How do you keep projects on track?',
        description:
          "We use a structured delivery process: intake -> planning -> execution -> revisions -> final delivery. Tools like ClickUp and HubSpot help us track progress, while regular check-ins ensure you're never left in the dark.",
      },
      {
        title: 'What makes you different?',
        description:
          'Our founder is a PMP-certified project manager with a Master’s in Music Technology. That means every creative service comes with professional-grade project discipline. You don’t just get a deliverable—you get a system that ensures it’s delivered on time, with clarity and quality.',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->
  <Stats
    stats={[
      { title: 'Asset Downloads', amount: '120' },
      { title: 'Projects Completed', amount: '800' },
      { title: 'Projects in Progress', amount: '300' },
      { title: 'Newsletter Subscribers', amount: '100' },
    ]}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'About Us ->',
        href: '/about',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">
      Technically <br class="block sm:hidden" /><span class="sm:whitespace-nowrap">Creative</span>
    </Fragment>

    <Fragment slot="subtitle">
      Want to learn more? <br class="hidden md:inline" /><br class="hidden md:inline" />
    </Fragment>
  </CallToAction>
</Layout>



