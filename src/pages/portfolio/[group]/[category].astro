---
import { Icon } from 'astro-icon/components';
import SectionPage from '~/layouts/SectionPage.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Button from '~/components/ui/Button.astro';
import ProjectCard from '~/components/portfolio/ProjectCard.astro';
import { getPermalink } from '~/utils/permalinks';
import { getGroupCategories, groups } from '~/data/portfolio';
import type { Category } from '~/data/portfolio';

export function getStaticPaths() {
  return groups.flatMap((group) =>
    getGroupCategories(group).map((category) => ({
      params: { group: group.id, category: category.id },
      props: { category },
    }))
  );
}

const { category } = Astro.props as { category: Category };
const { id, title, description, icon, serviceHref, heroVideo, projects } = category;

const metadata = {
  title: `${title} - Portfolio - Technically Creative LLC`,
  description,
};
---

<SectionPage metadata={metadata}>
  <WidgetWrapper id={id} containerClass="max-w-6xl mx-auto py-10 md:py-14">
    <div class="flex items-center gap-3 text-primary">
      <Icon name={icon} class="h-8 w-8" />
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">{title}</h1>
    </div>
    <p class="mt-3 max-w-3xl text-lg text-muted dark:text-slate-300">{description}</p>

    {heroVideo && (
      <div class="mt-6 aspect-video w-full max-w-3xl overflow-hidden rounded-2xl shadow-lg">
        <iframe
          width="100%"
          height="100%"
          src={heroVideo}
          title={`${title} — Technically Creative`}
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          class="h-full w-full"
        ></iframe>
      </div>
    )}

    {projects.length === 0 ? (
      <div class="mt-8 rounded-2xl px-6 py-10 text-center tc-well">
        <p class="text-muted dark:text-slate-400">Case studies coming soon — this service is actively offered.</p>
        <div class="mt-4">
          <Button variant="link" href={getPermalink('/contact#form')} icon="tabler:arrow-right" text="Inquire about this service" />
        </div>
      </div>
    ) : (
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    )}

    <div class="mt-8">
      <Button variant="link" href={getPermalink(serviceHref)} icon="tabler:arrow-right" text="View matching service" />
    </div>
  </WidgetWrapper>
</SectionPage>
