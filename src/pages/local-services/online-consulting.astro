---
import SectionPage from '~/layouts/SectionPage.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';

import gDesk1 from '~/assets/images/desk1.jpg';
import gDesk3 from '~/assets/images/desk3.jpg';

const galleries: Record<string, { src: string; alt: string }[]> = {
  'services': [
    { src: gDesk1.src, alt: 'Studio setup' },
    { src: gDesk3.src, alt: 'Ableton session' },
  ],
};

const upworkServices = [
  { title: 'Ableton Live Workflow & Controller Setup', subtitle: '90-Minute Session', price: 'From $250', url: 'https://www.upwork.com/freelancers/techcre8' },
  { title: 'Optimized Ableton Workflow for Faster Music Production', subtitle: 'Workflow audit & rebuild', price: 'From $85', url: 'https://www.upwork.com/freelancers/techcre8' },
  { title: 'Ableton Production Workflow & Track Finishing', subtitle: 'Full session support', price: 'From $200', url: 'https://www.upwork.com/freelancers/techcre8' },
  { title: 'Automation Audit & Architecture Review', subtitle: 'For your workflows', price: 'From $250', url: 'https://www.upwork.com/freelancers/techcre8' },
];
const metadata = {
  title: 'Services & Consulting — Technically Creative LLC',
  description: 'Ableton workflow sessions and automation audits booked through Upwork — hourly or fixed-price with contract and payment protection.',
};
---

<SectionPage
  metadata={metadata}
  ctaTitle="Need something custom?"
  ctaSubtitle="Have a project that doesn't fit a listed service? Get in touch and we'll scope it out together."
  ctaActions={[{ variant: 'primary', text: 'Start a project', href: getPermalink('/contact#form') }]}
>
  <WidgetWrapper id="services" containerClass="max-w-6xl mx-auto py-12 md:py-16">
    <a href="/local-services" class="mb-5 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline">
      <Icon name="tabler:arrow-left" class="h-4 w-4" /> All local &amp; custom services
    </a>
    <div class="flex items-center gap-3 text-primary">
      <Icon name="tabler:briefcase" class="h-7 w-7" />
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">Services & Consulting</h1>
    </div>
    <p class="mt-2 max-w-2xl text-muted dark:text-slate-300">Ongoing and contract services booked through Upwork — hourly or fixed-price, with full contract and payment protection.</p>

    {galleries['services'].length > 0 && (
      <div class="mt-6 flex gap-3 overflow-x-auto pb-2">
        {galleries['services'].map(({ src, alt }) => (
          <div class="shrink-0 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
            <img src={src} alt={alt} class="h-44 w-auto object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    )}

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {upworkServices.map(({ title, subtitle, price, url }) => (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col rounded-2xl p-5 tc-card tc-card-link"
        >
          <div class="flex items-start justify-between gap-2">
            <span class="font-semibold text-slate-900 dark:text-white">{title}</span>
            <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300">{price}</span>
          </div>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{subtitle}</p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-primary group-hover:underline">
            Book on Upwork <Icon name="tabler:external-link" class="h-4 w-4" />
          </span>
        </a>
      ))}
    </div>
  </WidgetWrapper>
</SectionPage>
