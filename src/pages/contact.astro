---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const links = [
  { text: 'Home', href: '/' },
  { text: 'Services', href: '/services' },
  { text: 'About', href: '/about' },
  { text: 'Credentials', href: '/credentials' },
  { text: 'Contact', href: '/contact' },
];

const metadata = {
  title: 'Contact',
};

const hubspotForm = {
  portalId: '243565281',
  formId: 'b5b6ae47-3af4-4bb3-8276-67c891793038',
  region: 'na2',
  loadingText: 'Sending…',
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header links={links} isSticky showToggleTheme />
  </Fragment>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Let's Connect!" />

  <ContactUs
    id="form"
    title="Let'get started on that project!"
    subtitle="Please do not hesistate to reach out! I don't care if you are a novice or professional I am going to support you the whole way! We gotta take the power back!"
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
        autocomplete: 'name',
        required: true,
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        autocomplete: 'email',
        required: true,
      },
      {
        type: 'select',
        name: 'project_type',
        label: 'Project Type',
        options: [
          { label: 'Mixing / Mastering', value: 'mixing_mastering' },
          { label: 'Trailer Sound Design', value: 'trailer_sound_design' },
          { label: 'AI Workflow Consulting', value: 'ai_workflow_consulting' },
          { label: 'Other', value: 'other' },
        ],
        required: true,
      },
      {
        type: 'select',
        name: 'budget_range',
        label: 'Budget Range',
        options: [
          { label: 'Under $500', value: 'under_500' },
          { label: '$500-$1000', value: '500-1000' },
          { label: '$1,000-$2,500', value: '1000-2500' },
          { label: '$2,500-$5,000', value: '2500-5000' },
          { label: '$5000+', value: '5000_plus' },
        ],
        required: true,
      },
      {
        type: 'select',
        name: 'timeline_urgency',
        label: 'Timeline / Urgency',
        options: [
          { label: 'ASAP (Within 1 Month)', value: 'asap' },
          { label: '1-3 Months', value: '1-3_months' },
          { label: '3-6 Months', value: '3-6_months' },
          { label: 'Flexible', value: 'flexible' },
        ],
        required: true,
      },
      {
        type: 'checkbox-group',
        name: 'service_interest',
        label: 'Service Interest',
        options: [
          { label: 'Music Technology (Mixing/Mastering)', value: 'music_technology' },
          { label: 'Project Management Consulting', value: 'project_management' },
          { label: 'Creative Training / Workshops', value: 'creative_training' },
          { label: 'AI & Automation Solutions', value: 'ai_automation' },
        ],
      },
      {
        type: 'select',
        name: 'referral_source',
        label: 'Referral Source',
        options: [
          { label: 'LinkedIn', value: 'linkedin' },
          { label: 'Website / Blog', value: 'website_blog' },
          { label: 'Word of Mouth / Referral', value: 'word_of_mouth' },
          { label: 'PMI / AES Network', value: 'pmi_aes_network' },
          { label: 'Social Media (IG, YouTube, etc.)', value: 'social_media' },
          { label: 'Other', value: 'other' },
        ],
      },
    ]}
    textarea={{
      label: 'Message',
      name: 'message',
      required: true,
    }}
    disclaimer={{
      label:
        'By submitting this contact form, you acknowledge and agree to the collection of your personal information.',
      name: 'privacy_consent',
      required: true,
      value: 'granted',
    }}
    button="Send message"
    description="Our support team typically responds within 24 business hours."
    successMessage="Thanks! We've received your note and will follow up shortly."
    errorMessage="We couldn't submit your message. Please double-check the form and try again."
    hubspot={hubspotForm}
    classes={{
      form: 'min-h-[420px]',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="We are here to help!"
    items={[
      {
        title: 'General support',
        description: `Chat with us for inquiries related to account management, website navigation, payment issues, accessing purchased templates or general questions about the website's functionality.`,
      },
      {
        title: 'Contact sales',
        description:
          'Chat with us for questions about purchases, customization options, licensing for commercial use, inquiries about specific template, etc.',
      },
      {
        title: 'Technical support',
        description:
          'Chat with us when facing issues like template installation, problems editing difficulties, compatibility issues with software or download errors, or other technical challenges related to using the templates.',
      },
      {
        title: 'Phone',
        description: '+1 (234) 567-890',
        icon: 'tabler:headset',
      },
      {
        title: 'Email',
        description: 'contact@support.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Location',
        description: '1234 Lorem Ipsum St, 12345, Miami, EEUU',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
