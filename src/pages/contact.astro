---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';
import heroBackground from '~/assets/images/wbckgroundtemp.jpg';

const links = [
  { text: 'Home', href: '/' },
  { text: 'Services', href: '/services' },
  { text: 'About', href: '/about' },
  { text: 'Credentials', href: '/credentials' },
  { text: 'Portfolio', href: '/portfolio' },
  { text: 'Contact', href: '/contact' },
];

const metadata = {
  title: 'Contact',
};

const hubspotForm = {
  portalId: '243565281',
  formId: 'b5b6ae47-3af4-4bb3-8276-67c891793038',
  region: 'na2',
  loadingText: 'Sending…',
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header links={links} isSticky showToggleTheme />
  </Fragment>
  <!-- Hero Widget ******************* -->
  <Hero
    tagline="Contact"
    title="How do we get started?"
    backgroundImage={heroBackground.src}
    backgroundOverlayClass="bg-slate-900/70"
  >
    <Fragment slot="subtitle">
      Tell me what you need, how fast you need it, and any reference material. I'll respond within one business day so we
      can map next steps together.
    </Fragment>
  </Hero>

  <ContactUs
    id="form"
    title="Fill out this form!"
    subtitle="Please do not hesistate to reach out! I don't care if you are a novice or professional I am going to support you the whole way! We gotta take the power back!"
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
        autocomplete: 'name',
        required: true,
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        autocomplete: 'email',
        required: true,
      },
      {
        type: 'select',
        name: 'project_type',
        label: 'Project Type',
        options: [
          { label: 'Mixing / Mastering', value: 'mixing_mastering' },
          { label: 'Trailer Sound Design', value: 'trailer_sound_design' },
          { label: 'AI Workflow Consulting', value: 'ai_workflow_consulting' },
          { label: 'Other', value: 'other' },
        ],
        required: true,
      },
      {
        type: 'select',
        name: 'budget_range',
        label: 'Budget Range',
        options: [
          { label: 'Under $500', value: 'under_500' },
          { label: '$500-$1000', value: '500-1000' },
          { label: '$1,000-$2,500', value: '1000-2500' },
          { label: '$2,500-$5,000', value: '2500-5000' },
          { label: '$5000+', value: '5000_plus' },
        ],
        required: true,
      },
      {
        type: 'select',
        name: 'timeline_urgency',
        label: 'Timeline / Urgency',
        options: [
          { label: 'ASAP (Within 1 Month)', value: 'asap' },
          { label: '1-3 Months', value: '1-3_months' },
          { label: '3-6 Months', value: '3-6_months' },
          { label: 'Flexible', value: 'flexible' },
        ],
        required: true,
      },
      {
        type: 'checkbox-group',
        name: 'service_interest',
        label: 'Service Interest',
        options: [
          { label: 'Music Technology (Mixing/Mastering)', value: 'music_technology' },
          { label: 'Project Management Consulting', value: 'project_management' },
          { label: 'Creative Training / Workshops', value: 'creative_training' },
          { label: 'AI & Automation Solutions', value: 'ai_automation' },
        ],
      },
      {
        type: 'select',
        name: 'referral_source',
        label: 'Referral Source',
        options: [
          { label: 'LinkedIn', value: 'linkedin' },
          { label: 'Website / Blog', value: 'website_blog' },
          { label: 'Word of Mouth / Referral', value: 'word_of_mouth' },
          { label: 'PMI / AES Network', value: 'pmi_aes_network' },
          { label: 'Social Media (IG, YouTube, etc.)', value: 'social_media' },
          { label: 'Other', value: 'other' },
        ],
      },
    ]}
    textarea={{
      label: 'Message',
      name: 'message',
      required: true,
    }}
    disclaimer={{
      label:
        'By submitting this contact form, you acknowledge and agree to the collection of your personal information.',
      name: 'privacy_consent',
      required: true,
      value: 'granted',
    }}
    button="Send message"
    description="Technically Creative representative will get back to you as soon as possible typically within 24-48 business hours."
    successMessage="Thanks! We've received your note and will follow up shortly."
    errorMessage="We couldn't submit your message. Please double-check the form and try again."
    hubspot={hubspotForm}
    classes={{
      form: 'min-h-[420px]',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Selection details"
    items={[
      {
        title: 'Project Type',
        description: '<ul><li>Mixing / Mastering</li><li>Trailer Sound Design</li><li>AI Workflow Consulting</li><li>Other</li></ul>',
      },
      {
        title: 'Budget Range',
        description: '<ul><li>Under $500</li><li>$500-$1000</li><li>$1,000-$2,500</li><li>$2,500-$5,000</li><li>$5000+</li></ul>',
      },
      {
        title: 'Timeline / Urgency',
        description: '<ul><li>ASAP (Within 1 Month)</li><li>1-3 Months</li><li>3-6 Months</li><li>Flexible</li></ul>',
      },
      {
        title: 'Referral Source',
        description: '<ul><li>LinkedIn</li><li>Website / Blog</li><li>Word of Mouth / Referral</li><li>PMI / AES Network</li><li>Social Media (IG, YouTube, etc.)</li><li>Other</li></ul>',
      },
    ]}
  />
</Layout>
