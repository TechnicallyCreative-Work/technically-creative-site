---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import BrandBanner from '~/components/widgets/BrandBanner.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { Icon } from 'astro-icon/components';
import { headerData } from '~/navigation';

const links = headerData.links;

const metadata = {
  title: 'Contact',
};

const hubspotForm = {
  portalId: '243565281',
  formId: 'b5b6ae47-3af4-4bb3-8276-67c891793038',
  region: 'na2',
  loadingText: 'Sending…',
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header links={links} isSticky showToggleTheme />
  </Fragment>
  <BrandBanner />
  <ContactUs
    id="form"
    title="Fill out this form!"
    subtitle="Tell me about your project goals, timeline, and any references. Whether you're just starting or scaling up, I'll help guide the entire process."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
        autocomplete: 'name',
        required: true,
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        autocomplete: 'email',
        required: true,
      },
      {
        type: 'select',
        name: 'project_type',
        label: 'Project Type',
        options: [
          { label: 'Mixing / Mastering', value: 'mixing_mastering' },
          { label: 'Trailer Sound Design', value: 'trailer_sound_design' },
          { label: 'AI Workflow Consulting', value: 'ai_workflow_consulting' },
          { label: 'Other', value: 'other' },
        ],
        required: true,
      },
      {
        type: 'select',
        name: 'budget_range',
        label: 'Budget Range',
        options: [
          { label: 'Under $500', value: 'under_500' },
          { label: '$500-$1000', value: '500-1000' },
          { label: '$1,000-$2,500', value: '1000-2500' },
          { label: '$2,500-$5,000', value: '2500-5000' },
          { label: '$5000+', value: '5000_plus' },
        ],
        required: true,
      },
      {
        type: 'select',
        name: 'timeline_urgency',
        label: 'Timeline / Urgency',
        options: [
          { label: 'ASAP (Within 1 Month)', value: 'asap' },
          { label: '1-3 Months', value: '1-3_months' },
          { label: '3-6 Months', value: '3-6_months' },
          { label: 'Flexible', value: 'flexible' },
        ],
        required: true,
      },
      {
        type: 'checkbox-group',
        name: 'service_interest',
        label: 'Service Interest',
        options: [
          { label: 'Music Technology (Mixing/Mastering)', value: 'music_technology' },
          { label: 'Project Management Consulting', value: 'project_management' },
          { label: 'Creative Training / Workshops', value: 'creative_training' },
          { label: 'AI & Automation Solutions', value: 'ai_automation' },
        ],
      },
      {
        type: 'select',
        name: 'referral_source',
        label: 'Referral Source',
        options: [
          { label: 'LinkedIn', value: 'linkedin' },
          { label: 'Website / Blog', value: 'website_blog' },
          { label: 'Word of Mouth / Referral', value: 'word_of_mouth' },
          { label: 'PMI / AES Network', value: 'pmi_aes_network' },
          { label: 'Social Media (IG, YouTube, etc.)', value: 'social_media' },
          { label: 'Other', value: 'other' },
        ],
      },
    ]}
    textarea={{
      label: 'Message',
      name: 'message',
      required: true,
    }}
    disclaimer={{
      label:
        'By submitting this contact form, you acknowledge and agree to the collection of your personal information.',
      name: 'privacy_consent',
      required: true,
      value: 'granted',
    }}
    button="Send message"
    description="Technically Creative representative will get back to you as soon as possible typically within 24-48 business hours."
    successMessage="Thanks! We've received your note and will follow up shortly."
    errorMessage="We couldn't submit your message. Please double-check the form and try again."
    hubspot={hubspotForm}
    classes={{
      form: 'min-h-[420px]',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Selection details"
    items={[
      {
        title: 'Project Type',
        description: '<ul><li>Mixing / Mastering</li><li>Trailer Sound Design</li><li>AI Workflow Consulting</li><li>Other</li></ul>',
      },
      {
        title: 'Budget Range',
        description: '<ul><li>Under $500</li><li>$500-$1000</li><li>$1,000-$2,500</li><li>$2,500-$5,000</li><li>$5000+</li></ul>',
      },
      {
        title: 'Timeline / Urgency',
        description: '<ul><li>ASAP (Within 1 Month)</li><li>1-3 Months</li><li>3-6 Months</li><li>Flexible</li></ul>',
      },
      {
        title: 'Referral Source',
        description: '<ul><li>LinkedIn</li><li>Website / Blog</li><li>Word of Mouth / Referral</li><li>PMI / AES Network</li><li>Social Media (IG, YouTube, etc.)</li><li>Other</li></ul>',
      },
    ]}
  />

  <WidgetWrapper id="platforms" containerClass="max-w-4xl mx-auto py-12 md:py-16">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary">Already using a platform?</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
        Find me directly on these platforms
      </h2>
      <p class="mt-3 text-muted dark:text-slate-400">
        Hire through the platform you already use — contracts, reviews, and payments handled natively.
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-3">

      <!-- Upwork -->
      <div class="flex flex-col overflow-hidden rounded-2xl border border-dashed border-primary/30 bg-white/70 dark:bg-slate-900/40">
        <div class="flex items-center gap-3 border-b border-primary/10 px-6 py-4">
          <Icon name="tabler:briefcase" class="h-6 w-6 text-[#14a800]" />
          <span class="text-lg font-bold text-slate-900 dark:text-white">Upwork</span>
        </div>
        <div class="flex flex-1 flex-col px-6 py-5">
          <p class="text-sm text-muted dark:text-slate-400">
            Full work history, client reviews, and project catalog. Best for contracts, hourly work, and milestone-based projects.
          </p>
          <div class="mt-4 flex-1 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
            <iframe
              src="https://www.upwork.com/freelancers/techcre8?embed=true"
              title="Upwork Profile — Technically Creative"
              class="h-64 w-full border-0"
              loading="lazy"
              sandbox="allow-scripts allow-same-origin allow-popups"
            ></iframe>
          </div>
          <a
            href="https://www.upwork.com/freelancers/techcre8"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center justify-center gap-2 rounded-lg bg-[#14a800] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#0f8700]"
          >
            View Upwork Profile
            <Icon name="tabler:external-link" class="h-4 w-4" />
          </a>
        </div>
      </div>

      <!-- Contra -->
      <div class="flex flex-col overflow-hidden rounded-2xl border border-dashed border-primary/30 bg-white/70 dark:bg-slate-900/40">
        <div class="flex items-center gap-3 border-b border-primary/10 px-6 py-4">
          <Icon name="tabler:bolt" class="h-6 w-6 text-primary" />
          <span class="text-lg font-bold text-slate-900 dark:text-white">Contra</span>
        </div>
        <div class="flex flex-1 flex-col px-6 py-5">
          <p class="text-sm text-muted dark:text-slate-400">
            Commission-free freelance platform. Great for independent project work with no platform fees taken from your payment.
          </p>
          <div class="mt-4 flex-1 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
            <iframe
              src="https://contra.com/techcre8?embed=true"
              title="Contra Profile — Technically Creative"
              class="h-64 w-full border-0"
              loading="lazy"
              sandbox="allow-scripts allow-same-origin allow-popups"
            ></iframe>
          </div>
          <a
            href="https://contra.com/techcre8"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center justify-center gap-2 rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white"
          >
            View Contra Profile
            <Icon name="tabler:external-link" class="h-4 w-4" />
          </a>
        </div>
      </div>

      <!-- Gumroad -->
      <div class="flex flex-col overflow-hidden rounded-2xl border border-dashed border-primary/30 bg-white/70 dark:bg-slate-900/40">
        <div class="flex items-center gap-3 border-b border-primary/10 px-6 py-4">
          <Icon name="tabler:shopping-bag" class="h-6 w-6 text-[#ff90e8]" />
          <span class="text-lg font-bold text-slate-900 dark:text-white">Gumroad</span>
        </div>
        <div class="flex flex-1 flex-col px-6 py-5">
          <p class="text-sm text-muted dark:text-slate-400">
            Digital products — Ableton training modules, art prints, and downloadable resources available for instant purchase.
          </p>
          <div class="mt-4 flex-1 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
            <iframe
              src="https://techcre8.gumroad.com?embed=true"
              title="Gumroad Store — Technically Creative"
              class="h-64 w-full border-0"
              loading="lazy"
              sandbox="allow-scripts allow-same-origin allow-popups"
            ></iframe>
          </div>
          <a
            href="https://techcre8.gumroad.com"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center justify-center gap-2 rounded-lg bg-[#ff90e8] px-4 py-2.5 text-sm font-semibold text-slate-900 transition hover:bg-[#ff70e0]"
          >
            Visit Gumroad Store
            <Icon name="tabler:external-link" class="h-4 w-4" />
          </a>
        </div>
      </div>

    </div>
  </WidgetWrapper>
</Layout>


