---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import BrandBanner from '~/components/widgets/BrandBanner.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { Icon } from 'astro-icon/components';
import { headerData } from '~/navigation';

const links = headerData.links;

const metadata = {
  title: 'Contact',
  description:
    'Get in touch with Technically Creative — Indianapolis-based mixing, sound design, project management, and workflow automation for artists and teams that need reliable delivery.',
};

// n8n "Quote Request Intake" workflow: creates the HubSpot contact + ClickUp lead
// task and sends the Telegram alert, then replies { success: true }.
const leadWebhookUrl = 'https://technicallycreative.app.n8n.cloud/webhook/quote-request';
const directEmail = 'contact@technicallycreative.work';

const inputClass =
  'mt-1 block w-full rounded-lg border border-gray-200 bg-white px-3 py-3 text-base dark:border-gray-700 dark:bg-slate-900';
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header links={links} isSticky showToggleTheme />
  </Fragment>
  <BrandBanner />

  <div class="container pt-10 pb-2 md:pt-14">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl md:text-4xl">Contact Technically Creative — Indianapolis Music Production &amp; PM Consulting</h1>
    <p class="mt-3 max-w-2xl text-muted dark:text-slate-400">
      Not sure what you need yet? That's normal. Tell me what you're working on — a rough idea is plenty — and we'll
      figure out the rest together.
    </p>
  </div>

  <WidgetWrapper id="form" containerClass="max-w-xl mx-auto py-4 md:py-8">
    <form
      id="contact-form"
      novalidate
      class="rounded-2xl border border-primary/30 bg-white/70 p-5 sm:p-8 dark:bg-slate-900/40"
      data-webhook={leadWebhookUrl}
    >
      <div class="mb-4">
        <label for="contact-name" class="block text-sm font-medium text-slate-900 dark:text-white">Name</label>
        <input id="contact-name" name="name" type="text" required autocomplete="name" class={inputClass} />
      </div>
      <div class="mb-4">
        <label for="contact-email" class="block text-sm font-medium text-slate-900 dark:text-white">Email</label>
        <input id="contact-email" name="email" type="email" required autocomplete="email" class={inputClass} />
      </div>
      <div class="mb-4">
        <label for="contact-phone" class="block text-sm font-medium text-slate-900 dark:text-white">
          Phone <span class="font-normal text-muted dark:text-slate-400">(optional — if you'd rather text or call)</span>
        </label>
        <input id="contact-phone" name="phone" type="tel" autocomplete="tel" class={inputClass} />
      </div>
      <div class="mb-4">
        <label for="contact-message" class="block text-sm font-medium text-slate-900 dark:text-white">
          What's on your mind?
        </label>
        <textarea
          id="contact-message"
          name="message"
          rows="4"
          required
          placeholder="A song to mix, a messy workflow, a question — anything."
          class={inputClass}></textarea>
      </div>

      <!-- Honeypot: real visitors never see or fill this. -->
      <div class="hidden" aria-hidden="true">
        <label for="contact-website">Leave this field empty</label>
        <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <p id="contact-error" class="mb-4 hidden text-sm text-rose-600" role="alert"></p>
      <p id="contact-success" class="mb-4 hidden text-sm text-emerald-600" role="status">
        Got it — thanks! I'll reply by email, usually within 24–48 business hours.
      </p>

      <button
        type="submit"
        id="contact-submit"
        class="w-full rounded-lg bg-primary px-4 py-3 text-base font-semibold text-white transition hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60"
      >
        Let's talk
      </button>
      <p class="mt-4 text-center text-xs text-muted dark:text-slate-400">
        I only use your details to reply to you. Or email me directly at
        <a href={`mailto:${directEmail}`} class="font-semibold text-primary hover:underline">{directEmail}</a>.
      </p>
    </form>
  </WidgetWrapper>

  <WidgetWrapper id="platforms" containerClass="max-w-4xl mx-auto py-12 md:py-16">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary">Already using a platform?</p>
      <h2 class="mt-2 text-xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
        Find me directly on these platforms
      </h2>
      <p class="mt-3 text-muted dark:text-slate-400">
        Hire through the platform you already use — contracts, reviews, and payments handled natively.
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-3">

      <!-- Upwork -->
      <div class="flex flex-col overflow-hidden rounded-2xl border border-dashed border-primary/30 bg-white/70 dark:bg-slate-900/40">
        <div class="flex items-center gap-3 border-b border-primary/10 px-6 py-4">
          <Icon name="tabler:briefcase" class="h-6 w-6 text-[#14a800]" />
          <span class="text-lg font-bold text-slate-900 dark:text-white">Upwork</span>
        </div>
        <div class="flex flex-1 flex-col px-6 py-5">
          <p class="text-sm text-muted dark:text-slate-400">
            Full work history, client reviews, and project catalog. Best for contracts, hourly work, and milestone-based projects.
          </p>
          <a
            href="https://www.upwork.com/freelancers/techcre8"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 md:mt-auto inline-flex items-center justify-center gap-2 rounded-lg bg-[#14a800] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#0f8700]"
          >
            View Upwork Profile
            <Icon name="tabler:external-link" class="h-4 w-4" />
          </a>
        </div>
      </div>

      <!-- Contra -->
      <div class="flex flex-col overflow-hidden rounded-2xl border border-dashed border-primary/30 bg-white/70 dark:bg-slate-900/40">
        <div class="flex items-center gap-3 border-b border-primary/10 px-6 py-4">
          <Icon name="tabler:bolt" class="h-6 w-6 text-primary" />
          <span class="text-lg font-bold text-slate-900 dark:text-white">Contra</span>
        </div>
        <div class="flex flex-1 flex-col px-6 py-5">
          <p class="text-sm text-muted dark:text-slate-400">
            Commission-free freelance platform. Great for independent project work with no platform fees taken from your payment.
          </p>
          <a
            href="https://contra.com/techcre8"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 md:mt-auto inline-flex items-center justify-center gap-2 rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white"
          >
            View Contra Profile
            <Icon name="tabler:external-link" class="h-4 w-4" />
          </a>
        </div>
      </div>

      <!-- Gumroad -->
      <div class="flex flex-col overflow-hidden rounded-2xl border border-dashed border-primary/30 bg-white/70 dark:bg-slate-900/40">
        <div class="flex items-center gap-3 border-b border-primary/10 px-6 py-4">
          <Icon name="tabler:shopping-bag" class="h-6 w-6 text-[#ff90e8]" />
          <span class="text-lg font-bold text-slate-900 dark:text-white">Gumroad</span>
        </div>
        <div class="flex flex-1 flex-col px-6 py-5">
          <p class="text-sm text-muted dark:text-slate-400">
            Digital products — Ableton training modules, art prints, and downloadable resources available for instant purchase.
          </p>
          <div class="mt-4 flex-1 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
            <iframe
              src="https://techcre8.gumroad.com?embed=true"
              title="Gumroad Store — Technically Creative"
              class="h-64 w-full border-0"
              loading="lazy"
              sandbox="allow-scripts allow-same-origin allow-popups"
            ></iframe>
          </div>
          <a
            href="https://techcre8.gumroad.com"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center justify-center gap-2 rounded-lg bg-[#ff90e8] px-4 py-2.5 text-sm font-semibold text-slate-900 transition hover:bg-[#ff70e0]"
          >
            Visit Gumroad Store
            <Icon name="tabler:external-link" class="h-4 w-4" />
          </a>
        </div>
      </div>

    </div>
  </WidgetWrapper>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('contact-error');
  const successEl = document.getElementById('contact-success');
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const FALLBACK = "Something went wrong sending that — please email contact@technicallycreative.work and I'll pick it up from there.";

  const show = (el: HTMLElement | null, text?: string) => {
    if (!el) return;
    if (text) el.textContent = text;
    el.classList.remove('hidden');
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl?.classList.add('hidden');
    successEl?.classList.add('hidden');

    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const phone = String(data.get('phone') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();

    if (!name || !message || !/^[^s@]+@[^s@]+.[^s@]+$/.test(email)) {
      show(errorEl, 'Please add your name, a valid email, and a quick note.');
      return;
    }

    // Honeypot filled in = a bot. Pretend it worked, send nothing.
    if (String(data.get('website') ?? '').trim()) {
      show(successEl);
      form.reset();
      return;
    }

    const originalLabel = submitBtn?.textContent ?? '';
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
    }

    try {
      const response = await fetch(form.dataset.webhook ?? '', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          email,
          phone,
          service_interest: 'General inquiry',
          project_description: message,
          how_heard: 'Website',
          source_page: window.location.href,
        }),
      });
      if (!response.ok) throw new Error(`Webhook responded ${response.status}`);
      show(successEl);
      form.reset();
    } catch (error) {
      console.error('Contact form submission failed', error);
      show(errorEl, FALLBACK);
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    }
  });
</script>


