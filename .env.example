# Copy this file to .env and fill in real values for local development.
# In production (Netlify), set these as site environment variables instead —
# never commit real values.

# --- Supabase ---
# Project Settings > API in the Supabase dashboard.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only — bypasses Row Level Security. Never expose this to the browser
# or prefix it with PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---
# Use test-mode keys (sk_test_... / price starting from a test Product) while
# developing locally; switch to live keys only once deployed and verified.
STRIPE_SECRET_KEY=sk_test_...
# The Price ID (not Product ID) for the paid membership subscription.
STRIPE_PRICE_ID=price_...
# From the Stripe CLI (`stripe listen`) for local dev, or from the webhook
# endpoint's settings page in the Stripe dashboard once deployed.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- MailerLite ---
# Account Settings > Integrations > API in the MailerLite dashboard.
# Used server-side by /api/newsletter/subscribe to add news-page signups to
# the "TechCre8 General" group, and by the NoteMapper email-capture gate.
# Never expose this to the browser.
MAILERLITE_API_KEY=your-mailerlite-api-key
# Subscribers > Groups — the "MidiNoteMapper WebApp" group id. Leads captured
# by the NoteMapper usage gate land here instead of the general group.
MAILERLITE_GROUP_ID_NOTEMAPPER=198596394620028888

# --- HubSpot ---
# Settings > Integrations > Private Apps in the HubSpot dashboard. Scope:
# crm.objects.contacts.write. Powers the NoteMapper email-capture gate
# (server-side, never exposed to the browser).
HUBSPOT_PRIVATE_APP_TOKEN=pat-...

# --- Site ---
# Used to build Stripe Checkout success/cancel URLs and email confirmation
# redirects. No trailing slash.
PUBLIC_SITE_URL=http://localhost:4321
